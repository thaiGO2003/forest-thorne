  }

  applyBonusToUnit(unit: CombatUnitRecord | null | undefined, bonus: Record<string, number | string | boolean | undefined>) {
    if (!unit || !bonus) return;
    const atkPct = Number(bonus.atkPct ?? 0); if (atkPct) unit.mods.atkPct = (unit.mods.atkPct ?? 0) + atkPct;
    const matkPct = Number(bonus.matkPct ?? 0); if (matkPct) unit.mods.matkPct = (unit.mods.matkPct ?? 0) + matkPct;
    const hpPct = Number(bonus.hpPct ?? 0); if (hpPct) { unit.maxHp = Math.round(unit.maxHp * (1 + hpPct)); unit.hp = unit.maxHp; }
    const healPct = Number(bonus.healPct ?? 0); if (healPct) unit.mods.healPct = (unit.mods.healPct ?? 0) + healPct;
    const critPct = Number(bonus.critPct ?? 0); if (critPct) unit.mods.critPct = (unit.mods.critPct ?? 0) + critPct;
    const evadePct = Number(bonus.evadePct ?? 0); if (evadePct) unit.mods.evadePct = (unit.mods.evadePct ?? 0) + evadePct;
    const defFlat = Number(bonus.defFlat ?? 0); if (defFlat) unit.def += defFlat;
    const mdefFlat = Number(bonus.mdefFlat ?? 0); if (mdefFlat) unit.mdef += mdefFlat;
    const shieldStart = Number(bonus.shieldStart ?? 0); if (shieldStart) unit.mods.shieldStart = (unit.mods.shieldStart ?? 0) + shieldStart;
    const startingRage = Number(bonus.startingRage ?? 0); if (startingRage) unit.mods.startingRage = (unit.mods.startingRage ?? 0) + startingRage;
    const lifestealPct = Number(bonus.lifestealPct ?? 0); if (lifestealPct) unit.mods.lifestealPct = (unit.mods.lifestealPct ?? 0) + lifestealPct;
  }

  applyOwnedEquipmentBonuses(unit: CombatUnitRecord | null | undefined, owned: OwnedEquipment | null | undefined) {
    applyOwnedEquipmentBonusesToUnit(
      unit as unknown as Parameters<typeof applyOwnedEquipmentBonusesToUnit>[0],
      owned as unknown as Parameters<typeof applyOwnedEquipmentBonusesToUnit>[1],
      (target, bonus) => SynergySystem.applyBonusToCombatUnit(target, bonus as unknown as Parameters<typeof SynergySystem.applyBonusToCombatUnit>[0]),
      { includeLegacy: true, assignEquipsToUnit: true }
    );

    const unitTyped = unit as CombatUnitRecord | null | undefined;
    if (unitTyped?.mods?.startingRage) {
      const capped = Math.min(4, unitTyped.mods.startingRage);
      unitTyped.rage = Math.min(unitTyped.rageMax || 100, (unitTyped.rage || 0) + capped);
      unitTyped.mods.startingRage = 0;
    }
  }

  buildTurnQueue() {
    const leftOrder = this.buildOrderForSide("LEFT");
    const rightOrder = this.buildOrderForSide("RIGHT");

    // Group cells into chunks: each chunk = [empty cells...] + [unit cell]
    // Last chunk may have only empties (trailing empty cells at end of side)
    const toChunks = (cells: { unit?: { alive?: boolean } | null }[]) => {
      const chunks = [];
      let current = [];
      for (const cell of cells) {
        current.push(cell);
        if (cell.unit && (cell.unit as CombatUnitRecord).alive) {
          chunks.push(current);
          current = [];
        }
      }
      if (current.length) chunks.push(current); // trailing empties
      return chunks;
    };

    const leftChunks = toChunks(leftOrder);
    const rightChunks = toChunks(rightOrder);

    // Interleave chunks: LEFT chunk, RIGHT chunk, LEFT chunk, RIGHT chunk...
    const queue = [];
    const maxLen = Math.max(leftChunks.length, rightChunks.length);
    for (let i = 0; i < maxLen; i += 1) {
      if (i < leftChunks.length) queue.push(...leftChunks[i]);
      if (i < rightChunks.length) queue.push(...rightChunks[i]);
    }

    this.turnQueue = queue;
    this.turnIndex = 0;
  }

  buildOrderForSide(side: unknown) {
    const list = [];
    if (side === "LEFT") {
      // E5→E1, D5→D1, C→B→A (frontline trước, hàng 5→1 = row 0→4)
      for (let col = PLAYER_COLS - 1; col >= 0; col -= 1) {
        for (let row = 0; row < this.getBoardRowCount(); row += 1) {
          const unit = this.getCombatUnitAt(side, row, col);
          list.push({ row, col, side, unit: unit || null });
        }
      }
    } else {
      // G5→G1, H5→H1, I→J→K (frontline trước, hàng 5→1 = row 0→4)
      for (let col = RIGHT_COL_START; col <= RIGHT_COL_END; col += 1) {
        for (let row = 0; row < this.getBoardRowCount(); row += 1) {
          const unit = this.getCombatUnitAt(side, row, col);
          list.push({ row, col, side, unit: unit || null });
        }
      }
    }
    return list;
  }

  getCombatUnits(side: unknown) {
    return this.combatUnits.filter((u) => u.alive && u.side === side);
  }

  getCombatUnitAt(side: unknown, row: unknown, col: unknown) {
    return this.combatUnits.find((u) => u.alive && u.side === side && u.row === row && u.col === col);
  }

  /**
   * Find the optimal knockback position for a target unit.
   * Scans the horizontal row in the push direction to find:
   * - The last empty cell, OR
   * - The cell immediately before an enemy TANKER
   * 
   * @param {Object} target - The unit being pushed
   * @param {number} pushDirection - Direction to push: +1 (right) or -1 (left)
   * @param {Array} enemies - Array of enemy units to check for collisions
   * @param {number} boardWidth - Width of the board (default: 10)
   * @returns {number} The target column position (returns current col if no valid push)
   */
  findKnockbackPosition(target: { col: number; row: number } | null | undefined, pushDirection: number, enemies: { alive?: boolean; row?: number; col?: number; classType?: string }[], boardWidth: number = 10) {
    // Validate inputs - check for valid numeric col and row
    if (!target || typeof target.col !== 'number' || typeof target.row !== 'number' ||
      !Number.isFinite(target.col) || !Number.isFinite(target.row)) {
      console.error('Invalid target in findKnockbackPosition:', target);
      return 0; // Return safe fallback position
    }

    const currentCol = target.col;
    const currentRow = target.row;

    // Ensure current position is within bounds
    if (currentCol < 0 || currentCol >= boardWidth) {
      console.error(`Invalid current column ${currentCol}, clamping to bounds`);
      return Math.max(0, Math.min(boardWidth - 1, currentCol));
    }

    // Determine scan range based on push direction
    let scanStart, scanEnd, scanStep;
    if (pushDirection > 0) {
      // Pushing right (player attacking)
      scanStart = currentCol + 1;
      scanEnd = boardWidth - 1;
      scanStep = 1;
    } else {
      // Pushing left (enemy attacking)
      scanStart = currentCol - 1;
      scanEnd = 0;
      scanStep = -1;
    }

    // Scan for last empty cell or cell before tanker
    let lastEmptyCol = currentCol; // Default: no movement

    for (let col = scanStart; pushDirection > 0 ? col <= scanEnd : col >= scanEnd; col += scanStep) {
      // Check if cell is occupied
      const occupant = enemies.find((u: { alive?: boolean; row?: number; col?: number }) => u.alive && u.row === currentRow && u.col === col);

      if (!occupant) {
        // Empty cell found
        lastEmptyCol = col;
      } else {
        // Cell occupied - check if it's a tanker
        if (occupant.classType === "TANKER") {
          // Stop at cell before tanker
          let targetCol;
          if (pushDirection > 0) {
            targetCol = Math.max(currentCol, col - 1);
          } else {
            targetCol = Math.min(currentCol, col + 1);
          }
          // Ensure result is within bounds
          return Math.max(0, Math.min(boardWidth - 1, targetCol));
        } else {
          // Non-tanker blocking - stop here
          break;
        }
      }
    }

    // Ensure final result is within bounds
    const finalCol = Math.max(0, Math.min(boardWidth - 1, lastEmptyCol));
    return finalCol;
  }

  /**
   * Executes one combat turn
   * 
   * ARCHITECTURE NOTE (Task 5.2.1):
   * Combat logic has been delegated to CombatSystem. This method now only handles:
   * - Combat flow orchestration (turn progression, round management)
   * - Calling CombatSystem for combat logic:
   *   - CombatSystem.checkCombatEnd() - Check if combat is finished
   *   - CombatSystem.initializeCombat() - Rebuild turn queue each round
   *   - CombatSystem.tickStatusEffects() - Process status effects
   *   - CombatSystem.executeAction() - Determine skill vs basic attack
   *   - CombatSystem.applyDamage() - Apply damage from effects
   * - Rendering and animations (highlights, floating text, sprites)
   * - UI updates (queue preview, header, combat log)
   * 
   * Combat calculations (damage, turn order, status effects) are in CombatSystem.
   * 
   * @see CombatSystem.checkCombatEnd() - Checks win/loss conditions
   * @see CombatSystem.executeAction() - Determines action type (skill/attack)
   * @see CombatSystem.tickStatusEffects() - Processes DoT and control effects
   */
  async stepCombat() {
    // Comprehensive error recovery wrapper (Requirement 26.5)
    try {
      if (this.phase !== PHASE.COMBAT) return;
      if (this.isActing) return;
      this.clearAttackPreview();

      // COMBAT LOGIC DELEGATION: Check if combat has ended
      // CombatSystem handles: win/loss condition checking
      const combatEndResult = CombatSystem.checkCombatEnd(this.combatState);
      if (combatEndResult.isFinished) {
        const earlyWinner = combatEndResult.winner === "player" ? "LEFT" : combatEndResult.winner === "enemy" ? "RIGHT" : "DRAW";
        // ── Delay: let final animation play out ──
        const lastAlive = this.combatUnits.filter(u => u.alive);
        if (lastAlive.length > 0) {
          const mvp = lastAlive[0];
          if (mvp.sprite) {
            this.showFloatingText(mvp.sprite.x, mvp.sprite.y - 55, "KẾT LIỄU!", "#ffd700");
            this.vfx?.pulseAt(mvp.sprite.x, mvp.sprite.y - 10, 0xffd700, 24, 600);
          }
        }
        await this.wait(1200);
        this.resolveCombat(earlyWinner);
        return;
      }

      // Turn queue management and round progression
      if (this.turnQueue.length === 0 || this.turnIndex >= this.turnQueue.length) {
        if (getSceneTurnCycleIndex(this) >= 20) {
          this.resolveCombat("DRAW");
          return;
        }

        // Rebuild turn queue — position-based (E5→E1, D→A | G5→G1, H→K)
        this.buildTurnQueue();

        setSceneTurnCycleIndex(this, Math.max(1, getSceneTurnCycleIndex(this) + 1));
        this.updateRoundLabel();
        if (!this.turnQueue.length) {
          this.resolveCombat("RIGHT");
          return;
        }
      }

      const entry = this.turnQueue[this.turnIndex];
      this.turnIndex += 1;
      if (!entry) {
        this.refreshQueuePreview();
        return;
      }

      // Show turn indicator (kể cả ô trống)
      this.showTurnIndicatorAt(entry.row, entry.col);

      const actor = entry.unit;
      if (!actor || !actor.alive) {
        this.isActing = true; // Prevent timer overlap
        const emptyDelay = getSpeedEmptyDelayMs(this.player?.speedLevel ?? 0);
        await new Promise(r => setTimeout(r, emptyDelay));
        this.turnIndicatorLayer?.clear();
        this.refreshQueuePreview();
        this.isActing = false;
        // Gọi lại ngay thay vì chờ timer tick 420ms
        this.stepCombat();
        return;
      }

      this.actionCount += 1;
      if (this.actionCount > 100 && this.actionCount % 5 === 0) {
        this.globalDamageMult += 0.2;
        this.addLog(`Tử chiến x${this.globalDamageMult.toFixed(1)} sát thương.`);
      }

      this.isActing = true;
      this.highlightUnit(actor, 0xffef9f);

      try {
        const skipped = processSharedStartTurn(this as unknown as Parameters<typeof processSharedStartTurn>[0], actor as unknown as Parameters<typeof processSharedStartTurn>[0], {
          state: this.combatState
        });

        if (!actor.alive || skipped) {
          // Shared status runtime already handled visuals, UI sync, and logs.
        } else {
          const target = this.selectTarget(actor);

          // SELF-pattern skills don't need enemy target (heals, buffs, self-buffs)
          const skill = getResolvedSkillDefinition(actor.skillId as unknown as Parameters<typeof getResolvedSkillDefinition>[0], { baseId: actor.baseId, star: actor.star });
          const isSelfSkill = skill && (skill.actionPattern === "SELF");

          if (target || isSelfSkill) {
            // COMBAT LOGIC DELEGATION: Determine action type using CombatSystem
            // CombatSystem handles: rage check, silence check, disarm check, action type determination
            const actionResult = CombatSystem.executeAction(this.combatState as unknown as Parameters<typeof CombatSystem.executeAction>[0], actor);

            if (actionResult.success) {
              if (actionResult.actionType === 'SKILL') {
                // Reset rage if needed (determined by CombatSystem)
                if (actionResult.resetRage) {
                  actor.rage = 0;
                }
                this.updateCombatUnitUi(actor);
                // SELF skills use attacker as fallback target
                await this.castSkill(actor, target || actor as unknown as Parameters<typeof this.castSkill>[0], { consumeRage: false, trigger: "turn" });
              } else if (actionResult.actionType === 'DISARMED') {
                this.showFloatingText((actor as CombatUnitRecord).sprite?.x, (actor as CombatUnitRecord).sprite?.y - 45, "BỊ CẤM ĐÁNH", "#ffffff");
              } else if (!target) {
                // SELF skill was cast but no enemy target for basic attack — skip
              } else {
                // Basic attack
                await this.basicAttack(actor, target as unknown as Parameters<typeof this.basicAttack>[0]);
              }
            }
          }
        }
      } catch (actionError) {
        // Log error and continue combat (Requirement 26.5)
        console.error(`[Combat Error] Error during ${actor?.name || 'unknown'} action:`, actionError);
        this.addLog(`Lỗi kỹ thuật - bỏ qua lượt ${actor?.name || 'unknown'}.`);
      }

      this.clearHighlights();
      this.refreshQueuePreview();
      this.refreshHeader();
      this.isActing = false;
      if (this.isCoopAuthoritativeCombatSyncEnabled() && this.isCoopHost()) {
        this.syncCoopCombatSnapshot("action");
      }

      // Check combat end again after action
      const endCheck = CombatSystem.checkCombatEnd(this.combatState);
      if (endCheck.isFinished) {
        // ── Delay before resolving: let the final blow animation play out ──
        const finalWinner = endCheck.winner === "player" ? "LEFT" : endCheck.winner === "enemy" ? "RIGHT" : "DRAW";
        // Show "KẾT LIỄU" floating text on the last attacker
        const lastAlive = this.combatUnits.filter(u => u.alive);
        if (lastAlive.length > 0) {
          const mvp = lastAlive[0];
          if (mvp.sprite) {
            this.showFloatingText(mvp.sprite.x, mvp.sprite.y - 55, "KẾT LIỄU!", "#ffd700");
            this.vfx?.pulseAt(mvp.sprite.x, mvp.sprite.y - 10, 0xffd700, 24, 600);
          }
        }
        await this.wait(1200);
        this.resolveCombat(finalWinner);
      }
    } catch (error) {
      // Critical error recovery - log and continue to next turn (Requirement 26.5)
      console.error('[Combat Error] Unexpected error in stepCombat:', error);
      this.isActing = false;
      this.clearHighlights();

      // Try to continue combat gracefully
      try {
        this.refreshQueuePreview();
        this.refreshHeader();
      } catch (recoveryError) {
        console.error('[Combat Error] Error during recovery:', recoveryError);
      }
    }
  }



  selectTarget(attacker: unknown, options: unknown = {}) {
    // Use AISystem for target selection (Requirements 8.1, 8.6)
    const state = {
      units: this.combatUnits || []
    };
    return aiSelectTarget(attacker as unknown as Parameters<typeof aiSelectTarget>[0], state as unknown as Parameters<typeof aiSelectTarget>[0], this.aiMode, {
      randomFn: this.random.bind(this),
      ...options
    });
  }

  distanceToFrontline(unit: CombatUnitRecord | null | undefined) { return _distanceToFrontline(unit as Parameters<typeof _distanceToFrontline>[0]); }
  distanceToBackline(unit: CombatUnitRecord | null | undefined) { return _distanceToBackline(unit as Parameters<typeof _distanceToBackline>[0]); }

  async basicAttack(attacker: CombatUnitRecord | null, target: CombatUnitRecord | null) {
    await executeSharedBasicAttack(this as unknown as Parameters<typeof executeSharedBasicAttack>[0], attacker as unknown as Parameters<typeof executeSharedBasicAttack>[0], target, {
      getVisualModule: getUnitVisualModule,
      randomBetween: this.randomInt.bind(this),
      onBeforeAction: ({ attacker: actingUnit, target: targetUnit }) => {
        this.setCombatBorder(actingUnit as unknown as Parameters<typeof this.setCombatBorder>[0], "attack");
        this.announceCombatBasicAttackVoice(actingUnit as unknown as Parameters<typeof this.announceCombatBasicAttackVoice>[0], targetUnit as unknown as Parameters<typeof this.announceCombatBasicAttackVoice>[0]);
      },
      onAfterAction: ({ attacker: actingUnit, target: targetUnit, pattern }) => {
        this.clearCombatBorder(actingUnit as unknown as Parameters<typeof this.clearCombatBorder>[0]);
        this.addLog(buildSharedCombatActionLog({
          kind: "basic",
          attacker: actingUnit,
          target: targetUnit,
          range: actingUnit?.range ?? 1,
          damageType: (actingUnit as CombatUnitRecord)?.mods?.basicAttackType === "magic" ? "magic" : "physical",
          pattern
        }), "COMBAT");
      }
    });
  }

  async castSkill(attacker: CombatUnitRecord | null, target: CombatUnitRecord | null, options: { consumeRage?: boolean; [key: string]: unknown } = {}) {
    const tracker = beginSharedSkillRolePassiveCast(attacker as unknown as Parameters<typeof beginSharedSkillRolePassiveCast>[0], {
      consumeRage: options.consumeRage !== false
    });
    this.updateCombatUnitUi(attacker);
    try {
      await executeSharedSkillCast(this as unknown as Parameters<typeof executeSharedSkillCast>[0], attacker as unknown as Parameters<typeof executeSharedSkillCast>[0], target, {
        getSkillById: (skillId, actingUnit) => getResolvedSkillDefinition(skillId, {
          baseId: actingUnit?.baseId,
          star: actingUnit?.star
        }),
        getVisualModule: getUnitVisualModule,
        onMissingSkill: async ({ attacker: actingUnit, target: targetUnit }) => {
          console.error(`[Skill Error] Unit "${actingUnit.name}" (ID: ${actingUnit.baseId || actingUnit.id}) references non-existent skill "${actingUnit.skillId}". Falling back to basic attack.`);
          await this.basicAttack(actingUnit as unknown as Parameters<typeof this.basicAttack>[0], targetUnit as unknown as Parameters<typeof this.basicAttack>[0]);
        },
        onBeforeSkillCast: ({ attacker: actingUnit, actionTarget, skill }) => {
          this.playSkillCastPresentation(actingUnit as unknown as Parameters<typeof this.playSkillCastPresentation>[0], actionTarget as unknown as Parameters<typeof this.playSkillCastPresentation>[0], skill, options);
        },
        onPatternImpact: async ({ effectivePattern, visualModule, attacker: actingUnit, actionTarget }) => {
          if (effectivePattern === "SELF") {
            this.vfx?.pulseAt((actingUnit as CombatUnitRecord).sprite?.x, (actingUnit as CombatUnitRecord).sprite?.y - 8, 0x88ffbb, 16, 220);
          } else if (!visualModule?.playSkillAttack) {
            this.vfx?.pulseAt(actionTarget.sprite.x as unknown as number, actionTarget.sprite?.y ?? 0 - 8, 0xb6dbff, 16, 220);
          }
        },
        onAfterSkillCast: ({ attacker: actingUnit, actionTarget, skill, effectivePattern, visualUnits }) => {
          this.addLog(buildSharedCombatActionLog({
            kind: "skill",
            attacker: actingUnit,
            target: actionTarget,
            skill,
            pattern: effectivePattern,
            targetCount: Array.isArray(visualUnits) ? visualUnits.length : 1
          }), "COMBAT");
        }
      });
    } finally {
      const refundResult = finalizeSharedSkillRolePassiveCast(this, attacker as unknown as Parameters<typeof finalizeSharedSkillRolePassiveCast>[0], tracker, {
        onMageRefund: ({ attacker: actingUnit, refunded }) => {
          if (refunded <= 0) return;
          this.showFloatingText((actingUnit as CombatUnitRecord).sprite?.x, (actingUnit as CombatUnitRecord).sprite?.y - 64, `+${refunded} NỘ`, "#b8f5ff");
          this.addLog(`🪄 ${actingUnit.name} hồi ${refunded} nộ từ nội tại Pháp sư.`, "COMBAT");
        },
        onAfterFinalize: ({ attacker: actingUnit }) => {
          this.updateCombatUnitUi(actingUnit);
        }
      });
      if (refundResult.refunded > 0) {
        this.vfx?.pulseAt((attacker as CombatUnitRecord).sprite?.x, (attacker as CombatUnitRecord).sprite?.y - 12, 0x8fd8ff, 14, 220);
      }
    }
  }

  playRockThrowFx(attacker: CombatUnitRecord | null | undefined, target: CombatUnitRecord | null | undefined) {
    if (!attacker?.sprite?.active || !target?.sprite?.active) return;
    const sx0 = attacker.sprite?.x ?? 0;
    const sy0 = (attacker.sprite?.y ?? 0) - 12;
    const tx = target.sprite.x;
    const ty = target.sprite.y - 10;
    const dir = tx >= sx0 ? 1 : -1;
    const sx = sx0 + dir * 18;
    const layer = this.add.container(0, 0);
    layer.setDepth(9300);
    this.combatSprites.push(layer);
    const addBlendMode = getAddBlendMode(this);
    let lastTrail = -1;
    const travelMs = this.scaleCombatDuration ? this.scaleCombatDuration(MONKEY_SKILL_TRAVEL_MS) : MONKEY_SKILL_TRAVEL_MS;
    launchArcProjectile(this, {
      layer,
      startX: sx,
      startY: sy0,
      endX: tx,
      endY: ty,
      travelMs,
      arcStyle: "heavy",
      createProjectile: () => {
        const projectile = this.add.container(0, 0);
        const glow = this.add.circle(0, 0, 28, 0xb8deff, 0.34);
        glow.setBlendMode?.(addBlendMode);
        const rock = this.add.circle(0, 0, 18, 0x707a86, 1);
        rock.setStrokeStyle?.(2, 0xecf6ff, 0.92);
        const core = this.add.circle(2.1, 2, 10, 0x56606b, 0.95);
        projectile.add([glow, rock, core]);
        return projectile;
      },
      onUpdate: ({ projectile, point, t }) => {
        projectile.angle = (projectile.angle ?? 0) + 16;
        if (t - lastTrail >= 0.07) {
          lastTrail = t;
          const trail = this.add.circle(point.x, point.y + 1, 7.2, 0xc9e8ff, 0.58).setDepth(9301);
          trail.setBlendMode?.(addBlendMode);
          this.tweens.add({
            targets: trail,
            alpha: 0,
            scale: 0.35,
            duration: this.scaleCombatDuration ? this.scaleCombatDuration(170) : 170,
            ease: "Cubic.out",
            onComplete: () => trail.destroy()
          });
        }
      },
      onImpact: ({ projectile, x, y }) => {
        projectile.destroy?.();
        const hit1 = this.add.circle(x, y, 20, 0x8dd7ff, 0.62).setDepth(9302);
        const hit2 = this.add.circle(x, y, 30, 0xdaf3ff, 0.38).setDepth(9302);
        this.tweens.add({
          targets: hit1,
          scale: 2.4,
          alpha: 0,
          duration: this.scaleCombatDuration ? this.scaleCombatDuration(200) : 200,
          ease: "Cubic.out",
          onComplete: () => hit1.destroy()
        });
        this.tweens.add({
          targets: hit2,
          scale: 1.9,
          alpha: 0,
          duration: this.scaleCombatDuration ? this.scaleCombatDuration(220) : 220,
          ease: "Cubic.out",
          onComplete: () => hit2.destroy()
        });
        layer.destroy();
      }
    });
  }

  async runActionPattern(attacker: CombatUnitRecord | null, target: CombatUnitRecord | null, pattern: unknown, impactFn: unknown) {
    return runSharedActionPattern(this as unknown as Parameters<typeof runSharedActionPattern>[0], attacker as unknown as Parameters<typeof runSharedActionPattern>[0], target, pattern, impactFn);
  }

  async applySkillEffect(attacker: CombatUnitRecord | null, target: CombatUnitRecord | null, skill: unknown) {
    return applySharedSkillEffectRuntime(this as unknown as Parameters<typeof applySharedSkillEffectRuntime>[0], attacker as unknown as Parameters<typeof applySharedSkillEffectRuntime>[0], target, skill, {
      allowCustomSkillLogic: true,
      wrapErrors: true,
      onUnhandledEffect: async ({ attacker: actingUnit, target: targetUnit, skill: skillDef, rawSkill, skillOpts }) => {
        console.error(`[Skill Error] Unknown skill effect "${skillDef.effect}" for skill "${skillDef.name}" (ID: ${skillDef.id || "unknown"}). Falling back to basic damage.`);
        this.showFloatingText((actingUnit as CombatUnitRecord).sprite?.x, (actingUnit as CombatUnitRecord).sprite?.y - 45, "FALLBACK", "#ff9933");
        this.addLog(`⚠️ Skill "${skillDef.name}" effect "${skillDef.effect}" không nhận diện — dùng đánh thường.`);
        this.resolveDamage(actingUnit as unknown as Parameters<typeof this.resolveDamage>[0], targetUnit as unknown as Parameters<typeof this.resolveDamage>[0], rawSkill, skillDef.damageType || "physical", skillDef.name as unknown as Parameters<typeof this.resolveDamage>[0], skillOpts);
      },
      onRuntimeError: async (error, { attacker: actingUnit, target: targetUnit, skill: skillDef, rawSkill }) => {
        console.error(`[Skill Error] Error applying skill effect "${skillDef?.effect || "unknown"}" for ${actingUnit?.name || "unknown"}:`, error);
        this.showFloatingText((actingUnit as CombatUnitRecord).sprite?.x, (actingUnit as CombatUnitRecord).sprite?.y - 45, "LỖI SKILL", "#ff3333");
        this.addLog(`⚠️ Lỗi skill ${skillDef?.name || "unknown"}: ${(error as { message?: string })?.message || "unknown"}`);
        try {
          this.resolveDamage(actingUnit as unknown as Parameters<typeof this.resolveDamage>[0], targetUnit as unknown as Parameters<typeof this.resolveDamage>[0], rawSkill, skillDef?.damageType || "physical", "LỖI", { isSkill: true });
        } catch (fallbackError) {
          console.error("[Skill Error] Fallback damage also failed:", fallbackError);
        }
      }
    });
  }
  getSkillCastTheme(skill: { effect?: string; [key: string]: unknown } | null | undefined, attacker: { tribe?: string } | null | undefined) {
    const effect = String(skill?.effect ?? "").toLowerCase();
    const tribe = String(attacker?.tribe ?? "").toUpperCase();
    const has = (keywords: unknown[], k: unknown) => keywords.some((k) => effect.includes(k as unknown as Parameters<typeof effect.includes>[0]));

    let key = "impact";
    if (has(["heal", "shield", "hot", "protect", "guard", "buff", "revive", "cleanse", "rage", "aura"])) {
      key = "support";
    } else if (has(["stun", "freeze", "sleep", "silence", "taunt", "fear", "disarm", "lock", "paraly"])) {
      key = "control";
    } else if (has(["poison", "bleed", "burn", "disease", "toxic", "dot"])) {
      key = "dot";
    } else if (has(["global", "aoe", "row", "column", "cone", "multi"])) {
      key = "aoe";
    } else if (has(["charge", "pierce", "burst", "smash", "quake", "strike", "headbutt"])) {
      key = "assault";
    }

    const themes = {
      impact: {
        key: "impact",
        tag: "TUNG CHIÊU",
        textColor: "#ffe9ae",
        strokeColor: "#4a2c0d",
        ringColor: 0xffc95a,
        accentColor: 0xff8d4d,
        shakeMs: 120,
        shakeIntensity: 0.0035
      },
      assault: {
        key: "assault",
        tag: "CÔNG PHÁ",
        textColor: "#ffd8b0",
        strokeColor: "#522311",
        ringColor: 0xff9a5a,
        accentColor: 0xff5d3a,
        shakeMs: 155,
        shakeIntensity: 0.0048
      },
      control: {
        key: "control",
        tag: "KHỐNG CHẾ",
        textColor: "#e6d6ff",
        strokeColor: "#2b1843",
        ringColor: 0xb38dff,
        accentColor: 0x7c5aff,
        shakeMs: 145,
        shakeIntensity: 0.0042
      },
      support: {
        key: "support",
        tag: "HỖ TRỢ",
        textColor: "#d8ffe4",
        strokeColor: "#1b4530",
        ringColor: 0x62d692,
        accentColor: 0x8effb6,
        shakeMs: 95,
        shakeIntensity: 0.0024
      },
      dot: {
        key: "dot",
        tag: "HIỆU ỨNG",
        textColor: "#e7ffa7",
        strokeColor: "#375017",
        ringColor: 0x95d84a,
        accentColor: 0x4f9b2f,
        shakeMs: 125,
        shakeIntensity: 0.0032
      },
      aoe: {
        key: "aoe",
        tag: "DIỆN RỘNG",
        textColor: "#d7f2ff",
        strokeColor: "#123d5f",
        ringColor: 0x67c8ff,
        accentColor: 0x3e8fff,
        shakeMs: 165,
        shakeIntensity: 0.0045
      }
    };

    const tribeTone = {
      FIRE: { ringColor: 0xff8b4f, accentColor: 0xff4f35 },
      WATER: { ringColor: 0x67d9ff, accentColor: 0x3db5f5 },
      WIND: { ringColor: 0xa3efff, accentColor: 0x7dcfff },
      STONE: { ringColor: 0xd1b48a, accentColor: 0xb08b62 },
      THUNDER: { ringColor: 0xc798ff, accentColor: 0x9963ff },
      WOOD: { ringColor: 0x8bdc82, accentColor: 0x55b85c }
    }[tribe];

    const base = { ...(themes[key] || themes.impact) };
    if (tribeTone) {
      base.ringColor = tribeTone.ringColor;
      base.accentColor = tribeTone.accentColor;
    }
    return base;
  }

  getCombatVoiceNow() {
    return Number.isFinite(this.time?.now) ? this.time.now : Date.now();
  }

  resolveCombatVoiceConfig(kind: unknown = "skill") {
    return COMBAT_VOICE_CONFIG[kind] ?? COMBAT_VOICE_CONFIG.skill;
  }

  resolveCombatVoiceSideLabel(unit: { side?: string } | null | undefined) {
    if (unit?.side === "LEFT") return "phe ta";
    if (unit?.side === "RIGHT") return "phe địch";
    return "";
  }

  resolveCombatVoiceUnitName(unit: { name?: string; base?: { name?: string }; baseId?: string } | null | undefined) {
    return String(unit?.name ?? unit?.base?.name ?? unit?.baseId ?? "Linh thú").trim();
  }

  resolveCombatVoiceUnitLabel(unit: { name?: string; side?: string; [key: string]: unknown } | null | undefined) {
    const unitName = this.resolveCombatVoiceUnitName(unit);
    const sideLabel = this.resolveCombatVoiceSideLabel(unit);
    return [unitName, sideLabel].filter(Boolean).join(" ").trim();
  }

  resolveCombatSkillVoiceLabel(skill: { nameVi?: string; name?: string; [key: string]: unknown } | null | undefined) {
    return sanitizeVietnamesePlayerText(String(skill?.nameVi ?? skill?.name ?? "").trim());
  }

  resolveCombatEffectVoiceLabel(skill: { effectLabelVi?: string; effectLabel?: string; nameVi?: string; name?: string; [key: string]: unknown } | null | undefined) {
    return sanitizeVietnamesePlayerText(String(
      skill?.effectLabelVi
      ?? skill?.effectLabel
      ?? skill?.nameVi
      ?? skill?.name
      ?? ""
    ).trim());
  }

  buildCombatSkillVoicePayload(skill: Record<string, unknown> | null | undefined, attacker: CombatUnitRecord | null | undefined = null, target: CombatUnitRecord | null | undefined = null, trigger: string | null | undefined = "") {
    const casterKey = String(attacker?.uid ?? attacker?.id ?? attacker?.baseId ?? attacker?.name ?? "").trim();
    const targetKey = String(target?.uid ?? target?.id ?? target?.baseId ?? target?.name ?? "").trim();
    const normalizedTrigger = String(trigger ?? "").trim();
    if (normalizedTrigger === "support_auto") {
      const casterLabel = this.resolveCombatVoiceUnitLabel(attacker);
      const targetLabel = this.resolveCombatVoiceUnitLabel(target);
      const effectLabel = this.resolveCombatEffectVoiceLabel(skill);
      const text = sanitizeVietnamesePlayerText(`${casterLabel} hỗ trợ ${effectLabel} cho ${targetLabel}`).trim();
      if (!text) return null;
      return {
        kind: "support_auto",
        text,
        key: `support_auto::${casterKey}::${targetKey}::${effectLabel}`
      };
    }
    if (normalizedTrigger === "tank_auto") {
      const casterLabel = this.resolveCombatVoiceUnitLabel(attacker);
      const targetLabel = this.resolveCombatVoiceUnitLabel(target);
      const effectLabel = this.resolveCombatEffectVoiceLabel(skill);
      const text = sanitizeVietnamesePlayerText(`${casterLabel} tự kích hoạt ${effectLabel} lên ${targetLabel}`).trim();
      if (!text) return null;
      return {
        kind: "tank_auto",
        text,
        key: `tank_auto::${casterKey}::${targetKey}::${effectLabel}`
      };
    }

    const voiceLabel = this.resolveCombatSkillVoiceLabel(skill);
    if (!voiceLabel) return null;
    return {
      kind: "skill",
      text: voiceLabel,
      key: `${casterKey}::${voiceLabel}`
    };
  }

  buildCombatBasicAttackVoicePayload(attacker: CombatUnitRecord | null | undefined = null, target: CombatUnitRecord | null | undefined = null) {
    const attackerLabel = this.resolveCombatVoiceUnitLabel(attacker);
    const attackerKey = String(attacker?.uid ?? attacker?.id ?? attacker?.baseId ?? attacker?.name ?? "").trim();
    const text = sanitizeVietnamesePlayerText(`${attackerLabel} đánh thường`).trim();
    if (!text) return null;
    return {
      kind: "basic",
      text,
      key: `basic::${attackerKey}`
    };
  }

  buildCombatDeathVoicePayload(unit: CombatUnitRecord | null | undefined = null) {
    const unitLabel = this.resolveCombatVoiceUnitLabel(unit);
    const unitKey = String(unit?.uid ?? unit?.id ?? unit?.baseId ?? unit?.name ?? "").trim();
    const text = sanitizeVietnamesePlayerText(`${unitLabel} bị tiêu diệt`).trim();
    if (!text) return null;
    return {
      kind: "death",
      text,
      key: `death::${unitKey}`
    };
  }

  announceCombatVoicePayload(payload: CombatVoicePayload | null | undefined) {
    if (!payload?.text) return false;
    const key = payload.key;

    const config = this.resolveCombatVoiceConfig(payload.kind);
    const now = this.getCombatVoiceNow();
    const lastVoiceAt = Number(this._lastCombatEventVoiceAt);
    const elapsed = Number.isFinite(lastVoiceAt) ? now - lastVoiceAt : Number.POSITIVE_INFINITY;
    const lastPriority = Number(this._lastCombatEventVoicePriority) || 0;
    const sameVoiceKey = this._lastCombatEventVoiceKey === key;
    const minGapMs = sameVoiceKey ? (config.sameKeyGapMs ?? config.minGapMs) : config.minGapMs;
    const isHigherPriority = config.priority > lastPriority;

    if (Number.isFinite(lastVoiceAt)) {
      if (sameVoiceKey && elapsed < minGapMs) return false;
      if (isHigherPriority) {
        if (elapsed < (config.interruptFloorMs ?? 150)) return false;
      } else if (elapsed < minGapMs) {
        return false;
      }
    }

    const spoken = speakWithBrowserVoice(payload.text, {
      ...COMBAT_VOICE_OPTIONS,
      lang: resolveBrowserSpeechLang(getLocale()),
      cancelCurrent: config.cancelCurrent
    });
    if (!spoken) return false;

    this._lastCombatEventVoiceAt = now;
    this._lastCombatEventVoiceKey = key;
    this._lastCombatEventVoicePriority = config.priority;
    if (payload.kind === "skill") {
      this._lastCombatSkillVoiceAt = now;
      this._lastCombatSkillVoiceKey = key;
    }
    return true;
  }

  announceCombatSkillCastVoice(skill: Record<string, unknown> | null | undefined, attacker: CombatUnitRecord | null | undefined = null, target: CombatUnitRecord | null | undefined = null, castOptions: { trigger?: string; [key: string]: unknown } | null = null) {
    return this.announceCombatVoicePayload(
      this.buildCombatSkillVoicePayload(skill, attacker, target, castOptions?.trigger)
    );
  }

  announceCombatBasicAttackVoice(attacker: CombatUnitRecord | null | undefined, target: CombatUnitRecord | null | undefined) {
    return this.announceCombatVoicePayload(this.buildCombatBasicAttackVoicePayload(attacker, target));
  }

  announceCombatDeathVoice(unit: CombatUnitRecord | null | undefined) {
    return this.announceCombatVoicePayload(this.buildCombatDeathVoicePayload(unit));
  }

  playSkillCastPresentation(attacker: CombatUnitRecord | null | undefined, target: CombatUnitRecord | null | undefined, skill: Record<string, unknown> | null | undefined, castOptions: { trigger?: string; [key: string]: unknown } = {}) {
    if (!attacker?.sprite?.active) return;
    this.announceCombatSkillCastVoice(skill, attacker, target, castOptions);
    playSharedSkillCastPresentation(this as unknown as Parameters<typeof playSharedSkillCastPresentation>[0], attacker, target, skill as unknown as Parameters<typeof playSharedSkillCastPresentation>[0]);
  }

  calcSkillRaw(attacker: CombatUnitRecord | null | undefined, skill: Record<string, unknown> | null | undefined) {
    const statName = skill.scaleStat || "atk";
    const sourceStat =
      statName === "atk" ? this.getEffectiveAtk(attacker) : statName === "matk" ? this.getEffectiveMatk(attacker) : attacker[statName] ?? 0;
    const starSkillMult = Number(attacker?.star ?? 0) >= 3 ? 1.4 : Number(attacker?.star ?? 0) === 2 ? 1.2 : 1;
    const baseDamage = ((skill.base || 0) + sourceStat * (skill.scale || 0)) * starSkillMult;
    if (!Number.isFinite(baseDamage) || ((skill.base == null) !== (skill.scale == null))) {
      console.warn(`[calcSkillRaw] Missing base/scale for skill ${skill.id || skill.name || "?"}: base=${skill.base}, scale=${skill.scale}, result=${baseDamage}`);
    }

    // Apply gold scaling to skill damage (Requirement 2.1, 2.2, 2.3, 2.4)
    const goldMultiplier = getGoldReserveScaling(this.player.gold);
    const scaledDamage = Math.round(baseDamage * goldMultiplier);

    return scaledDamage;
  }
  getEffectiveAtk(unit: CombatUnitRecord | null | undefined) { return _getEffectiveAtk(unit as Parameters<typeof _getEffectiveAtk>[0]); }
  getEffectiveDef(unit: CombatUnitRecord | null | undefined) { return _getEffectiveDef(unit as Parameters<typeof _getEffectiveDef>[0]); }
  getEffectiveMatk(unit: CombatUnitRecord | null | undefined) { return _getEffectiveMatk(unit as Parameters<typeof _getEffectiveMatk>[0]); }
  getEffectiveMdef(unit: CombatUnitRecord | null | undefined) { return _getEffectiveMdef(unit as Parameters<typeof _getEffectiveMdef>[0]); }

  getSpeciesDropCandidates(unit: CombatUnitRecord | null | undefined, detailed: boolean = false): Array<{ itemId: string; sourceType: string; sourceHint: string | null } | string> {
    const base = UNIT_BY_ID[unit?.baseId ?? ""];
    const species = String(base?.species ?? unit?.species ?? "").toLowerCase();
    const tribe = base?.tribe ?? unit?.tribe;
    const classType = base?.classType ?? unit?.classType;
    const out = [];
    const seen = new Set();
    const add = (itemId: unknown, sourceType = "species", sourceHint = null) => {
      if (!itemId || seen.has(itemId)) return;
      if (ITEM_BY_ID[itemId]?.kind !== "base") return;
      seen.add(itemId);
      if (detailed) {
        out.push({ itemId, sourceType, sourceHint });
      } else {
        out.push(itemId);
      }
    };
    const hasSpecies = (...keys) => keys.some((key) => species.includes(String(key).toLowerCase()));

    if (hasSpecies("dai-bang", "qua", "cu", "vet", "cong", "thien-nga", "phuong", "ong", "chim", "buom", "chuon-chuon")) {
      add("feather", "species", "avian" as unknown as Parameters<typeof add>[0]);
    }
    if (hasSpecies("rua", "te-te", "te-giac", "ca-sau", "ran", "khung-long", "tac-ke", "bo-cap", "coc", "oc")) {
      add("bark", "species", "reptile" as unknown as Parameters<typeof add>[0]);
    }
    if (hasSpecies("gau", "trau", "voi", "ho", "soi", "nai", "lon", "su-tu", "ha-ma", "vuon", "cuu", "de", "ngua", "huou", "tho", "cho", "chon", "bao", "linh-mieu", "ho-ly")) {
      add("belt", "species", "mammal" as unknown as Parameters<typeof add>[0]);
    }
    if (hasSpecies("ong", "kien", "bo", "bo-cap", "bo-ngua", "nhen", "muoi", "sau", "chuon-chuon", "buom", "gian", "moi", "ret", "bo-hung")) {
      add("claw", "species", "insect" as unknown as Parameters<typeof add>[0]);
    }

    const hasWaterSpecies = hasSpecies("ca", "ca-heo", "bach-tuoc", "sao-bien", "hai-cau", "muc", "oc");
    if (hasWaterSpecies) {
      add("tear", "species", "water" as unknown as Parameters<typeof add>[0]);
    } else if (tribe === "TIDE") {
      add("tear", "tribe", "TIDE" as unknown as Parameters<typeof add>[0]);
    }

    const hasMysticSpecies = hasSpecies("phuong", "ky-lan", "long", "buom", "chuon-chuon");
    if (hasMysticSpecies) {
      add("crystal", "species", "mystic" as unknown as Parameters<typeof add>[0]);
    } else if (tribe === "SPIRIT" || tribe === "NIGHT") {
      add("crystal", "tribe", tribe);
    } else if (classType === "MAGE") {
      add("crystal", "class", classType);
    }

    if (!out.length) {
      const fallbackByTribe = {
        STONE: "bark",
        WIND: "feather",
        FIRE: "claw",
        TIDE: "tear",
        NIGHT: "claw",
        SPIRIT: "crystal",
        SWARM: "claw"
      };
      add(fallbackByTribe[tribe] ?? "claw", "fallback", tribe ?? "DEFAULT");
    }

    return out;
  }

  rollBaseLootDropsForUnit(unit: unknown) {
    const candidates = this.getSpeciesDropCandidates(unit as unknown as Parameters<typeof this.getSpeciesDropCandidates>[0], true);
    if (!candidates.length) return [];
    const sourceContext = buildLootDropSourceContext(unit as unknown as Parameters<typeof buildLootDropSourceContext>[0]);
    const tier = sourceContext.sourceTier;
    const picked = [candidates[0]];
    const chanceByTier = {
      1: { second: 0.18, third: 0.04 },
      2: { second: 0.28, third: 0.08 },
      3: { second: 0.4, third: 0.14 },
      4: { second: 0.52, third: 0.2 },
      5: { second: 0.66, third: 0.28 }
    };
    const tierChance = chanceByTier[tier] ?? chanceByTier[1];
    if (candidates.length > 1 && this.random() < tierChance.second) {
      picked.push(candidates[1]);
    }
    if (candidates.length > 2 && this.random() < tierChance.third) {
      picked.push(candidates[2]);
    }
    return picked.map((candidate) => ({
      ...sourceContext,
      itemId: (candidate as unknown as { itemId: string }).itemId,
      dropKind: "base",
      dropTier: null,
      sourceType: (candidate as unknown as { sourceType?: string }).sourceType ?? "species",
      sourceHint: (candidate as unknown as { sourceHint?: string | null }).sourceHint ?? null,
    }));
  }

  rollEquipmentLootDropForUnit(unit: unknown) {
    const sourceContext = buildLootDropSourceContext(unit as unknown as Parameters<typeof buildLootDropSourceContext>[0]);
    const equipmentTier = clamp(sourceContext.sourceStar as unknown as Parameters<typeof clamp>[0], 1, 3);
    const pool = getEquipmentItemIdsByTier(equipmentTier);
    if (!pool.length) return [];
    if (this.random() >= 0.05) return [];
    const itemId = pickRandomLootItem(pool as unknown as Parameters<typeof pickRandomLootItem>[0], () => this.random());
    if (!itemId) return [];
    return [{
      ...sourceContext,
      itemId,
      dropKind: "equipment",
      dropTier: equipmentTier,
      sourceType: "star",
      sourceHint: null
    }];
  }

  rollLootDropsForUnit(unit: unknown) {
    const baseDrops = this.rollBaseLootDropsForUnit(unit);
    const equipmentDrops = this.rollEquipmentLootDropForUnit(unit);
    return [...baseDrops, ...equipmentDrops];
  }

  recordEnemyLootDrop(unit: CombatUnitRecord | null | undefined, killer: CombatUnitRecord | null = null) {
    const drops = this.rollLootDropsForUnit(unit);
    if (!drops.length) return;
    if (!Array.isArray(this.combatLootDrops)) this.combatLootDrops = [];
    if (!Array.isArray(this.combatLootDropDetails)) this.combatLootDropDetails = [];
    const detailedDrops = drops.map((drop) => ({
      ...drop,
      killerName: killer?.name ?? null,
      round: this.player?.round ?? null
    }));
    this.combatLootDrops.push(...detailedDrops.map((d: unknown) => (d as { itemId: string }).itemId));
    this.combatLootDropDetails.push(...detailedDrops as unknown as Parameters<typeof this.combatLootDropDetails.push>[0]);
    const label = drops
      .map((drop) => {
        const dropEntry = drop as unknown as { itemId: string };
        const item = ITEM_BY_ID[dropEntry.itemId];
        return `${item?.icon ?? "❔"} ${item?.name ?? dropEntry.itemId}`;
      })
      .join(", ");
    const sourceLines = detailedDrops.map((drop) => {
      const dropEntry2 = drop as unknown as { itemId: string };
      const item = ITEM_BY_ID[dropEntry2.itemId];
      const killerLabel = killer?.name ? ` | hạ bởi ${killer.name}` : "";
      return `${item?.name ?? drop.itemId}: ${getLootSourceLabel(drop as unknown as Parameters<typeof getLootSourceLabel>[0], unit?.name ?? "Quái địch")}${killerLabel}`;
    });
    this.addLog(buildSharedLootLog({
      title: `${unit?.name ?? "Linh thú"} rơi đồ`,
      lootLabel: label,
      sourceLines
    }), "COMBAT");
  }

  resolveDamage(attacker: CombatUnitRecord | null | undefined, defender: CombatUnitRecord | null | undefined, rawDamage: number, damageType: string, reason: string, options: { isSplash?: boolean; isProtected?: boolean; forceHit?: boolean; isSkill?: boolean; noStunBonus?: boolean; noLog?: boolean; noAutoCast?: boolean; armorPen?: number; attackKind?: string; consumeRage?: boolean; [key: string]: unknown } = {}) {
    // Validate inputs and provide fallback values (Requirement 26.3)
    if (!defender || !defender.alive) return 0;
    if (attacker && !attacker.alive) return 0;

    // Validate and clamp rawDamage (Requirement 26.3)
    if (typeof rawDamage !== 'number' || !Number.isFinite(rawDamage) || rawDamage < 0) {
      console.error(`[Combat Error] Invalid rawDamage value: ${rawDamage}, using fallback 0`);
      rawDamage = 0;
    }

    // Validate damageType (Requirement 26.3)
    if (!['physical', 'magic', 'true'].includes(damageType)) {
      console.error(`[Combat Error] Invalid damageType: ${damageType}, using fallback 'physical'`);
      damageType = 'physical';
    }

    // Turtle Protection Logic for Splash Damage
    if (options.isSplash && !options.isProtected) {
      const allies = this.getCombatUnits(defender.side);
      const protector = allies.find((a) =>
        a.alive &&
        (a.statuses?.isProtecting ?? 0) > 0 &&
        a.uid !== defender.uid &&
        Math.abs(a.row - defender.row) <= 1 &&
        Math.abs(a.col - defender.col) <= 1
      );
      if (protector) {
        this.showFloatingText((defender as CombatUnitRecord).sprite?.x, (defender as CombatUnitRecord).sprite?.y - 55, "THẾ THÂN", "#ffffff");
        // Tanker intercepts with 25% damage reduction (takes 75%)
        return this.resolveDamage(attacker, protector, rawDamage * 0.75, damageType, "BẢO VỆ", {
          ...options,
          isSplash: false,
          isProtected: true,
          forceHit: true
        });
      }
    }

    const attackKind = options.attackKind || (options.isSkill ? "skill" : attacker ? "basic" : "effect");
    const normalizedDamageType = damageType === "magic" || damageType === "true" ? damageType : "physical";
    const {
      adjustedAttacker,
      adjustedCritPolicy
    } = getSharedPassiveAdjustedCritState(attacker as unknown as Parameters<typeof getSharedPassiveAdjustedCritState>[0], defender as unknown as Parameters<typeof getSharedPassiveAdjustedCritState>[1], this.critPolicy);

    // Magic/true damage luôn trúng — chỉ physical mới check né tránh
    if (attacker && !options.forceHit && !options.isSkill && normalizedDamageType === "physical") {
      const hitChance = getSharedArcherHitChance(attacker as unknown as Parameters<typeof getSharedArcherHitChance>[0], defender as unknown as Parameters<typeof getSharedArcherHitChance>[0], calculateHitChance(attacker, defender as unknown as Parameters<typeof calculateHitChance>[0])).hitChance;
      if (this.random() >= hitChance) {
        this.audioFx.play("click");
        this.showFloatingText((defender as CombatUnitRecord).sprite?.x, (defender as CombatUnitRecord).sprite?.y - 45, "TRƯỢT", "#d3f2ff");
        if ((defender.statuses?.evadeBuffTurns ?? 0) > 0) {
          const dodgeHeal = Math.max(0, Math.round(Number(defender.statuses.evadeBuffDodgeHeal ?? 0) || 0));
          const dodgeShield = Math.max(0, Math.round(Number(defender.statuses.evadeBuffDodgeShield ?? 0) || 0));
          const dodgeRage = Math.max(0, Math.round(Number(defender.statuses.evadeBuffDodgeRage ?? 0) || 0));
          if (dodgeHeal > 0) {
            this.healUnit(defender, defender, dodgeHeal, "NÉ ĐÒN");
          }
          if (dodgeShield > 0) {
            this.addShield(defender, dodgeShield);
          }
          if (dodgeRage > 0) {
            defender.rage = Math.min(defender.rageMax || 5, (defender.rage || 0) + dodgeRage);
            this.updateCombatUnitUi(defender);
            this.showFloatingText((defender as CombatUnitRecord).sprite?.x, (defender as CombatUnitRecord).sprite?.y - 62, `+${dodgeRage} NỘ`, "#b8f5ff");
          }
        }
        // Defender gains rage even on miss, but attacker does not
        if (!options.noRage) {
          // Clamp rage to rageMax (Requirement 26.1)
          defender.rage = Math.min(defender.rageMax || 5, (defender.rage || 0) + 1);
          this.updateCombatUnitUi(defender);
        }
        if (!options.noAutoCast) {
          this.scheduleTankAutoCast(defender, attacker);
        }
        this.captureCoopCombatDamageDelta({
          attacker,
          defender,
          reason,
          damageType,
          outcome: "miss",
          amount: 0,
          absorbed: 0,
          isCrit: false
        });
        if (!options.noLog) {
          this.addLog(buildSharedDamageLog({
            attacker,
            defender,
            damageType,
            reason,
            wasMiss: true,
            hitChance
          }), "COMBAT");
        }
        return 0;
      }
    }

    const damageResult = resolveDamageAmount({
      attacker: adjustedAttacker,
      defender,
      rawDamage,
      damageType: normalizedDamageType,
      attackKind,
      critPolicy: adjustedCritPolicy,
      armorPen: options.armorPen || 0,
      globalDamageMult: this.globalDamageMult,
      getEffectiveDefFn: (unit) => this.getEffectiveDef(unit as unknown as Parameters<typeof this.getEffectiveDef>[0]),
      getEffectiveMdefFn: (unit) => this.getEffectiveMdef(unit as unknown as Parameters<typeof this.getEffectiveMdef>[0]),
      randomFn: this.random.bind(this)
    });
    damageType = damageResult.damageType;

    if (damageResult.elementalOutcome === "resisted_by_tanker") {
      this.showFloatingText((defender as CombatUnitRecord).sprite?.x, (defender as CombatUnitRecord).sprite?.y - 55, "HỘ THỂ", "#44ddff");
    } else if (damageResult.elementalOutcome === "advantage") {
      this.showFloatingText((defender as CombatUnitRecord).sprite?.x, (defender as CombatUnitRecord).sprite?.y - 55, "KHẮC CHẾ", "#ffdd44");
    }

    const isCrit = damageResult.isCrit;
    if (isCrit) {
      const critLabel = damageType === "magic" ? "BẠO KÍCH PHÉP" : "BẠO KÍCH";
      this.showFloatingText((attacker as CombatUnitRecord).sprite?.x, (attacker as CombatUnitRecord).sprite?.y - 45, critLabel, "#ffd785");
    }

    // Tướng tier cao (vàng nhiều): thêm chance choáng
    if (attacker && !options.noStunBonus && defender.alive) {
      const tierStunChance = attacker.tier >= 5 ? 0.30 : attacker.tier >= 4 ? 0.20 : 0;
      if (tierStunChance > 0 && this.random() < tierStunChance) {
        defender.statuses.stun = Math.max(defender.statuses.stun, 1);
        this.showFloatingText((defender as CombatUnitRecord).sprite?.x, (defender as CombatUnitRecord).sprite?.y - 65, "CHOÁNG", "#ffd97b");
        this.updateCombatUnitUi(defender);
      }
    }

    let final = damageResult.finalDamage;
    if (!options.fromGuardianRedirect && defender.statuses.guardianTurns > 0 && defender.statuses.guardianId) {
      const guardian = this.getCombatUnits(defender.side).find((unit) => unit.alive && unit.uid === defender.statuses.guardianId);
      if (guardian) {
        const redirectPct = Math.min(0.95, Math.max(0, defender.statuses.guardianAbsorb || 0));
        const redirectedDamage = Math.max(0, Math.round(final * redirectPct));
        if (redirectedDamage > 0) {
          this.showFloatingText((defender as CombatUnitRecord).sprite?.x, (defender as CombatUnitRecord).sprite?.y - 55, "BẢO KÊ", "#9dffba");
          this.resolveDamage(attacker, guardian, redirectedDamage, damageType, "GÁNH ĐÒN", {
            ...options,
            fromGuardianRedirect: true,
            forceHit: true
          });
          if (
            attacker
            && attacker.alive
            && (Number(defender.statuses.guardianCounterOffenseDebuffValue ?? 0) || 0) > 0
            && (Number(defender.statuses.guardianCounterOffenseDebuffTurns ?? 0) || 0) > 0
          ) {
            applyOffenseDebuffStatus(attacker, {
              turns: defender.statuses.guardianCounterOffenseDebuffTurns,
              value: defender.statuses.guardianCounterOffenseDebuffValue,
              mode: defender.statuses.guardianCounterOffenseDebuffMode || "autoByRole"
            });
            this.updateCombatUnitUi?.(attacker);
          }
          const guardianRedirectCharges = Number(defender.statuses.guardianRedirectCharges ?? 0) || 0;
          if (guardianRedirectCharges > 0) {
            defender.statuses.guardianRedirectCharges = Math.max(0, guardianRedirectCharges - 1);
            if (defender.statuses.guardianRedirectCharges <= 0) {
              defender.statuses.guardianTurns = 0;
              defender.statuses.guardianId = null;
              defender.statuses.guardianAbsorb = 0;
              defender.statuses.guardianCounterOffenseDebuffTurns = 0;
              defender.statuses.guardianCounterOffenseDebuffValue = 0;
              defender.statuses.guardianCounterOffenseDebuffMode = "";
            }
            this.updateCombatUnitUi?.(defender);
          }
          final = Math.max(0, final - redirectedDamage);
        }
      }
    }

    if (defender.statuses.damageReductionTurns > 0 && defender.statuses.damageReductionPct > 0) {
      final = Math.max(1, Math.round(final * (1 - Math.min(0.95, defender.statuses.damageReductionPct))));
    }
    if (damageType === "magic" && defender.statuses.magicDamageReductionTurns > 0 && defender.statuses.magicDamageReductionPct > 0) {
      final = Math.max(1, Math.round(final * (1 - Math.min(0.95, defender.statuses.magicDamageReductionPct))));
    }
    if (defender.statuses.fortifyReduceTurns > 0 && defender.statuses.fortifyReducePct > 0) {
      final = Math.max(1, Math.round(final * (1 - Math.min(0.95, defender.statuses.fortifyReducePct))));
    }

    let damageLeft = final;
    let absorbed = 0;
    if (defender.shield > 0) {
      absorbed = Math.min(defender.shield, damageLeft);
      defender.shield -= absorbed;
      damageLeft -= absorbed;
      this.vfx?.pulseAt((defender as CombatUnitRecord).sprite?.x, (defender as CombatUnitRecord).sprite?.y - 10, 0x8ce9ff, 14, 180);
      this.showFloatingText((defender as CombatUnitRecord).sprite?.x, (defender as CombatUnitRecord).sprite?.y - 45, `HẤP THỤ ${absorbed}`, "#86e8ff");
    }

    if (damageLeft > 0) {
      defender.hp = Math.max(0, defender.hp - damageLeft);
      this.audioFx.play("hit");
      this.vfx?.pulseAt((defender as CombatUnitRecord).sprite?.x, (defender as CombatUnitRecord).sprite?.y - 10, 0xff8f8f, 14, 180);
      if (!this.shouldSuppressLocalCoopDamageNumbers(options)) {
        this.showDamageNumber((defender as CombatUnitRecord).sprite?.x ?? 0, ((defender as CombatUnitRecord).sprite?.y ?? 0) - 45, damageLeft, {
          damageType,
          isCrit
        });
      }
    }

    if (damageLeft > 0) {
      const fromX = attacker ? (attacker.sprite ? (attacker as CombatUnitRecord).sprite?.x : attacker.x) : null;
      playSharedUnitHitAccent(this as unknown as Parameters<typeof playSharedUnitHitAccent>[0], defender as unknown as Parameters<typeof playSharedUnitHitAccent>[0], { fromX, damageLeft, absorbed, isCrit });
      playSharedUnitHitJolt(this as unknown as Parameters<typeof playSharedUnitHitJolt>[0], defender as unknown as Parameters<typeof playSharedUnitHitJolt>[0], { fromX, damageLeft });
    }

    recordSharedSkillRolePassiveHit(attacker as unknown as Parameters<typeof recordSharedSkillRolePassiveHit>[0], defender as unknown as Parameters<typeof recordSharedSkillRolePassiveHit>[0], {
      isSkill: options.isSkill === true,
      damageLeft,
      absorbed
    });

    damageLeft = applySharedDamageAftermath(this as unknown as Parameters<typeof applySharedDamageAftermath>[0], {
      attacker,
      defender,
      damageLeft,
      damageType,
      reason,
      attackKind,
      options
    }, {
      canAttackerGainRage: ({ options: damageOptions, damageLeft: appliedDamage }) =>
        appliedDamage > 0 && !damageOptions.isSkill,
      getAttackerRageGain: (actingUnit) => {
        const baseGain = actingUnit.side === "RIGHT" ? getAISettings(this.aiMode).rageGain : 1;
        const rageGainPct =
          (Number(actingUnit?.mods?.rageGainPct) || 0)
          + (Number(actingUnit?.environmentMods?.rageGainPct) || 0);
        return Math.max(0, Math.round(baseGain * (1 + rageGainPct)));
      },
      scheduleTankAutoCast: (tank: AftermathUnitLike | null | undefined, preferredTarget: AftermathUnitLike | null | undefined) => this.scheduleTankAutoCast(tank, preferredTarget),
      scheduleSupportAutoCast: (support: AftermathUnitLike | null | undefined, preferredTarget: AftermathUnitLike | null | undefined) => this.scheduleSupportAutoCast(support, preferredTarget),
      getVisualModule: (baseId) => getUnitVisualModule(baseId as unknown as Parameters<typeof getUnitVisualModule>[0]),
      applyDeathPalette: (unit: AftermathUnitLike | null | undefined) => {
        (unit?.sprite as unknown as { setFillStyle?: (color: number, alpha: number) => void })?.setFillStyle?.(0x3a3a3a, 0);
        unit?.tag?.setColor?.("#9a9a9a");
        unit?.tagBg?.setFillStyle?.(0x101620, 0.78);
        unit?.hpBarFill?.setFillStyle?.(0x676f77, 0.9);
        unit?.rageBarFill?.setFillStyle?.(0x676f77, 0.85);
        unit?.shieldBar?.setFillStyle?.(0x676f77, 0.8);
        unit?.statusLabel?.setColor?.("#9a9a9a");
        this.audioFx.play("ko", 0.12);
      },
      onDefaultDeathEffect: (unit: AftermathUnitLike | null | undefined) => {
        this.vfx?.pulseAt(unit?.sprite?.x ?? 0, unit?.sprite?.y ?? 0);
        if (unit) { void unit; }
      },
      onDeathResolved: ({ attacker: killer, defender: fallen }: { attacker: AftermathUnitLike | null | undefined; defender: AftermathUnitLike | null | undefined }) => {
        this.announceCombatDeathVoice(fallen as CombatUnitRecord | null | undefined);
        this.showFloatingText((fallen as CombatUnitRecord).sprite?.x, (fallen as CombatUnitRecord).sprite?.y - 45, "HẠ GỤC", "#ffffff");
        this.addLog(`💀 ${fallen.name} bị hạ gục${killer ? ` bởi ${killer.name}` : ""}!`);
        const bountyGold = addSharedAssassinBountyKill(killer as unknown as Parameters<typeof addSharedAssassinBountyKill>[0], fallen as unknown as Parameters<typeof addSharedAssassinBountyKill>[0]);
        if (bountyGold > 0 && killer?.side === "LEFT") {
          this.showFloatingText((killer as CombatUnitRecord).sprite?.x, (killer as CombatUnitRecord).sprite?.y - 78, `+${bountyGold} VÀNG`, "#ffd56b");
          this.addLog(`🗡️ ${killer.name} tích ${bountyGold} vàng thưởng Sát thủ.`, "COMBAT");
        }
        if (fallen.side === "RIGHT" && killer?.side !== "RIGHT") {
          this.recordEnemyLootDrop(fallen as unknown as Parameters<typeof this.recordEnemyLootDrop>[0], killer as unknown as Parameters<typeof this.recordEnemyLootDrop>[0]);
        }
        this.combatSpeedMultiplier = this.calculateCombatSpeedMultiplier();
      },
      onCounterAttack: ({ attacker: actingUnit, defender: tank }) => {
        this.addLog(`${tank.name} húc trả ${actingUnit.name}!`);
        this.basicAttack(tank, actingUnit, { noCounter: true });
      },
      onLifestealHeal: ({ attacker: actingUnit, heal }) => {
        this.healUnit(actingUnit, actingUnit, heal, "HÚT MÁU");
      }
    });

    this.updateCombatUnitUi(defender);
    if (attacker) this.updateCombatUnitUi(attacker);
    this.captureCoopCombatDamageDelta({
      attacker,
      defender,
      reason,
      damageType,
      outcome: damageLeft > 0 ? "hit" : "miss",
      amount: damageLeft,
      absorbed,
      isCrit
    });
    if (!options.noLog) {
      const damageLog = buildSharedDamageLog({
        attacker,
        defender,
        damageType,
        reason,
        damageLeft,
        absorbed,
        isCrit,
        hpAfter: defender.hp,
        hpMax: defender.maxHp,
        shieldAfter: defender.shield
      });
      if (damageLog) this.addLog(damageLog, "COMBAT");
    }
    if (reason) this.showFloatingText(attacker ? (attacker as CombatUnitRecord).sprite?.x : (defender as CombatUnitRecord).sprite?.x, (attacker ? (attacker as CombatUnitRecord).sprite?.y : (defender as CombatUnitRecord).sprite?.y) - 37, reason, "#ffe8ae");
    return damageLeft;
  }

  scheduleTankAutoCast(tank: unknown, preferredTarget: unknown = null) {
    return scheduleSharedTankAutoCast(this as unknown as Parameters<typeof scheduleSharedTankAutoCast>[0], tank as unknown as Parameters<typeof scheduleSharedTankAutoCast>[0], preferredTarget as unknown as Parameters<typeof scheduleSharedTankAutoCast>[0], {
      getSkillById: (skillId, actingUnit) => getResolvedSkillDefinition(skillId, {
        baseId: actingUnit?.baseId,
        star: actingUnit?.star
      }),
      selectTarget: (actingTank) => this.selectTarget(actingTank, { deterministic: true }),
      onBeforeAutoCast: ({ tank: actingTank, skill }) => {
        this.updateCombatUnitUi(actingTank);
        this.vfx?.pulseAt((actingTank as CombatUnitRecord).sprite?.x, (actingTank as CombatUnitRecord).sprite?.y - 10, 0x9bdcff, 14, 200);
        this.showFloatingText((actingTank as CombatUnitRecord).sprite?.x, (actingTank as CombatUnitRecord).sprite?.y - 62, "TỰ TUNG CHIÊU", "#9bdcff");
        this.addLog(`${actingTank.name} tự kích hoạt ${skill.name}!`);
      },
      castSkill: (actingTank, target, castOptions) => this.castSkill(actingTank as unknown as Parameters<typeof this.castSkill>[0], target || actingTank as unknown as Parameters<typeof this.castSkill>[0], castOptions),
      onAutoCastError: (error) => {
        console.error("[Tank Auto-Cast] Failed to auto-cast skill:", error);
      },
      onAfterAutoCast: (actingTank) => {
        this.updateCombatUnitUi(actingTank);
      }
    });
  }

  scheduleSupportAutoCast(support: unknown, preferredTarget: unknown = null) {
    return scheduleSharedSupportAutoCast(this as unknown as Parameters<typeof scheduleSharedSupportAutoCast>[0], support as unknown as Parameters<typeof scheduleSharedSupportAutoCast>[0], preferredTarget as unknown as Parameters<typeof scheduleSharedSupportAutoCast>[0], {
      getSkillById: (skillId, actingUnit) => getResolvedSkillDefinition(skillId, {
        baseId: actingUnit?.baseId,
        star: actingUnit?.star
      }),
      selectTarget: (actingSupport) => this.selectTarget(actingSupport, { deterministic: true }),
      onBeforeAutoCast: ({ support: actingSupport, skill }) => {
        this.updateCombatUnitUi(actingSupport);
        this.vfx?.pulseAt((actingSupport as CombatUnitRecord).sprite?.x, (actingSupport as CombatUnitRecord).sprite?.y - 10, 0xb7ffd4, 14, 180);
        this.showFloatingText((actingSupport as CombatUnitRecord).sprite?.x, (actingSupport as CombatUnitRecord).sprite?.y - 62, "NỐI CHIÊU", "#c8ffd8");
        this.addLog(`${actingSupport.name} kích hoạt ${skill.name} ngay khi đầy nộ.`, "COMBAT");
      },
      castSkill: (actingSupport, target, castOptions) => this.castSkill(actingSupport as unknown as Parameters<typeof this.castSkill>[0], target || actingSupport as unknown as Parameters<typeof this.castSkill>[0], castOptions),
      onAutoCastError: (error) => {
        console.error("[Support Auto-Cast] Failed to auto-cast skill:", error);
      },
      onAfterAutoCast: (actingSupport) => {
        this.updateCombatUnitUi(actingSupport);
      }
    });
  }

  addShield(target: CombatUnitRecord | null | undefined, amount: number) {
    // Validate inputs (Requirement 26.3)
    if (!target || !target.alive) return;
    if ((target.statuses?.shieldLockTurns ?? 0) > 0) {
      if (target.sprite) this.showFloatingText(target.sprite.x, target.sprite.y - 45, "KHÓA KHIÊN", "#ffb36b");
      return;
    }
    if (typeof amount !== 'number' || !Number.isFinite(amount) || amount < 0) {
      console.error(`[Combat Error] Invalid shield amount: ${amount}, using fallback 0`);
      amount = 0;
    }

    const val = Math.max(1, Math.round(amount));
    target.shield += val;
    if (target.sprite) {
      this.vfx?.pulseAt(target.sprite.x, target.sprite.y - 10, 0x8ce9ff, 18, 220);
      this.showFloatingText(target.sprite.x, target.sprite.y - 45, `KHIÊN +${val}`, "#8ce9ff");
    }
    this.updateCombatUnitUi(target);
  }

  healUnit(caster: unknown, target: unknown, amount: unknown, reason: unknown) {
    return applySceneHealUnit(this as unknown as Parameters<typeof applySceneHealUnit>[0], caster as unknown as Parameters<typeof applySceneHealUnit>[1], target as unknown as Parameters<typeof applySceneHealUnit>[2], Number(amount), String(reason ?? ''), {
      playAudio: true,
      pulseVfx: true
    });
  }

  updateCombatUnitUi(unit: unknown) {
    const hpRatio = clamp((unit as CombatUnitRecord).maxHp > 0 ? (unit as CombatUnitRecord).hp / (unit as CombatUnitRecord).maxHp : 0, 0, 1);
    const roleTheme = this.getRoleTheme((unit as CombatUnitRecord).classType);
    const hpInnerW = Math.max(1, (unit as CombatUnitRecord).hpBarBg.width - 2);
    const rageInnerW = Math.max(1, (unit as CombatUnitRecord).rageBarBg.width - 2);
    const shieldRatio = clamp((unit as CombatUnitRecord).maxHp > 0 ? (unit as CombatUnitRecord).shield / (unit as CombatUnitRecord).maxHp : 0, 0, 1);
    (unit as CombatUnitRecord).hpBarFill.width = Math.max(0.0001, hpInnerW * hpRatio);
    // HP bar color changes based on HP ratio: green (>= 70%), yellow (30-70%), red (< 30%)
    const hpBarColor = (unit as CombatUnitRecord).alive
      ? (hpRatio >= 0.7 ? SHARED_UNIT_BAR_COLORS.hpFill : hpRatio >= 0.3 ? SHARED_UNIT_BAR_COLORS.hpFillLow : SHARED_UNIT_BAR_COLORS.hpFillCritical)
      : SHARED_UNIT_BAR_COLORS.hpFillDead;
    (unit as CombatUnitRecord).hpBarFill.setFillStyle(hpBarColor, (unit as CombatUnitRecord).alive ? 0.98 : 0.9);
    (unit as CombatUnitRecord).shieldBar.width = Math.max(0, hpInnerW * shieldRatio);
    (unit as CombatUnitRecord).rageBarFill.width = Math.max(0.0001, rageInnerW * clamp((unit as CombatUnitRecord).rageMax > 0 ? (unit as CombatUnitRecord).rage / (unit as CombatUnitRecord).rageMax : 0, 0, 1));
    (unit as CombatUnitRecord).rageBarFill.setFillStyle((unit as CombatUnitRecord).alive ? SHARED_UNIT_BAR_COLORS.rageFill : SHARED_UNIT_BAR_COLORS.rageFillDead, (unit as CombatUnitRecord).alive ? 0.96 : 0.85);
    redrawSharedRageBarGrid((unit as CombatUnitRecord).rageGrid, {
      width: rageInnerW,
      height: (unit as CombatUnitRecord).rageBarFill.height ?? 4,
      rageMax: (unit as CombatUnitRecord).rageMax ?? 0
    });

    // Effect bars
    (unit as CombatUnitRecord).buffBar.clear();
    (unit as CombatUnitRecord).debuffBar.clear();
    if ((unit as CombatUnitRecord).alive) {
      const maxBuff = Math.max(
        (unit as CombatUnitRecord).statuses.atkBuffTurns,
        (unit as CombatUnitRecord).statuses.matkBuffTurns,
        (unit as CombatUnitRecord).statuses.defBuffTurns,
        (unit as CombatUnitRecord).statuses.mdefBuffTurns,
        (unit as CombatUnitRecord).statuses.reflectTurns,
        (unit as CombatUnitRecord).statuses.tauntTurns > 0 && !(unit as CombatUnitRecord).statuses.tauntTargetId ? (unit as CombatUnitRecord).statuses.tauntTurns : 0
      );
      if (maxBuff > 0) {
        const barW = 56;
        const segW = Math.max(3, Math.floor((barW - 2) / 5)); // max 5 segments
        const count = Math.min(5, maxBuff);
        const startX = (unit as CombatUnitRecord).hpBarBg.x - barW / 2;
        const y = (unit as CombatUnitRecord).hpBarBg.y + 13; // Below rage bar
        (unit as CombatUnitRecord).buffBar.fillStyle(0x9dffba, 0.9);
        for (let i = 0; i < count; i++) {
          (unit as CombatUnitRecord).buffBar.fillRect(startX + i * (segW + 1), y, segW, 3);
        }
      }

      const maxDebuff = Math.max(
        (unit as CombatUnitRecord).statuses.poisonTurns,
        (unit as CombatUnitRecord).statuses.burnTurns,
        (unit as CombatUnitRecord).statuses.stun,
        (unit as CombatUnitRecord).statuses.freeze,
        (unit as CombatUnitRecord).statuses.sleep,
        (unit as CombatUnitRecord).statuses.silence,
        (unit as CombatUnitRecord).statuses.armorBreakTurns,
        (unit as CombatUnitRecord).statuses.healBlockTurns,
        (unit as CombatUnitRecord).statuses.tauntTurns > 0 && (unit as CombatUnitRecord).statuses.tauntTargetId ? (unit as CombatUnitRecord).statuses.tauntTurns : 0
      );
      if (maxDebuff > 0) {
        const barW = 56;
        const segW = Math.max(3, Math.floor((barW - 2) / 5));
        const count = Math.min(5, maxDebuff);
        const startX = (unit as CombatUnitRecord).hpBarBg.x - barW / 2;
        const y = (unit as CombatUnitRecord).hpBarBg.y + 13 + (maxBuff > 0 ? 4 : 0); // Stack below buff if exists
        (unit as CombatUnitRecord).debuffBar.fillStyle(0xd4bcff, 0.9);
        for (let i = 0; i < count; i++) {
          (unit as CombatUnitRecord).debuffBar.fillRect(startX + i * (segW + 1), y, segW, 3);
        }
      }
    }

    const s = [];
    if ((unit as CombatUnitRecord).rage >= (unit as CombatUnitRecord).rageMax - 1 && (unit as CombatUnitRecord).rage > 0 && (unit as CombatUnitRecord).alive) s.push("⚡");
    if ((unit as CombatUnitRecord).shield > 0) s.push("🛡️");
    if ((unit as CombatUnitRecord).statuses.immuneTurns > 0) s.push("🧤");
    if ((unit as CombatUnitRecord).statuses.freeze > 0) s.push("❄");
    if ((unit as CombatUnitRecord).statuses.stun > 0) s.push("💫");
    if ((unit as CombatUnitRecord).statuses.sleep > 0) s.push("😴");
    if ((unit as CombatUnitRecord).statuses.silence > 0) s.push("🔇");
    if ((unit as CombatUnitRecord).statuses.disarmTurns > 0) s.push("🚫");
    if ((unit as CombatUnitRecord).statuses.burnTurns > 0) s.push("🔥");
    if ((unit as CombatUnitRecord).statuses.poisonTurns > 0) s.push("☠");
    if ((unit as CombatUnitRecord).statuses.bleedTurns > 0) s.push("🩸");
    if ((unit as CombatUnitRecord).statuses.diseaseTurns > 0) s.push("🦠");
    if (isHealBlockActive(this, unit as unknown as Parameters<typeof isHealBlockActive>[0])) s.push("💔");
    if ((unit as CombatUnitRecord).statuses.tauntTurns > 0 && (unit as CombatUnitRecord).statuses.tauntTargetId) s.push("🎯");
    if ((unit as CombatUnitRecord).statuses.armorBreakTurns > 0) s.push("⚔️");
    if (getOffenseDebuffState((unit as CombatUnitRecord).statuses, unit as unknown as Parameters<typeof getOffenseDebuffState>[0]).turns > 0) s.push("📉");
    if ((unit as CombatUnitRecord).statuses.reflectTurns > 0 || (unit as CombatUnitRecord).statuses.physReflectTurns > 0) s.push("🌀");
    const statusText = s.slice(0, 5).join(" ");
    (unit as CombatUnitRecord).statusLabel.setText(statusText);
    (unit as CombatUnitRecord).statusLabel.setVisible(Boolean(statusText));
    (unit as CombatUnitRecord).tag?.setColor?.((unit as CombatUnitRecord).alive ? Phaser.Display.Color.IntegerToColor((roleTheme as Record<string, unknown>).stroke).rgba : "#8f969e");
    syncSharedUnitVisualCount(unit as unknown as Parameters<typeof syncSharedUnitVisualCount>[0], { combat: true });

    if ((unit as CombatUnitRecord).icon) {
      if ((unit as CombatUnitRecord).icon.__lowHpActive) (unit as CombatUnitRecord).icon.__stopLowHp?.();
      clearSharedLowHpAccent(unit as unknown as Parameters<typeof clearSharedLowHpAccent>[0]);
    }
    this.refreshTeamStatusBars();
  }

  highlightUnit(unit: CombatUnitRecord | null | undefined, color: number) {
    if (!unit) return;
    const tile = this.tileLookup.get(gridKey(unit.row, unit.col));
    if (tile) {
      this.highlightLayer.lineStyle(4, color, 1);
      if (this.highlightLayer) this.drawDiamond(this.highlightLayer as Phaser.GameObjects.Graphics, tile.center.x, tile.center.y, false);
    }
  }

  clearHighlights() {
    this.highlightLayer.clear();
    this.turnIndicatorLayer?.clear();
    this.combatUnits.forEach((u) => {
      if (!u.alive) return;
      u._rgbBorderTimer?.destroy?.();
      u._rgbBorderTimer = null;
    });
  }

  showTurnIndicator(unit: CombatUnitRecord | null | undefined) {
    if (!unit) return;
    this.showTurnIndicatorAt(unit.row, unit.col);
  }

  showTurnIndicatorAt(row: number, col: number) {
    this.turnIndicatorLayer?.clear();
    const tile = this.tileLookup?.get(gridKey(row, col));
    if (!tile) return;
    this.turnIndicatorLayer.fillStyle(0xce93d8, 0.45);
    this.turnIndicatorLayer.lineStyle(2, 0xba68c8, 0.8);
    this.drawDiamond(this.turnIndicatorLayer, tile.center.x, tile.center.y);
  }

  // ─── Combat Border Effects ───────────────────────────────────

  setCombatBorder(unit: CombatUnitRecord, type: string) {
    if (!unit?.sprite) return;
    const tile = this.tileLookup?.get(gridKey(unit.row, unit.col));
    if (type === "skill") {
      const initColor = Phaser.Display.Color.HSLToColor(0, 1, 0.55).color;
      if (tile) {
        this.highlightLayer?.clear();
        this.highlightLayer?.lineStyle(4, initColor, 1);
        if (this.highlightLayer) this.drawDiamond(this.highlightLayer as Phaser.GameObjects.Graphics, tile.center.x, tile.center.y, false);
      }
      let hue = 0;
      unit._rgbBorderTimer = this.time.addEvent({
        delay: 100,
        loop: true,
        callback: () => {
          if (!unit.sprite?.active) return;
          hue = (hue + 60) % 360;
          const color = Phaser.Display.Color.HSLToColor(hue / 360, 1, 0.55).color;
          if (tile) {
            this.highlightLayer?.clear();
            this.highlightLayer?.lineStyle(4, color, 1);
            if (this.highlightLayer) this.drawDiamond(this.highlightLayer as Phaser.GameObjects.Graphics, tile.center.x, tile.center.y, false);
          }
        }
      });
    } else if (type === "attack") {
      if (tile) {
        this.highlightLayer?.clear();
        this.highlightLayer?.lineStyle(4, 0xffef9f, 1);
        if (this.highlightLayer) this.drawDiamond(this.highlightLayer as Phaser.GameObjects.Graphics, tile.center.x, tile.center.y, false);
      }
    }
  }

  clearCombatBorder(unit: CombatUnitRecord) {
    if (!unit?.sprite) return;
    if (unit._rgbBorderTimer) {
      unit._rgbBorderTimer.destroy();
      unit._rgbBorderTimer = null;
    }
    this.highlightLayer?.clear();
  }

  flashHitBorder(unit: CombatUnitRecord) {
    if (!unit?.sprite?.active) return;
  }

  tweenCombatUnit(unit: CombatUnitRecord, x: number, y: number, duration: number) {
    return new Promise((resolve) => {
      this.tweens.add({
        targets: unit.sprite,
        x,
        y,
        duration: this.scaleCombatDuration(duration),
        ease: "Sine.easeInOut",
        onUpdate: () => {
          this.syncCombatLabels(unit as CombatUnitRecord);
          if (this.previewHoverUnit?.uid === unit.uid) {
            this.showAttackPreviewForUnit(unit);
          }
        },
        onComplete: () => resolve()
      });
    });
  }

  syncCombatLabels(unit: CombatUnitRecord) {
    if (!unit?.sprite?.active) return;
    syncSharedUnitIconToSprite(unit);
    if (unit.shadow?.active) {
      unit.shadow.x = unit.sprite.x;
      unit.shadow.y = unit.sprite.y + 18;
      unit.shadow.setDepth?.(unit.sprite.y + 9);
    }
    layoutSharedTokenLabel(this as unknown as Parameters<typeof layoutSharedTokenLabel>[0], unit.tagBg as unknown as Parameters<typeof layoutSharedTokenLabel>[0], unit.tag, {
      x: unit.sprite.x,
      y: unit.sprite.y - 47
    });
    unit.hpBarBg.x = unit.sprite.x;
    unit.hpBarBg.y = unit.sprite.y + 11;
    unit.hpBarFill.x = unit.sprite.x - unit.hpBarBg.width / 2 + 1;
    unit.hpBarFill.y = unit.sprite.y + 11;
    unit.shieldBar.x = unit.sprite.x - unit.hpBarBg.width / 2 + 1;
    unit.shieldBar.y = unit.sprite.y + 11;
    unit.rageBarBg.x = unit.sprite.x;
    unit.rageBarBg.y = unit.sprite.y + 18;
    unit.rageBarFill.x = unit.sprite.x - unit.rageBarBg.width / 2 + 1;
    unit.rageBarFill.y = unit.sprite.y + 18;
    unit.rageGrid.setPosition?.(unit.sprite.x - unit.rageBarBg.width / 2 + 1, unit.sprite.y + 18);
    unit.statusLabel.x = unit.sprite.x;
    unit.statusLabel.y = unit.sprite.y + 24;
    unit.sprite.setDepth(unit.sprite.y + 10);
    if (unit.icon?.setDepth) unit.icon.setDepth(unit.sprite.y + 14);
    unit.tagBg.setDepth(unit.sprite.y + 11);
    unit.tag.setDepth(unit.sprite.y + 11);
    unit.hpBarBg.setDepth(unit.sprite.y + 11);
    unit.hpBarFill.setDepth(unit.sprite.y + 12);
    unit.shieldBar.setDepth(unit.sprite.y + 13);
    unit.rageBarBg.setDepth(unit.sprite.y + 11);
    unit.rageBarFill.setDepth(unit.sprite.y + 12);
    unit.rageGrid.setDepth(unit.sprite.y + 13);
    unit.statusLabel.setDepth(unit.sprite.y + 11);

    // Re-draw graphics-based status bars at the new position to avoid "ghost" trails
    // when units move (rage grid / buff / debuff bars are drawn in world coords).
    this.updateCombatUnitUi(unit);
  }

  wait(ms: number) {
    return new Promise((resolve) => {
      this.time.delayedCall(this.scaleCombatDuration(ms), resolve);
    });
  }

  showDamageNumber(x: number, y: number, amount: number, options: { damageType?: string; isCrit?: boolean; authoritativeDelta?: boolean } = {}) {
    const value = Math.max(0, Math.round(Number(amount) || 0));
    if (value <= 0) return;
    const damageType = options.damageType ?? "physical";
    const isCrit = options.isCrit === true;
    const color = damageType === "magic" ? "#d9a6ff" : damageType === "true" ? "#f2f7ff" : "#ff9b9b";
    const stroke = damageType === "magic" ? "#34164b" : "#20101a";
    const fontSize = isCrit ? 26 : 18;

    // Clean up expired damage numbers (older than 2000ms)
    const now = Date.now();
    this.activeDamageNumbers = this.activeDamageNumbers.filter(dn => now - dn.timestamp < 2000);

    // Check for overlapping damage numbers within 30 pixels
    const OVERLAP_THRESHOLD = 40;
    const OFFSET_AMOUNT = 28;
    let adjustedY = y;

    for (const activeDN of this.activeDamageNumbers) {
      const dx = Math.abs(activeDN.x - x);
      const dy = Math.abs(activeDN.y - adjustedY);

      // If within overlap threshold, offset the y-position
      if (dx < OVERLAP_THRESHOLD && dy < OVERLAP_THRESHOLD) {
        adjustedY -= OFFSET_AMOUNT;
      }
    }

    // Track this damage number
    this.activeDamageNumbers.push({
      x,
      y: adjustedY,
      timestamp: now
    });

    const textStyle = {
      fontFamily: BATTLE_TEXT_FONT,
      fontSize: `${fontSize}px`,
      fontStyle: "bold",
      color,
      stroke,
      strokeThickness: isCrit ? 7 : 5
    };
    const pool = this.fxPool;
    const label = pool?.acquireText(x, adjustedY, `-${value}${isCrit ? "!" : ""}`, textStyle, 4300)
      ?? this.add.text(x, adjustedY, `-${value}${isCrit ? "!" : ""}`, textStyle).setOrigin(0.5);
    if (!pool) {
      label.setDepth(4300);
      this.combatSprites.push(label);
    }
    if (isCrit) label.setScale(0.72);
    const tweenConfig = {
      y: adjustedY - (isCrit ? 44 : 34),
      alpha: 0,
      scale: isCrit ? 1.12 : 1.0,
      duration: isCrit ? 7500 : 6000,
      hold: 800,
      ease: "Sine.easeIn"
    };
    if (pool) {
      pool.tween(label, tweenConfig as unknown as Parameters<typeof pool.tween>[0], "text");
      return;
    }
    this.tweens.add({
      targets: label,
      ...tweenConfig,
      onComplete: () => label.destroy?.()
    });
  }

  showFloatingText(x: unknown, y: unknown, text: unknown, color: unknown = "#ffffff") {
    if (this.vfx) {
      this.vfx.textPop(x as unknown as Parameters<typeof this.vfx.textPop>[0], y as unknown as Parameters<typeof this.vfx.textPop>[0], text as unknown as Parameters<typeof this.vfx.textPop>[0], color);
      return;
    }
    const label = this.add.text(Number(x) - 10, Number(y), text as unknown as Parameters<typeof this.add.text>[0], {
      fontFamily: BATTLE_TEXT_FONT,
      fontSize: "14px",
      fontStyle: "bold",
      color,
      stroke: "#000000",
      strokeThickness: 4
    });
    label.setDepth(4000);
    this.combatSprites.push(label);
    this.tweens.add({
      targets: label,
      y: Number(y) - 30,
      alpha: 0,
      duration: 2700,
      hold: 500, // Giữ nguyên 500ms trước khi mờ
      ease: "Sine.easeIn",
      onComplete: () => {
        if (label && label.destroy) label.destroy();
      }
    });
  }

  resolveCombat(winnerSide: unknown) {
    return resolveCombatToPlanning(this as unknown as Parameters<typeof resolveCombatToPlanning>[0], winnerSide as unknown as Parameters<typeof resolveCombatToPlanning>[0]);
  }

  gridToScreen(col: unknown, row: unknown) {
    return gridToSharedBoardScreen(this as unknown as Parameters<typeof gridToSharedBoardScreen>[0], col as unknown as Parameters<typeof gridToSharedBoardScreen>[0], row);
  }
}





















