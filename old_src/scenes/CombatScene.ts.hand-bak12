function getSceneTurnCycleIndex(scene: UnknownRecord | null | undefined): number {
  const raw = (scene as TurnCycleSceneLike | null | undefined)?.combatTurnIndex ?? scene?.combatRound;
  const num = Number(raw);
  return Number.isFinite(num) ? Math.max(0, Math.floor(num)) : 0;
}

function setSceneTurnCycleIndex(scene: UnknownRecord | null | undefined, value: number): number {
  const normalized = Number.isFinite(value) ? Math.max(0, Math.floor(value)) : 0;
  const s = scene as TurnCycleSceneLike | null | undefined;
  if (s) {
    s.combatTurnIndex = normalized;
    if (s.roomCombatMeta) {
      s.roomCombatMeta.combatTurnIndex = normalized;
    }
  }
  return normalized;
}

function readPayloadTurnCycleIndex(payload: UnknownRecord | null | undefined, fallback = 0): number {
  const raw = (payload as CoopPayloadTurnCycleLike | null | undefined)?.turnCycleIndex ?? payload?.combatRound;
  const num = Number(raw);
  return Number.isFinite(num) ? Math.max(0, Math.floor(num)) : Math.max(0, Math.floor(fallback || 0));
}

function resolveSceneRoundEnvironment(scene: UnknownRecord | null | undefined): BattlefieldEnvironment {
  const s = scene as RoundEnvironmentSceneLike | null;
  const roundVal = s?.player?.round ?? s?.roomCombatMeta?.round ?? s?.coopRunState?.shared?.round ?? 1;
  return resolveRoundEnvironment(Number(roundVal));
}

function applyRoundEnvironmentToUnits(units: EnvironmentUnit[] = [], round: number = 1): BattlefieldEnvironment {
  const environment = resolveRoundEnvironment(round);
  units.forEach((unit) => {
    applyEnvironmentModsToCombatUnit(unit, environment);
  });
  return environment;
}

function buildLootDropSourceContext(unit: CombatUnitRecord | null | undefined): UnknownRecord {
  const base = UNIT_BY_ID[unit?.baseId ?? ""];
  return {
    sourceUnitName: unit?.name ?? base?.name ?? "Linh thú địch",
    sourceBaseId: unit?.baseId ?? base?.id ?? null,
    sourceSpecies: String(base?.species ?? unit?.species ?? "").toLowerCase() || null,
    sourceTribe: base?.tribe ?? unit?.tribe ?? null,
    sourceClassType: base?.classType ?? unit?.classType ?? null,
    sourceTier: clamp(Number.isFinite(Number(unit?.tier)) ? Math.floor(Number(unit?.tier)) : 1, 1, 5),
    sourceStar: Math.max(1, Number.isFinite(Number(unit?.star)) ? Math.floor(Number(unit?.star)) : 1)
  };
}

function pickRandomLootItem(pool: unknown[], randomFn: (() => number) | null): unknown {
  if (!Array.isArray(pool) || !pool.length) return null;
  const randomValue = typeof randomFn === "function" ? randomFn() : Math.random();
  const index = clamp(Math.floor(randomValue * pool.length), 0, pool.length - 1);
  return pool[index] ?? pool[0] ?? null;
}



export class CombatScene extends Phaser.Scene {
  [key: string]: unknown;
  // Typed class field declarations
  phase!: string;
  aiMode!: string;
  gameModeConfig!: GameModeConfig | null;
  tileLookup!: Map<string, { center: { x: number; y: number }; [key: string]: unknown }>;
  playerCellZones!: Array<{ row: number; col: number; zone: Phaser.GameObjects.Zone }>;
  buttons!: Record<string, SceneButton>;
  benchSlots!: Array<{ x: number; y: number; slotW: number; slotH: number; bg: Phaser.GameObjects.Rectangle; label: Phaser.GameObjects.Text }>;
  shopCards!: Array<{ bg: Phaser.GameObjects.Rectangle; text: Phaser.GameObjects.Text; icon: Phaser.GameObjects.GameObject | null }>;
  planningSprites!: Phaser.GameObjects.GameObject[];
  combatSprites!: Phaser.GameObjects.GameObject[];
  overlaySprites!: Phaser.GameObjects.GameObject[];
  decorationSprites!: Phaser.GameObjects.GameObject[];
  logs!: Array<{ text: string; category?: string; ts?: number; [key: string]: unknown }>;
  selectedBenchIndex!: number | null;
  turnQueue!: Array<{ row: number; col: number; side: string; unit: CombatUnitRecord | null }>;
  turnIndex!: number;
  combatRound!: number;
  turnCycleIndex!: number;
  actionCount!: number;
  collectionProfile!: CollectionProfile;
  globalDamageMult!: number;
  isActing!: boolean;
  runStatePayload!: RunState | null;
  roomCombatMeta!: UnknownRecord | null;
  coopRunState!: CoopRunState | null;
  coopLocalSlot!: string;
  _coopClientUnsubscribeFns!: Array<() => void>;
  _coopPlanningTransitionRequested!: boolean;
  _coopAwaitingHostResult!: boolean;
  _coopDisconnectHandled!: boolean;
  _coopDisconnectReason!: string | null;
  _coopCombatSyncTimer!: Phaser.Time.TimerEvent | null;
  _coopCombatHeartbeatTimer!: Phaser.Time.TimerEvent | null;
  _coopCombatSnapshotRevision!: number;
  _coopCombatDeltaRevision!: number;
  _coopCombatDeltaEventCounter!: number;
  _lastAppliedCoopCombatSnapshotRevision!: number;
  _lastAppliedCoopCombatDeltaRevision!: number;
  _pendingCoopCombatDeltas!: CoopCombatDeltaEvent[];
  _pvpReportSent!: boolean;
  _pvpResolutionHandled!: boolean;
  _pvpCombatSyncTimer!: Phaser.Time.TimerEvent | null;
  logicRandom!: () => number;
  layout!: { width: number; height: number; mode?: string; [key: string]: unknown } | null;
  settingsVisible!: boolean;
  settingsOverlay!: Array<{ [key: string]: unknown }>;
  modalButtons!: Record<string, SceneButton>;
  roundBackgroundImage!: Phaser.GameObjects.Image | null;
  roundBackgroundMask!: Phaser.GameObjects.GameObject | null;
  roundBackgroundKey!: string | null;
  logHistory!: Array<{ message: string; category?: string; ts?: number; [key: string]: unknown }>;
  historyFilter!: string;
  historyModalVisible!: boolean;
  historyModalParts!: Array<{ container: Phaser.GameObjects.Container; [key: string]: unknown }>;
  historyFilterButtons!: Array<{ btn: Phaser.GameObjects.Container; category: string; [key: string]: unknown }>;
  historyListItems!: Array<{ container: Phaser.GameObjects.Container; entry: { message: string; category?: string }; [key: string]: unknown }>;
  historyScrollOffset!: number;
  historyMaxScroll!: number;
  historyListViewport!: Phaser.GameObjects.GameObject | null;
  historyButtonRect!: { x: number; y: number; w: number; h: number } | null;
  attackPreviewLayer!: Phaser.GameObjects.Graphics | null;
  attackPreviewSword!: Phaser.GameObjects.Graphics | null;
  previewHoverUnit!: CombatUnitRecord | null;
  rightPanelArea!: Phaser.GameObjects.Container | null;
  rightPanelMask!: Phaser.GameObjects.Graphics | null;
  rightPanelMaskShape!: Phaser.GameObjects.Graphics | null;
  rightPanelScrollItems!: Array<{ container: Phaser.GameObjects.Container; [key: string]: unknown }>;
  rightPanelScrollOffset!: number;
  rightPanelMaxScroll!: number;
  remoteMatchHudElements!: Array<{ setVisible?: (visible: boolean) => void; [key: string]: unknown }>;
  remoteMatchCard!: Phaser.GameObjects.Container | null;
  remoteMatchTitleText!: Phaser.GameObjects.Text | null;
  remoteMatchPairText!: Phaser.GameObjects.Text | null;
  remoteMatchSideAText!: Phaser.GameObjects.Text | null;
  remoteMatchSideBText!: Phaser.GameObjects.Text | null;
  remoteMatchProgressText!: Phaser.GameObjects.Text | null;
  remoteMatchFreshnessText!: Phaser.GameObjects.Text | null;
  teamStatusHud!: Phaser.GameObjects.Container | null;
  combatHudConfig!: { compact?: boolean; showRemoteMatchCard?: boolean; mode?: string; columns?: number; buttonSize?: number; [key: string]: unknown } | null;
  logPreviewMaxLines!: number;
  queuePreviewLimit!: number;
  boardEdgeLabels!: Array<{ label: Phaser.GameObjects.Text; col: number; row: number; anchor: string }>;
  gapMarkers!: Phaser.GameObjects.GameObject[];
  loseCondition!: LoseConditionType;
  combatLootDrops!: string[];
  combatLootDropDetails!: Array<{ itemId: string; sourceType?: string; sourceHint?: string | null; [key: string]: unknown }>;
  boardZoom!: number;
  boardPanX!: number;
  boardPanY!: number;
  isBoardDragging!: boolean;
  lastDragPoint!: { x: number; y: number } | null;
  boardPointerDown!: boolean | null;
  boardDragConsumed!: boolean;
  combatBubblePopupBounds!: { x: number; y: number; width: number; height: number } | null;
  combatBubblePopupVisible!: boolean;
  combatBubblePopupOpen!: boolean;
  activeDamageNumbers!: Array<{ x: number; y: number; timestamp: number }>;
  battlefieldBackdrop!: Phaser.GameObjects.Graphics | null;
  battlefieldFx!: Phaser.GameObjects.Graphics | null;
  roundEnvironment!: ReturnType<typeof resolveRoundEnvironment> | null;
  player!: PlayerState;
  _lastCombatEventVoiceAt!: number | null;
  _lastCombatEventVoiceKey!: string;
  _lastCombatEventVoicePriority!: number;
  _lastCombatSkillVoiceAt!: number | null;
  _lastCombatSkillVoiceKey!: string;
  tooltip!: TooltipController | null;
  audioFx!: AudioFx | null;
  fxPool!: FxPool | null;
  vfx!: VfxController | null;
  combatTickEvent!: Phaser.Time.TimerEvent | null;
  originX!: number;
  originY!: number;
  highlightLayer!: Phaser.GameObjects.Graphics;
  turnIndicatorLayer!: Phaser.GameObjects.Graphics;
  libraryModal!: LibraryModal | null;
  _libraryModalPromise!: Promise<unknown> | null;
  _settingsPanelObj!: { close: () => void; overlay?: unknown[]; refresh: (...args: unknown[]) => void; closeShortcutsView: () => void; isShortcutsViewOpen: () => boolean; [key: string]: unknown } | null;
  _settingsCloseShortcutsView!: (() => void) | null;
  _settingsIsShortcutsOpen!: (() => void) | null;
  augmentSystem!: AugmentSystem | null;
  coopOwnershipLabels!: Phaser.GameObjects.GameObject[];
  shopTitle!: Phaser.GameObjects.Text | null;
  benchTitle!: Phaser.GameObjects.Text | null;
  headerText!: Phaser.GameObjects.Text;
  phaseText!: Phaser.GameObjects.Text;
  logText!: Phaser.GameObjects.Text;
  queueText!: Phaser.GameObjects.Text;
  synergyText!: Phaser.GameObjects.Text;
  combatRoundLabel!: Phaser.GameObjects.Text | null;
  currentAugmentChoices!: Array<{ def: { id: string; [key: string]: unknown } }> | null;
  critPolicy!: { baseCritChance: number; [key: string]: unknown };
  boardOriginX!: number;
  boardOriginY!: number;
  combatUnits!: CombatUnitRecord[];
  combatState!: { phase?: string; turnIndex?: number; [key: string]: unknown } | null;
  combatSpeedMultiplier!: number;

  constructor() {
    super("CombatScene");
    this.phase = PHASE.PLANNING;
    this.aiMode = "MEDIUM";
    this.gameModeConfig = null;
    this.tileLookup = new Map();
    this.playerCellZones = [];
    this.buttons = {};
    this.benchSlots = [];
    this.shopCards = [];
    this.planningSprites = [];
    this.combatSprites = [];
    this.overlaySprites = [];
    this.logs = [];
    this.selectedBenchIndex = null;
    this.turnQueue = [];
    this.turnIndex = 0;
    this.combatRound = 0;
    this.turnCycleIndex = 0;
    this.actionCount = 0;
    this.collectionProfile = loadCollectionProfile();
    this.globalDamageMult = 1;
    this.isActing = false;
    this.runStatePayload = null;
    this.roomCombatMeta = null as unknown as Record<string, unknown>
    this.coopRunState = null;
    this.coopLocalSlot = "P1";
    this._coopClientUnsubscribeFns = [];
    this._coopPlanningTransitionRequested = false;
    this._coopAwaitingHostResult = false;
    this._coopDisconnectHandled = false;
    this._coopDisconnectReason = null;
    this._coopCombatSyncTimer = null;
    this._coopCombatHeartbeatTimer = null;
    this._coopCombatSnapshotRevision = 0;
    this._coopCombatDeltaRevision = 0;
    this._coopCombatDeltaEventCounter = 0;
    this._lastAppliedCoopCombatSnapshotRevision = 0;
    this._lastAppliedCoopCombatDeltaRevision = 0;
    this._pendingCoopCombatDeltas = [];
    this._pvpReportSent = false;
    this._pvpResolutionHandled = false;
    this._pvpCombatSyncTimer = null;
    this.logicRandom = Math.random;
    this.layout = null;
    this.settingsVisible = false;
    this.settingsOverlay = [];
    this.roundBackgroundImage = null;
    this.roundBackgroundMask = null;
    this.roundBackgroundKey = null;
    this.logHistory = [];
    this.historyFilter = "ALL";
    this.historyModalVisible = false;
    this.historyModalParts = [];
    this.historyFilterButtons = [];
    this.historyListItems = [];
    this.historyScrollOffset = 0;
    this.historyMaxScroll = 0;
    this.historyListViewport = null;
    this.historyButtonRect = null;
    this.attackPreviewLayer = null;
    this.attackPreviewSword = null;
    this.previewHoverUnit = null;
    this.rightPanelArea = null;
    this.rightPanelMask = null;
    this.rightPanelMaskShape = null;
    this.rightPanelScrollItems = [];
    this.rightPanelScrollOffset = 0;
    this.rightPanelMaxScroll = 0;
    this.remoteMatchHudElements = [];
    this.remoteMatchCard = null;
    this.remoteMatchTitleText = null;
    this.remoteMatchPairText = null;
    this.remoteMatchSideAText = null;
    this.remoteMatchSideBText = null;
    this.remoteMatchProgressText = null;
    this.remoteMatchFreshnessText = null;
    this.teamStatusHud = null;
    this.combatHudConfig = null;
    this.logPreviewMaxLines = 4;
    this.queuePreviewLimit = 8;
    this.boardEdgeLabels = [];
    this.gapMarkers = [];
    this.loseCondition = "NO_UNITS";
    this.combatLootDrops = [];
    this.combatLootDropDetails = [];
    this.boardZoom = 1;
    this.boardPanX = 0;
    this.boardPanY = 0;
    this.isBoardDragging = false;
    this.lastDragPoint = null;
    this.boardPointerDown = null;
    this.boardDragConsumed = false;
    this.combatBubblePopupBounds = null;
    this.combatBubblePopupVisible = false;
    this.combatBubblePopupOpen = false;

    if (this.libraryModal) {
      this.libraryModal.hide();
    }

    // Track active damage numbers for position offsetting
    this.activeDamageNumbers = [];

    // Combat speed multiplier based on unit count (Requirement 11.1, 11.2)
    this.combatSpeedMultiplier = COMBAT_SLOW_MULTIPLIER;
    this.battlefieldBackdrop = null;
    this.battlefieldFx = null;
    this.roundEnvironment = null;
    this.roundEnvironment = null;
  }

  /**
   * Calculate combat speed multiplier based on player's purchased speed level.
   * Higher purchased speed means lower duration multiplier and faster combat flow.
   * @returns {number} Duration multiplier (lower = faster)
   */
  calculateCombatSpeedMultiplier() {
    return getCombatDurationMultiplier(this.player?.speedLevel ?? 0);
  }

  scaleCombatDuration(ms: unknown) {
    const value = Number(ms);
    if (!Number.isFinite(value) || value <= 0) return 0;
    return Math.max(1, Math.round(value * this.combatSpeedMultiplier));
  }

  isCoopMode() {
    if (this.coopRunState?.players) return true;
    const requestedAiMode = normalizeAiMode(
      (this.runStatePayload as unknown as CoopRunState | null)?.coopDifficulty
        ?? this.runStatePayload?.aiMode
        ?? this.aiMode,
      "MEDIUM"
    );
    return !!this.runStatePayload?.players || (getCoopSession() && isCoopAiMode(requestedAiMode));
  }

  isPvpRoomMode() {
    return (this.roomCombatMeta as unknown as Record<string, unknown>)?.sessionType === PVP_FORTRESS_SESSION_TYPE;
  }

  getSessionLocalSlot() {
    return (this.roomCombatMeta as unknown as Record<string, unknown>)?.localSlot
      ?? (getCoopSession() as unknown as CoopSessionLike | null)?.localSlot
      ?? this.coopLocalSlot
      ?? "P1";
  }

  isSessionHost() {
    const session = getCoopSession() as CoopSessionLike | null;
    return !!session && (session.hostSlot ?? "P1") === this.getSessionLocalSlot();
  }

  getPvpSessionSlots() {
    const capacity = getCoopSession()?.playerCapacity ?? 4;
    return getCoopPlayerSlots(capacity >= 4 ? "COOP4_MEDIUM" : "COOP_MEDIUM");
  }

  getCoopLocalSlot() {
    const sessionSlot = (getCoopSession() as unknown as CoopSessionLike | null)?.localSlot;
    const resolved = this.coopLocalSlot ?? sessionSlot ?? "P1";
    return getCoopPlayerSlots(this.aiMode).includes(resolved) ? resolved : "P1";
  }

  getBoardProfileId() {
    if (!this.isCoopMode()) return "solo";
    return getCoopBoardProfileId(normalizeAiMode(
      this.coopRunState?.coopDifficulty
        ?? this.coopRunState?.aiMode
        ?? (this.runStatePayload as unknown as CoopRunState | null)?.coopDifficulty
        ?? this.runStatePayload?.aiMode
        ?? this.aiMode,
      "COOP_MEDIUM"
    ));
  }

  isCoopHost() {
    return this.isCoopMode() && (this.coopRunState?.hostSlot ?? "P1") === this.getCoopLocalSlot();
  }

  getBoardRowCount() {
    return getBoardProfile(this.getBoardProfileId()).rows;
  }

  cleanupCoopBindings() {
    this.stopCoopCombatSyncTimer();
    this.stopPvpCombatSyncTimer();
    if (!Array.isArray(this._coopClientUnsubscribeFns)) {
      this._coopClientUnsubscribeFns = [];
      return;
    }
    this._coopClientUnsubscribeFns.forEach((unsubscribe) => unsubscribe?.());
    this._coopClientUnsubscribeFns = [];
  }

  bindCoopSessionTransport() {
    this.cleanupCoopBindings();
    if (!this.isCoopMode() && !this.isPvpRoomMode()) return;
    const session = getCoopSession() as CoopSessionLike | null;
  const client = session?.client;
    if (!client) return;
    if (this.isPvpRoomMode()) {
      this._coopClientUnsubscribeFns = [
        client.on(COOP_MESSAGE_TYPES.ROOM_STATE, (payload: unknown) => this.handleIncomingRoomState(payload)),
        client.on(COOP_MESSAGE_TYPES.AUTHORITATIVE_SNAPSHOT, (payload: unknown) => this.handleIncomingPvpCombatSnapshot(payload)),
        client.on(COOP_MESSAGE_TYPES.COMBAT_RESULT, (payload: unknown) => {
          if (isPvpFortressReportPayload(payload)) {
            this.handleIncomingPvpCombatReport(payload);
            return;
          }
          if (isPvpFortressResolutionPayload(payload)) {
            this.handleIncomingPvpCombatResolution(payload);
          }
        }),
        client.on(COOP_MESSAGE_TYPES.PLAYER_DISCONNECTED, () => {
          this.addLog("Có người chơi đã rời ván.");
        })
      ];
      this.syncPvpCombatSnapshot();
      this.startPvpCombatSyncTimer();
      return;
    }
    this._coopClientUnsubscribeFns = [
      client.on(COOP_MESSAGE_TYPES.ROOM_STATE, (payload: unknown) => this.handleIncomingRoomState(payload)),
      client.on(COOP_MESSAGE_TYPES.AUTHORITATIVE_SNAPSHOT, (payload: unknown) => this.handleIncomingCoopCombatSnapshot(payload)),
      client.on(COOP_MESSAGE_TYPES.COMBAT_DELTA, (payload: unknown) => this.handleIncomingCoopCombatDelta(payload)),
      client.on(COOP_MESSAGE_TYPES.COMBAT_HEARTBEAT, (payload: unknown) => this.handleIncomingCoopCombatHeartbeat(payload)),
      client.on(COOP_MESSAGE_TYPES.COMBAT_RESULT, (payload: unknown) => this.handleIncomingCoopCombatResult(payload)),
      client.on(COOP_MESSAGE_TYPES.COMBAT_RETREAT, (payload: unknown) => this.handleIncomingCoopCombatRetreat(payload)),
      client.on(COOP_MESSAGE_TYPES.PLAYER_DISCONNECTED, () => {
        this.addLog("Đồng đội đã ngắt kết nối.");
        this.handleCoopSessionDisconnected("player_disconnected");
      }),
      client.on("close", () => this.handleCoopSessionDisconnected("socket_close")),
      client.on("error", () => this.handleCoopSessionDisconnected("socket_error"))
    ];
    if (this.isCoopAuthoritativeCombatSyncEnabled()) {
      if (this.isCoopHost()) {
        this.syncCoopCombatSnapshot("bind");
        this.startCoopCombatSyncTimer();
        this.startCoopCombatHeartbeatTimer();
      } else {
        this.stopCoopCombatSyncTimer();
      }
    }
  }

  handleIncomingRoomState(payload: unknown) {
    if (!payload || typeof payload !== "object") return;
    const p = payload as Record<string, unknown>;
    const hostSlot = Number.isInteger(p.hostSlotIndex) ? `P${Number(p.hostSlotIndex) + 1}` : null;
    const session = getCoopSession() as CoopSessionLike | null;
    const patch: Record<string, unknown> = {
      roomCode: typeof p.roomCode === "string" ? p.roomCode : session?.roomCode ?? "",
      roomPlayers: Array.isArray(p.players) ? p.players : undefined
    };
    if (hostSlot) patch.hostSlot = hostSlot;
    if (typeof p.selectedMode === "string" && p.selectedMode) patch.selectedMode = p.selectedMode;
    if (typeof p.aiMode === "string" && p.aiMode) patch.aiMode = p.aiMode;
    if (typeof p.saveSlotId === "string" && p.saveSlotId) patch.activeSaveSlotId = p.saveSlotId;
    if (typeof p.saveMode === "string" && p.saveMode) patch.saveMode = p.saveMode;
    if (p.resumeSummary === null) patch.resumeSummary = null;
    if (p.resumeSummary && typeof p.resumeSummary === "object") patch.resumeSummary = p.resumeSummary;
    updateCoopSession(patch as unknown as Parameters<typeof updateCoopSession>[0]);
  }

  normalizeIncomingCoopRunState(state: unknown): CoopRunState | null {
    const hydrated = hydrateRunState(state) as unknown as CoopRunState | null;
    if (!hydrated?.players) return hydrated;
    const session = getCoopSession() as CoopSessionLike | null;
    (hydrated as CoopRunState).localSlot = String((session as unknown as CoopSessionLike | null)?.localSlot ?? hydrated.localSlot);
    (hydrated as CoopRunState).hostSlot = String((session as unknown as CoopSessionLike | null)?.hostSlot ?? hydrated.hostSlot);
    return hydrated;
  }

  handleIncomingCoopCombatResult(payload: unknown) {
    if (this.isPvpRoomMode() || !this.isCoopMode() || this._coopPlanningTransitionRequested) return;
    const p = payload as Record<string, unknown> | null;
    const restoredState = this.normalizeIncomingCoopRunState(
      p?.restoredState ?? p?.runState ?? this.runStatePayload
    );
    const result = p?.result ?? null;
    if (!restoredState || !result) return;
    this._coopAwaitingHostResult = false;
    this._coopPlanningTransitionRequested = true;
    this.stopCoopCombatSyncTimer();
    updateCoopSession({
      roomCode: restoredState?.roomCode,
      localSlot: (getCoopSession() as unknown as CoopSessionLike | null)?.localSlot ?? restoredState?.localSlot,
      hostSlot: (getCoopSession() as unknown as CoopSessionLike | null)?.hostSlot ?? restoredState?.hostSlot,
      aiMode: restoredState?.coopDifficulty ?? restoredState.aiMode,
      players: restoredState.players,
      shared: restoredState?.shared
    } as unknown as Parameters<typeof updateCoopSession>[0]);
    this.clearCombatSprites();
    startManagedScene(this as unknown as Parameters<typeof startManagedScene>[0], "PlanningScene", {
      restoredState,
      combatResult: result
    });
  }

  getCoopMainMenuData() {
    return {
      openStartPanel: true,
      selectedMode: (getCoopSession() as unknown as CoopSessionLike | null)?.selectedMode ?? this.player?.gameMode ?? "EndlessPvEClassic"
    };
  }

  persistActiveCoopSave(runState: unknown = this.runStatePayload) {
    if (!this.isCoopMode() || this.isPvpRoomMode()) return null;
    const session = getCoopSession() as CoopSessionLike | null;
    const slotId = typeof session?.activeSaveSlotId === "string" ? session.activeSaveSlotId : null;
    if (!slotId || !runState) return null;
    const saved = saveCoopSaveSlot(slotId, runState);
    if (!saved) return null;
    updateCoopSession({
      activeSaveSlotId: slotId,
      saveMode: typeof session?.saveMode === "string" ? session.saveMode : "new",
      resumeSummary: saved.summary,
      resumeState: saved.payload
    });
    return saved;
  }

  clearActiveCoopSave() {
    if (!this.isCoopMode() || this.isPvpRoomMode()) return false;
    const session = getCoopSession() as CoopSessionLike | null;
    const slotId = typeof session?.activeSaveSlotId === "string" ? session.activeSaveSlotId : null;
    if (!slotId) return false;
    const cleared = clearCoopSaveSlot(slotId);
    updateCoopSession({
      activeSaveSlotId: slotId,
      resumeSummary: null,
      resumeState: null
    });
    return cleared;
  }

  handleCoopSessionDisconnected(reason: string = "disconnect") {
    if (!this.isCoopMode() || this.isPvpRoomMode() || this._coopDisconnectHandled) return;
    this._coopDisconnectHandled = true;
    this._coopDisconnectReason = typeof reason === "string" ? reason : String(reason);
    this.persistActiveCoopSave(this.runStatePayload);
    this.toggleSettingsOverlay(false);
    this.toggleHistoryModal(false);
    this.cleanupCoopBindings();
    this.clearCombatSprites();
    try {
      (getCoopSession() as unknown as CoopSessionLike | null)?.client?.close?.(1000, "Coop combat disconnected");
    } catch (_error) {
      // Best-effort close only; the local slot save is already written.
    }
    clearCoopSession();
    this.scene.start("MainMenuScene", this.getCoopMainMenuData());
  }

  buildCoopRetreatPayload() {
    if (!this.isCoopMode() || this.isPvpRoomMode()) return null;
    const restoredState = this.normalizeIncomingCoopRunState(this.runStatePayload);
    if (!restoredState?.players) return null;
    const resolvedAiMode = normalizeAiMode(restoredState?.coopDifficulty ?? restoredState.aiMode, "COOP_MEDIUM");
    const playerSlots = getCoopPlayerSlots(resolvedAiMode);
    const enemyAlive = this.getCombatUnits("RIGHT").length;
    const penalty = 1 + enemyAlive;
    const round = Math.max(1, Math.floor(restoredState?.shared?.round ?? this.player?.round ?? 1));
    (restoredState as CoopRunState).shared = {
      ...(restoredState?.shared ?? {}),
      round,
      phase: PHASE.PLANNING
    };
    playerSlots.forEach((slot) => {
      const player = restoredState.players?.[slot];
      if (!player) return;
      player.round = round;
      player.loseCondition = "NO_HEARTS";
      player.hp = Math.max(0, Math.floor(player.hp ?? 0) - penalty);
    });
    const localSlot = (getCoopSession() as unknown as CoopSessionLike | null)?.localSlot ?? restoredState?.localSlot ?? playerSlots[0];
    const localPlayer = restoredState.players?.[localSlot] ?? restoredState.players?.[playerSlots[0]] ?? null;
    return {
      restoredState: serializeRunState(restoredState),
      penalty,
      enemyAlive,
      defeated: (localPlayer?.hp ?? 0) <= 0
    };
  }

  resolveCoopCombatRetreat(payload: unknown) {
    const p = payload as Record<string, unknown> | null;
    const restoredState = this.normalizeIncomingCoopRunState(
      p?.restoredState ?? p?.runState ?? this.runStatePayload
    );
    if (!restoredState?.players) return;
    this._coopPlanningTransitionRequested = true;
    this.stopCoopCombatSyncTimer();
    const resolvedAiMode = normalizeAiMode(restoredState?.coopDifficulty ?? restoredState.aiMode, "COOP_MEDIUM");
    const playerSlots = getCoopPlayerSlots(resolvedAiMode);
    const localSlot = (getCoopSession() as unknown as CoopSessionLike | null)?.localSlot ?? restoredState?.localSlot ?? playerSlots[0];
    const localPlayer = restoredState.players?.[localSlot] ?? restoredState.players?.[playerSlots[0]] ?? null;
    const defeated = p?.defeated === true || (localPlayer?.hp ?? 0) <= 0;
    updateCoopSession({
      roomCode: restoredState?.roomCode,
      localSlot,
      hostSlot: (getCoopSession() as unknown as CoopSessionLike | null)?.hostSlot ?? restoredState?.hostSlot,
      aiMode: restoredState?.coopDifficulty ?? restoredState.aiMode,
      selectedMode: localPlayer?.gameMode ?? (getCoopSession() as unknown as CoopSessionLike | null)?.selectedMode,
      players: restoredState.players,
      shared: restoredState?.shared
    } as CoopSessionInput);
    this.clearCombatSprites();
    if (defeated) {
      this.clearActiveCoopSave();
      this.cleanupCoopBindings();
      try {
        (getCoopSession() as unknown as CoopSessionLike | null)?.client?.close?.(1000, "Coop run defeated");
      } catch (_error) {
        // Ignore close failures during defeat cleanup.
      }
      clearCoopSession();
      this.scene.start("MainMenuScene", this.getCoopMainMenuData());
      return;
    }
    this.persistActiveCoopSave(restoredState);
    startManagedScene(this as unknown as Parameters<typeof startManagedScene>[0], "PlanningScene", {
      restoredState
    });
  }

  handleIncomingCoopCombatRetreat(payload: unknown) {
    const p = payload as Record<string, unknown>;
    if (this.isPvpRoomMode() || !this.isCoopMode() || this._coopPlanningTransitionRequested) return;
    this._coopAwaitingHostResult = false;
    this.resolveCoopCombatRetreat(payload);
  }

  handleCoopCombatResolution(result: unknown) {
    if (this.isPvpRoomMode() || !this.isCoopMode()) return null;
    if (!this.isCoopHost()) {
      this._coopAwaitingHostResult = true;
      this.stopCoopCombatSyncTimer();
      this.clearCombatSprites();
      this.addLog("Đang chờ kết quả từ chủ phòng...");
      return "wait";
    }
    this._coopAwaitingHostResult = false;
    this.flushCoopCombatDeltaQueue("resolution");
    this.syncCoopCombatSnapshot("resolution");
    this._coopPlanningTransitionRequested = true;
    this.stopCoopCombatSyncTimer();
    try {
      (getCoopSession() as unknown as CoopSessionLike | null)?.client?.send({
        type: COOP_MESSAGE_TYPES.COMBAT_RESULT,
        payload: {
          restoredState: this.runStatePayload,
          result
        }
      });
    } catch (error) {
      console.warn("[CombatScene] Failed to broadcast coop combat result.", error);
    }
    return null;
  }

  handleIncomingPvpCombatReport(payload: unknown) {
    const p = payload as Record<string, unknown>;
    if (!this.isPvpRoomMode() || !this.isSessionHost() || !isPvpFortressReportPayload(payload)) return;
    const session = getCoopSession() as CoopSessionLike | null;
    const slots = this.getPvpSessionSlots();
    const baseState = normalizePvpFortressState(session?.pvpState, {
      slots,
      startingHp: this.gameModeConfig?.startingHP ?? 100
    });
    if (!baseState.expectedPairIds.includes(String(p?.pairId ?? ""))) return;
    if (baseState.reportByPairId?.[String(p?.pairId ?? "")]) return;
    const nextState = {
      ...baseState,
      reportByPairId: {
        ...(baseState.reportByPairId ?? {}),
        [String(p?.pairId ?? "")]: payload as UnknownRecord
      }
    };
    updateCoopSession({
      sessionType: PVP_FORTRESS_SESSION_TYPE,
      pvpState: nextState
    } as CoopSessionInput);
    const resolvedAllPairs = nextState.expectedPairIds.every((pairId) => nextState.reportByPairId?.[pairId]);
    if (!resolvedAllPairs) return;
    const resolutionPayload = resolvePvpFortressRound({
      pvpState: nextState,
      players: session?.players ?? {}
    });
    updateCoopSession({
      sessionType: PVP_FORTRESS_SESSION_TYPE,
      currentCombatPayload: null,
      pvpState: resolutionPayload.pvpState
    });
    try {
      session?.client?.send({
        type: COOP_MESSAGE_TYPES.COMBAT_RESULT,
        payload: resolutionPayload
      });
    } catch (error) {
      console.warn("[CombatScene] Failed to broadcast pvp combat resolution.", error);
    }
    this.handleIncomingPvpCombatResolution(resolutionPayload);
  }

  setRemoteMatchHudVisible(visible: boolean) {
    const elements = Array.isArray(this.remoteMatchHudElements) && this.remoteMatchHudElements.length
      ? this.remoteMatchHudElements
      : [
          this.remoteMatchCard,
          this.remoteMatchTitleText,
          this.remoteMatchPairText,
          this.remoteMatchSideAText,
          this.remoteMatchSideBText,
          this.remoteMatchProgressText,
          this.remoteMatchFreshnessText
        ].filter(Boolean);
    elements.forEach((element) => (element as unknown as { setVisible?: (visible: boolean) => void })?.setVisible?.(visible));
  }

  getRemoteMatchHudModel(now = Date.now()) {
    if (this.gameModeConfig?.id !== "PVP4Fortress") return null;
    const session = getCoopSession() as CoopSessionLike | null;
    const pvpState = normalizePvpFortressState(session?.pvpState, {
      slots: this.getPvpSessionSlots(),
      startingHp: this.gameModeConfig?.startingHP ?? 100
    });
    return buildPvpFortressRemoteMatchHudModel({
      modeId: this.gameModeConfig?.id,
      currentPairId: (this.roomCombatMeta as unknown as Record<string, unknown>)?.pairId ?? null,
      currentMatchups: pvpState.currentMatchups,
      combatSnapshotsBySlot: (session as CoopSessionLike | null)?.combatSnapshotsBySlot ?? {},
      now
    });
  }

  refreshRemoteMatchHud(now = Date.now()) {
    if (!this.remoteMatchCard && !this.remoteMatchPairText) return;
    const model = this.getRemoteMatchHudModel?.(now) ?? null;
    if (!model) {
      this.setRemoteMatchHudVisible?.(false);
      return;
    }
    this.setRemoteMatchHudVisible?.(true);
    const resolveSideColor = (side: { hasData?: boolean; isLeading?: boolean; stale?: boolean } | null) => {
      if (!side?.hasData) return UI_COLORS.textMuted;
      if (side.isLeading) return "#ffe08a";
      if (side.stale) return UI_COLORS.textSecondary;
      return UI_COLORS.textPrimary;
    };
    const sideA = model.sides?.[0] ?? null;
    const sideB = model.sides?.[1] ?? null;
    if ((this.remoteMatchCard as unknown as { setStrokeStyle?: (w: number, c: number, a: number) => void })?.setStrokeStyle) (this.remoteMatchCard as { setStrokeStyle?: (w: number, c: number, a: number) => void }).setStrokeStyle?.(1, model.stale ? 0xcf9f62 : 0x6baee2, 0.72);
    this.remoteMatchPairText?.setText(model.pairLabel ?? "");
    this.remoteMatchSideAText?.setText(sideA?.text ?? "").setColor(resolveSideColor(sideA));
    this.remoteMatchSideBText?.setText(sideB?.text ?? "").setColor(resolveSideColor(sideB));
    this.remoteMatchProgressText?.setText(model.progressText ?? "");
    this.remoteMatchFreshnessText?.setText(model.freshnessText ?? "").setColor(
      model.waiting ? UI_COLORS.textMuted : (model.stale ? "#ffcb96" : UI_COLORS.textSecondary)
    );
  }

  isCoopAuthoritativeCombatSyncEnabled() {
    return this.isCoopMode()
      && !this.isPvpRoomMode()
      && (this.player?.gameMode ?? this.gameModeConfig?.id ?? "EndlessPvEClassic") === "EndlessPvEClassic";
  }

  stopCoopCombatSyncTimer() {
    if (this._coopCombatSyncTimer) {
      this._coopCombatSyncTimer.remove(false);
      this._coopCombatSyncTimer = null;
    }
    if (this._coopCombatHeartbeatTimer) {
      this._coopCombatHeartbeatTimer.remove(false);
      this._coopCombatHeartbeatTimer = null;
    }
  }

  startCoopCombatSyncTimer() {
    this.stopCoopCombatSyncTimer();
    if (!this.isCoopAuthoritativeCombatSyncEnabled() || !this.isCoopHost() || !this.time) return;
    this._coopCombatSyncTimer = this.time.addEvent({
      delay: COOP_SURVIVAL_COMBAT_SNAPSHOT_INTERVAL_MS,
      loop: true,
      callback: () => {
        this.syncCoopCombatSnapshot("interval");
      }
    });
  }

  startCoopCombatHeartbeatTimer() {
    if (!this.isCoopAuthoritativeCombatSyncEnabled() || !this.isCoopHost() || !this.time) return;
    if (this._coopCombatHeartbeatTimer) {
      this._coopCombatHeartbeatTimer.remove(false);
    }
    this._coopCombatHeartbeatTimer = this.time.addEvent({
      delay: COOP_SURVIVAL_COMBAT_HEARTBEAT_INTERVAL_MS,
      loop: true,
      callback: () => {
        this.syncCoopCombatTransportPulse();
      }
    });
  }

  buildCoopCombatSnapshotSummary(now = Date.now()) {
    const turnCycleIndex = getSceneTurnCycleIndex(this as UnknownRecord);
    return {
      round: this.player?.round ?? this.coopRunState?.shared?.round ?? 1,
      phase: this.phase,
      turnCycleIndex,
      combatRound: turnCycleIndex,
      actionCount: this.actionCount,
      turnIndex: this.turnIndex,
      isActing: this.isActing === true,
      lastDeltaRevision: this._coopCombatDeltaRevision || 0,
      timestamp: now,
      units: Array.isArray(this.combatUnits) ? this.combatUnits : []
    };
  }

  buildCoopCombatHeartbeatSummary(now = Date.now()) {
    const turnCycleIndex = getSceneTurnCycleIndex(this as UnknownRecord);
    return {
      round: this.player?.round ?? this.coopRunState?.shared?.round ?? 1,
      turnCycleIndex,
      combatRound: turnCycleIndex,
      turnIndex: this.turnIndex,
      lastDeltaRevision: this._coopCombatDeltaRevision || 0,
      lastSnapshotRevision: this._coopCombatSnapshotRevision || 0,
      timestamp: now
    };
  }

  nextCoopCombatDeltaEventId() {
    this._coopCombatDeltaEventCounter = (this._coopCombatDeltaEventCounter || 0) + 1;
    return `coop:${this.player?.round ?? 1}:${getSceneTurnCycleIndex(this)}:${this._coopCombatDeltaEventCounter}`;
  }

  queueCoopCombatDeltaEvent(event: CoopCombatDeltaEvent = {}) {
    if (!this.isCoopAuthoritativeCombatSyncEnabled() || !this.isCoopHost() || this._coopPlanningTransitionRequested) return false;
    if (!Array.isArray(this._pendingCoopCombatDeltas)) {
      this._pendingCoopCombatDeltas = [];
    }
    this._pendingCoopCombatDeltas.push({
      eventId: typeof event?.eventId === "string" && event.eventId ? event.eventId : this.nextCoopCombatDeltaEventId(),
      reason: typeof event?.reason === "string" ? event.reason : "",
      damageType: event?.damageType,
      outcome: event?.outcome,
      amount: event?.amount,
      absorbed: event?.absorbed,
      isCrit: event?.isCrit === true,
      attackerUid: typeof event?.attackerUid === "string" ? event.attackerUid : null,
      defenderUid: typeof event?.defenderUid === "string" ? event.defenderUid : null,
      attackerState: event?.attackerState ?? null,
      defenderState: event?.defenderState ?? null
    });
    return true;
  }

  captureCoopCombatDamageDelta(
    {
      attacker = null,
      defender = null,
      reason = "",
      damageType = "physical",
      outcome = "hit",
      amount = 0,
      absorbed = 0,
      isCrit = false
    }: {
      attacker?: Record<string, unknown> | null;
      defender?: Record<string, unknown> | null;
      reason?: string;
      damageType?: string;
      outcome?: string;
      amount?: number;
      absorbed?: number;
      isCrit?: boolean;
    } = {}
  ) {
    return this.queueCoopCombatDeltaEvent({
      reason,
      damageType,
      outcome,
      amount,
      absorbed,
      isCrit,
      attackerUid: typeof attacker?.uid === "string" ? 'attackerUid as string' : null,
      defenderUid: typeof defender?.uid === "string" ? defender.uid : null,
      attackerState: attacker ? (serializeCoopCombatUnitState(attacker) as unknown as Record<string, unknown>) : null,
      defenderState: defender ? (serializeCoopCombatUnitState(defender) as unknown as Record<string, unknown>) : null
    });
  }

  flushCoopCombatDeltaQueue(reason: unknown = "heartbeat") {
    if (!this.isCoopAuthoritativeCombatSyncEnabled() || !this.isCoopHost() || this._coopPlanningTransitionRequested) return false;
    const session = getCoopSession() as CoopSessionLike | null;
  const client = session?.client;
    if (!client || this.phase !== PHASE.COMBAT) return false;
    const events = Array.isArray(this._pendingCoopCombatDeltas)
      ? this._pendingCoopCombatDeltas.splice(0, this._pendingCoopCombatDeltas.length)
      : [];
    if (!events.length) return false;
    const revision = (this._coopCombatDeltaRevision || 0) + 1;
    const deltaState = {
      ...this.buildCoopCombatHeartbeatSummary(),
      lastSnapshotRevision: this._coopCombatSnapshotRevision || 0,
      events
    };
    const payload = buildCoopSurvivalCombatDelta(deltaState, revision);
    (payload as unknown as Record<string, unknown>).reason = reason;
    this._coopCombatDeltaRevision = revision;
    updateCoopSession({
      coopCombatDelta: payload
    } as CoopSessionInput);
    try {
      client.send({
        type: COOP_MESSAGE_TYPES.COMBAT_DELTA,
        payload
      });
      return true;
    } catch (error) {
      console.warn("[CombatScene] Failed to sync coop combat delta.", error);
      this._pendingCoopCombatDeltas = [...events, ...(this._pendingCoopCombatDeltas ?? [])];
      return false;
    }
  }

  syncCoopCombatHeartbeat() {
    if (!this.isCoopAuthoritativeCombatSyncEnabled() || !this.isCoopHost() || this._coopPlanningTransitionRequested) return false;
    const session = getCoopSession() as CoopSessionLike | null;
  const client = session?.client;
    if (!client || this.phase !== PHASE.COMBAT) return false;
    const payload = buildCoopSurvivalCombatHeartbeat(this.buildCoopCombatHeartbeatSummary());
    updateCoopSession({
      coopCombatHeartbeat: payload
    } as CoopSessionInput);
    try {
      client.send({
        type: COOP_MESSAGE_TYPES.COMBAT_HEARTBEAT,
        payload
      });
      return true;
    } catch (error) {
      console.warn("[CombatScene] Failed to sync coop combat heartbeat.", error);
      return false;
    }
  }

  syncCoopCombatTransportPulse() {
    if (this.flushCoopCombatDeltaQueue("heartbeat")) return true;
    return this.syncCoopCombatHeartbeat();
  }

  syncCoopCombatSnapshot(reason: unknown = "manual") {
    if (!this.isCoopAuthoritativeCombatSyncEnabled() || !this.isCoopHost() || this._coopPlanningTransitionRequested) return;
    const session = getCoopSession() as CoopSessionLike | null;
  const client = session?.client;
    if (!client || this.phase !== PHASE.COMBAT) return;
    const revision = (this._coopCombatSnapshotRevision || 0) + 1;
    const payload = buildCoopSurvivalCombatSnapshot(this.buildCoopCombatSnapshotSummary(), revision);
    (payload as unknown as Record<string, unknown>).reason = reason;
    this._coopCombatSnapshotRevision = revision;
    updateCoopSession({
      coopCombatSnapshot: payload
    } as CoopSessionInput);
    try {
      client.send({
        type: COOP_MESSAGE_TYPES.AUTHORITATIVE_SNAPSHOT,
        payload
      });
    } catch (error) {
      console.warn("[CombatScene] Failed to sync coop combat snapshot.", error);
    }
  }

  applyCoopCombatUnitState(combatUnit: CombatUnitRecord, authoritativeUnit: Record<string, unknown>) {
    if (!combatUnit || !authoritativeUnit) return false;
    combatUnit.row = Number.isFinite(authoritativeUnit.row) ? Math.max(0, Math.floor(Number(authoritativeUnit.row))) : combatUnit.row;
    combatUnit.col = Number.isFinite(authoritativeUnit.col) ? Math.max(0, Math.floor(Number(authoritativeUnit.col))) : combatUnit.col;
    combatUnit.homeRow = Number.isFinite(authoritativeUnit.homeRow) ? Math.max(0, Math.floor(Number(authoritativeUnit.homeRow))) : combatUnit.homeRow;
    combatUnit.homeCol = Number.isFinite(authoritativeUnit.homeCol) ? Math.max(0, Math.floor(Number(authoritativeUnit.homeCol))) : combatUnit.homeCol;
    combatUnit.maxHp = Number.isFinite(authoritativeUnit.maxHp) ? Math.max(0, Math.round(Number(authoritativeUnit.maxHp))) : combatUnit.maxHp;
    combatUnit.hp = Number.isFinite(authoritativeUnit.hp) ? Math.max(0, Math.round(Number(authoritativeUnit.hp))) : combatUnit.hp;
    combatUnit.shield = Number.isFinite(authoritativeUnit.shield) ? Math.max(0, Math.round(Number(authoritativeUnit.shield))) : combatUnit.shield;
    combatUnit.rage = Number.isFinite(authoritativeUnit.rage) ? Math.max(0, Math.round(Number(authoritativeUnit.rage))) : combatUnit.rage;
    combatUnit.alive = authoritativeUnit.alive !== false && authoritativeUnit.alive !== undefined;
    combatUnit.statuses = authoritativeUnit.statuses && typeof authoritativeUnit.statuses === "object"
      ? { ...authoritativeUnit.statuses as Record<string, unknown> }
      : combatUnit.statuses;
    const point = this.gridToScreen(combatUnit.col, combatUnit.row);
    combatUnit.sprite?.setPosition?.(point.x, point.y - 10);
    this.syncCombatLabels(combatUnit);
    this.updateCombatUnitUi(combatUnit);
    return true;
  }

  applyCoopCombatSnapshot(payload: Record<string, unknown> | null) {
    const p = payload as Record<string, unknown> | null;
    const snapshotUnits = Array.isArray(p?.units) ? p.units as unknown[] : [];
    if (!snapshotUnits.length || !Array.isArray(this.combatUnits) || !this.combatUnits.length) return false;
    const unitByUid = new Map(this.combatUnits.map((unit) => [unit?.uid, unit]));
    const applyUnitState = typeof this.applyCoopCombatUnitState === "function"
      ? this.applyCoopCombatUnitState
      : CombatScene.prototype.applyCoopCombatUnitState;
    let didApply = false;
    snapshotUnits.forEach((snapshotUnit: unknown) => {
      const snapUnit = snapshotUnit as Record<string, unknown> | null;
      const combatUnit = unitByUid.get(snapUnit?.uid as string);
      if (!combatUnit) return;
      didApply = applyUnitState.call(this, combatUnit, snapUnit as UnknownRecord) || didApply;
    });
    if (!didApply) return false;
    setSceneTurnCycleIndex(this as UnknownRecord, readPayloadTurnCycleIndex(p, getSceneTurnCycleIndex(this as UnknownRecord)));
    this.actionCount = Number.isFinite(Number(p?.actionCount ?? 0)) ? Math.max(0, Math.floor(Number(p?.actionCount ?? 0))) : this.actionCount;
    this.turnIndex = Number.isFinite(payload?.turnIndex) ? Math.max(0, Math.floor(Number(payload.turnIndex))) : this.turnIndex;
    this.isActing = p?.isActing === true;
    this.buildTurnQueue();
    this.turnIndex = Number.isFinite(payload?.turnIndex)
      ? Math.min(this.turnQueue.length, Math.max(0, Math.floor(Number(p.turnIndex))))
      : this.turnIndex;
    this.updateRoundLabel();
    this.refreshQueuePreview();
    this.refreshHeader();
    return true;
  }

  applyPendingCoopCombatSnapshot() {
    if (!this.isCoopAuthoritativeCombatSyncEnabled() || this.isCoopHost()) return false;
    const payload = (getCoopSession() as unknown as CoopSessionLike | null)?.coopCombatSnapshot;
    if (!isCoopSurvivalCombatSnapshotPayload(payload)) return false;
    const p = payload as Record<string, unknown> | null;
    const revision = Number.isFinite(Number((p as Record<string, unknown> | null)?.revision)) ? Math.floor(Number((p as Record<string, unknown> | null)?.revision ?? 0)) : 0;
    if (revision <= (this._lastAppliedCoopCombatSnapshotRevision || 0)) return false;
    const applied = this.applyCoopCombatSnapshot(payload as UnknownRecord);
    if (!applied) return false;
    this._lastAppliedCoopCombatSnapshotRevision = revision;
    this._lastAppliedCoopCombatDeltaRevision = Math.max(
      this._lastAppliedCoopCombatDeltaRevision || 0,
      getCoopCombatSnapshotCoveredDeltaRevision(payload as UnknownRecord | null)
    );
    return true;
  }

  handleIncomingCoopCombatSnapshot(payload: unknown) {
    const p = payload as Record<string, unknown>;
    if (!this.isCoopAuthoritativeCombatSyncEnabled() || this.isCoopHost() || !isCoopSurvivalCombatSnapshotPayload(payload)) return;
    const revision = Number.isFinite((p as Record<string, unknown>)?.revision) ? Math.floor(Number((p as Record<string, unknown>)?.revision ?? 0)) : 0;
    const cachedSession = getCoopSession() as unknown as CoopSessionLike | null;
    const cachedRevision = Number.isFinite(Number((cachedSession as unknown as CoopSessionLike | null)?.coopCombatSnapshot?.revision))
      ? Math.floor(Number((cachedSession as unknown as CoopSessionLike | null)?.coopCombatSnapshot?.revision ?? 0))
      : 0;
    if (revision <= Math.max(this._lastAppliedCoopCombatSnapshotRevision || 0, cachedRevision)) return;
    updateCoopSession({ coopCombatSnapshot: p } as unknown as Parameters<typeof updateCoopSession>[0]);
    if (this.phase !== PHASE.COMBAT || this._coopPlanningTransitionRequested) return;
    this.applyPendingCoopCombatSnapshot();
  }

  applyCoopCombatDeltaEvent(event: CoopCombatDeltaEvent, unitByUid: Map<string, CombatUnitRecord> | null = null) {
    if (!event || !Array.isArray(this.combatUnits) || !this.combatUnits.length) return false;
    const lookup = unitByUid ?? new Map(this.combatUnits.map((unit) => [unit?.uid ?? "", unit]));
    const attackerUid = typeof event.attackerUid === "string" ? event.attackerUid : null;
    const defenderUid = typeof event.defenderUid === "string" ? event.defenderUid : null;
    const attackerUnit = attackerUid ? lookup.get(attackerUid) : null;
    const defenderUnit = defenderUid ? lookup.get(defenderUid) : null;
    const applyUnitState = typeof this.applyCoopCombatUnitState === "function"
      ? this.applyCoopCombatUnitState
      : CombatScene.prototype.applyCoopCombatUnitState;
    let didApply = false;
    if (attackerUnit && event?.attackerState) {
      didApply = applyUnitState.call(this, attackerUnit, event.attackerState as Record<string, unknown>) || didApply;
    }
    if (defenderUnit && event?.defenderState) {
      didApply = applyUnitState.call(this, defenderUnit, event.defenderState as Record<string, unknown>) || didApply;
    }
    if (defenderUnit && event?.outcome === "hit" && Number.isFinite(event?.amount) && Number(event?.amount) > 0) {
      this.showDamageNumber(defenderUnit.sprite?.x ?? 0, (defenderUnit.sprite?.y ?? 10) - 45, Number((event as Record<string, unknown>).amount ?? 0), {
        damageType: (event as Record<string, unknown>).damageType,
        isCrit: (event as Record<string, unknown>).isCrit === true,
        authoritativeDelta: true
      });
    }
    return didApply;
  }

  applyPendingCoopCombatDelta() {
    if (!this.isCoopAuthoritativeCombatSyncEnabled() || this.isCoopHost()) return false;
    const payload = (getCoopSession() as unknown as CoopSessionLike | null)?.coopCombatDelta;
    if (!isCoopSurvivalCombatDeltaPayload(payload)) return false;
    const revision = getCoopCombatDeltaRevision(payload);
    const coveredRevision = Math.max(
      this._lastAppliedCoopCombatDeltaRevision || 0,
      getCoopCombatSnapshotCoveredDeltaRevision((getCoopSession() as unknown as CoopSessionLike | null)?.coopCombatSnapshot)
    );
    if (revision <= coveredRevision) return false;
    const unitByUid = new Map((this.combatUnits ?? []).map((unit) => [unit?.uid, unit]));
    const p = payload as Record<string, unknown>;
    const events = Array.isArray(p?.events) ? p.events as unknown[] : [];
    const applyDeltaEvent = typeof this.applyCoopCombatDeltaEvent === "function"
      ? this.applyCoopCombatDeltaEvent
      : CombatScene.prototype.applyCoopCombatDeltaEvent;
    let didApply = false;
    events.forEach((event: unknown) => {
      didApply = applyDeltaEvent.call(this, event as CoopCombatDeltaEvent, unitByUid) || didApply;
    });
    setSceneTurnCycleIndex(this as UnknownRecord, readPayloadTurnCycleIndex(p, getSceneTurnCycleIndex(this as UnknownRecord)));
    this.turnIndex = Number.isFinite(p?.turnIndex) ? Math.max(0, Math.floor(Number(p.turnIndex))) : this.turnIndex;
    this.buildTurnQueue();
    this.turnIndex = Number.isFinite(p?.turnIndex)
      ? Math.min(this.turnQueue.length, Math.max(0, Math.floor(Number(p.turnIndex))))
      : this.turnIndex;
    this.updateRoundLabel();
    this.refreshQueuePreview();
    this.refreshHeader();
    this._lastAppliedCoopCombatDeltaRevision = revision;
    return didApply || events.length > 0;
  }

  handleIncomingCoopCombatDelta(payload: unknown) {
    if (!this.isCoopAuthoritativeCombatSyncEnabled() || this.isCoopHost() || !isCoopSurvivalCombatDeltaPayload(payload)) return;
    const p = payload as Record<string, unknown>;
    const revision = getCoopCombatDeltaRevision(p);
    const cachedRevision = getCoopCombatDeltaRevision((getCoopSession() as unknown as CoopSessionLike | null)?.coopCombatDelta);
    const coveredRevision = Math.max(
      this._lastAppliedCoopCombatDeltaRevision || 0,
      getCoopCombatSnapshotCoveredDeltaRevision((getCoopSession() as unknown as CoopSessionLike | null)?.coopCombatSnapshot),
      cachedRevision
    );
    if (revision <= coveredRevision) return;
    updateCoopSession({ coopCombatDelta: p } as unknown as Parameters<typeof updateCoopSession>[0]);
    if (this.phase !== PHASE.COMBAT || this._coopPlanningTransitionRequested) return;
    this.applyPendingCoopCombatDelta();
  }

  handleIncomingCoopCombatHeartbeat(payload: unknown) {
    const p = payload as Record<string, unknown> | null;
        if (!this.isCoopAuthoritativeCombatSyncEnabled() || this.isCoopHost() || !isCoopSurvivalCombatHeartbeatPayload(payload)) return;
    const cachedHeartbeat = (getCoopSession() as unknown as CoopSessionLike | null)?.coopCombatHeartbeat;
    const cachedMarker = Math.max(
      getCoopCombatHeartbeatLastDeltaRevision(cachedHeartbeat),
      getCoopCombatHeartbeatLastSnapshotRevision(cachedHeartbeat)
    );
    const nextMarker = Math.max(
      getCoopCombatHeartbeatLastDeltaRevision(payload as unknown as Record<string, unknown>),
      getCoopCombatHeartbeatLastSnapshotRevision(payload as unknown as Record<string, unknown>)
    );
    const cachedTimestamp = Number.isFinite((cachedHeartbeat as Record<string, unknown> | null)?.timestamp) ? Math.floor(Number((cachedHeartbeat as UnknownRecord | null)?.timestamp ?? 0)) : 0;
    const nextTimestamp = Number.isFinite(Number((p as Record<string, unknown> | null)?.timestamp)) ? Math.floor(Number((p as Record<string, unknown> | null)?.timestamp ?? 0)) : 0;
    if (nextMarker < cachedMarker || (nextMarker === cachedMarker && nextTimestamp <= cachedTimestamp)) return;
    updateCoopSession({ coopCombatHeartbeat: payload } as unknown as Parameters<typeof updateCoopSession>[0]);
  }

  shouldSuppressLocalCoopDamageNumbers(options: { authoritativeDelta?: boolean } = {}) {
    return this.isCoopAuthoritativeCombatSyncEnabled()
      && !this.isCoopHost()
      && (options?.authoritativeDelta ?? false) !== true;
  }

  stopPvpCombatSyncTimer() {
    if (!this._pvpCombatSyncTimer) return;
    this._pvpCombatSyncTimer.remove(false);
    this._pvpCombatSyncTimer = null;
  }

  startPvpCombatSyncTimer() {
    this.stopPvpCombatSyncTimer();
    if (!this.isPvpRoomMode() || !this.time) return;
    this._pvpCombatSyncTimer = this.time.addEvent({
      delay: PVP_FORTRESS_SNAPSHOT_INTERVAL_MS,
      loop: true,
      callback: () => {
        this.syncPvpCombatSnapshot();
      }
    });
  }

  buildPvpCombatSnapshotSummary() {
    const combatUnits = Array.isArray(this.combatUnits) ? this.combatUnits : [];
    const leftAlive = combatUnits.filter((unit) => unit?.alive && unit.side === "LEFT");
    const rightAlive = combatUnits.filter((unit) => unit?.alive && unit.side === "RIGHT");
    const turnCycleIndex = getSceneTurnCycleIndex(this as UnknownRecord);
    const sumSideHp = (side: string) => combatUnits.reduce((total, unit) => {
      if (!unit?.alive || unit.side !== side) return total;
      return total + (Number.isFinite(unit.hp) ? unit.hp : 0);
    }, 0);
    return {
      phase: this.phase,
      round: this.player?.round ?? (this.roomCombatMeta as unknown as Record<string, unknown>)?.round ?? 1,
      turnCycleIndex,
      combatRound: turnCycleIndex,
      actionCount: this.actionCount,
      turnIndex: this.turnIndex,
      queueRemaining: Array.isArray(this.turnQueue)
        ? Math.max(0, this.turnQueue.length - (Number.isFinite(this.turnIndex) ? this.turnIndex : 0))
        : 0,
      leftAlive: leftAlive.length,
      rightAlive: rightAlive.length,
      leftHpTotal: sumSideHp("LEFT"),
      rightHpTotal: sumSideHp("RIGHT"),
      playerHp: this.player?.hp,
      timestamp: Date.now()
    };
  }

  syncPvpCombatSnapshot() {
    if (!this.isPvpRoomMode() || this._coopPlanningTransitionRequested) return;
    const session = getCoopSession() as CoopSessionLike | null;
    const localSlot = String(this.getSessionLocalSlot() ?? '');
    if (!session?.client || !localSlot || !(this.roomCombatMeta as unknown as Record<string, unknown>)?.pairId) return;
    const payload = buildPvpFortressCombatSnapshot(
      this.buildPvpCombatSnapshotSummary(),
      (this.roomCombatMeta as unknown as Record<string, unknown>),
      localSlot as unknown as Parameters<typeof buildPvpFortressCombatSnapshot>[2]
    );
    updateCoopSession({
      combatSnapshotsBySlot: {
        ...((session as unknown as CoopSessionLike | null)?.combatSnapshotsBySlot ?? {}),
        [String(localSlot ?? "")]: payload as unknown as UnknownRecord
      }
    } as CoopSessionInput);
    this.refreshRemoteMatchHud?.();
    try {
      session.client.send({
        type: COOP_MESSAGE_TYPES.AUTHORITATIVE_SNAPSHOT,
        payload
      });
    } catch (error) {
      console.warn("[CombatScene] Failed to sync pvp combat snapshot.", error);
    }
  }

  handleIncomingPvpCombatSnapshot(payload: unknown) {
    const p = payload as Record<string, unknown>;
    if (!this.isPvpRoomMode() || !isPvpFortressCombatSnapshotPayload(payload)) return;
    const session = getCoopSession() as CoopSessionLike | null;
    const allowedPairIds = new Set([
      (this.roomCombatMeta as unknown as Record<string, unknown>)?.pairId,
      ...(Array.isArray(session?.pvpState?.currentMatchups)
        ? session.pvpState.currentMatchups.map((matchup) => matchup?.pairId)
        : [])
    ].filter((pairId) => typeof pairId === "string" && pairId));
    if (!String(p?.pairId ?? "") || (allowedPairIds.size && !allowedPairIds.has(String(p?.pairId ?? "")))) return;
    const slot = typeof p?.slot === "string" ? p.slot : null;
    if (!slot) return;
    updateCoopSession({
      combatSnapshotsBySlot: {
        ...((session as unknown as CoopSessionLike | null)?.combatSnapshotsBySlot ?? {}),
        [String(slot ?? "")]: payload as UnknownRecord
      }
    } as CoopSessionInput);
    this.refreshRemoteMatchHud?.();
  }

  handleIncomingPvpCombatResolution(payload: unknown) {
    const p = payload as Record<string, unknown>;
    if (!this.isPvpRoomMode() || !isPvpFortressResolutionPayload(payload) || this._pvpResolutionHandled) return;
    const localSlot = String(this.getSessionLocalSlot() ?? '');
    const localResult = (p?.resultBySlot as Record<string, unknown> | undefined)?.[localSlot] as Record<string, unknown> | undefined;
    if (!localResult) return;
    this._pvpResolutionHandled = true;
    this._coopPlanningTransitionRequested = true;
    this.stopPvpCombatSyncTimer();
    const nextHp = Number.isFinite(localResult?.fortressHpAfter)
      ? Math.max(0, Math.floor(Number(localResult?.fortressHpAfter)))
      : this.player?.hp;
    if (this.player) {
      this.player.hp = nextHp;
    }
    updateCoopSession({
      sessionType: PVP_FORTRESS_SESSION_TYPE,
      currentCombatPayload: null,
      players: {
        [localSlot]: this.player
      },
      pvpState: p?.pvpState
    });
    this.refreshRemoteMatchHud?.();
    this.clearCombatSprites();
    startManagedScene(this as unknown as Parameters<typeof startManagedScene>[0], "PlanningScene", {
      mode: this.player?.gameMode,
      aiMode: this.aiMode,
      coopSession: true,
      restoredState: serializeRunState({
        aiMode: this.aiMode,
        audioEnabled: this.audioFx?.enabled !== false,
        player: this.player
      }),
      combatResult: localResult
    });
  }

  handlePvpCombatResolution(result: unknown) {
    if (!this.isPvpRoomMode()) return null;
    if (this._pvpResolutionHandled) return "wait";
    const reporterSlot = (this.roomCombatMeta as unknown as Record<string, unknown>)?.reporterSlot ?? (this.roomCombatMeta as unknown as Record<string, unknown>)?.localSlot;
    if (this.getSessionLocalSlot() === reporterSlot && !this._pvpReportSent) {
      const reportPayload = buildPvpFortressCombatReport(result, (this.roomCombatMeta as unknown as Record<string, unknown>), String(this.getSessionLocalSlot() ?? ""));
      this._pvpReportSent = true;
      try {
        (getCoopSession() as unknown as CoopSessionLike | null)?.client?.send({
          type: COOP_MESSAGE_TYPES.COMBAT_RESULT,
          payload: reportPayload
        });
      } catch (error) {
        console.warn("[CombatScene] Failed to submit pvp combat report.", error);
      }
    }
    this._coopPlanningTransitionRequested = true;
    this.stopPvpCombatSyncTimer();
    this.refreshRemoteMatchHud?.();
    this.clearCombatSprites();
    this.addLog("Đang chờ phân xử cặp đấu...");
    return "wait";
  }

  random() {
    return typeof this.logicRandom === "function" ? this.logicRandom() : Math.random();
  }

  randomInt(minInclusive: number = 0, maxExclusive: number = 1) {
    const min = Math.floor(minInclusive);
    const max = Math.floor(maxExclusive);
    if (max <= min) return min;
    return Math.floor(this.random() * (max - min)) + min;
  }

  rollChance(chance: number = 0) {
    const normalized = Math.max(0, Math.min(1, chance));
    return this.random() < normalized;
  }

  pickRandom(list: unknown = []) {
    if (!Array.isArray(list) || list.length === 0) return null;
    return list[this.randomInt(0, list.length)] ?? null;
  }

  shuffleRandom(list: unknown = []) {
    const copy = Array.isArray(list) ? [...list] : [];
    for (let index = copy.length - 1; index > 0; index -= 1) {
      const swapIndex = this.randomInt(0, index + 1);
      [copy[index], copy[swapIndex]] = [copy[swapIndex], copy[index]];
    }
    return copy;
  }

  sampleRandom(list: unknown[] = [], count: number = 1) {
    return this.shuffleRandom(list).slice(0, Math.max(0, Math.min(count || 0, Array.isArray(list) ? list.length : 0)));
  }

  resetTransientSceneState() {
    this.phase = PHASE.PLANNING;
    this.aiMode = "MEDIUM";
    this.gameModeConfig = null;
    this.tileLookup = new Map();
    this.playerCellZones = [];
    this.buttons = {};
    this.benchSlots = [];
    this.shopCards = [];
    this.planningSprites = [];
    this.combatSprites = [];
    this.overlaySprites = [];
    if (Array.isArray(this.decorationSprites)) {
      this.decorationSprites.forEach(s => s?.destroy?.());
    }
    this.decorationSprites = [];
    this.logs = [];
    this.selectedBenchIndex = null;
    this.turnQueue = [];
    this.turnIndex = 0;
    this.combatRound = 0;
    this.turnCycleIndex = 0;
    this.actionCount = 0;
    this.globalDamageMult = 1;
    this.isActing = false;
    this.runStatePayload = null;
    (this.roomCombatMeta as unknown as Record<string, unknown>) = null;
    this.coopRunState = null;
    this.coopLocalSlot = "P1";
    this._coopPlanningTransitionRequested = false;
    this._coopAwaitingHostResult = false;
    this._coopDisconnectHandled = false;
    this._coopDisconnectReason = null;
    this._coopCombatSyncTimer = null;
    this._coopCombatHeartbeatTimer = null;
    this._coopCombatSnapshotRevision = 0;
    this._coopCombatDeltaRevision = 0;
    this._coopCombatDeltaEventCounter = 0;
    this._lastAppliedCoopCombatSnapshotRevision = 0;
    this._lastAppliedCoopCombatDeltaRevision = 0;
    this._pendingCoopCombatDeltas = [];
    this._pvpReportSent = false;
    this._pvpResolutionHandled = false;
    this.stopPvpCombatSyncTimer();
    this.logicRandom = Math.random;
    this.layout = null;
    this.settingsVisible = false;
    this.settingsOverlay = [];
    this.modalButtons = {};
    this.roundBackgroundImage = null;
    this.roundBackgroundMask = null;
    this.roundBackgroundKey = null;
    this.logHistory = [];
    this.historyFilter = "ALL";
    this.historyModalVisible = false;
    this.historyModalParts = [];
    this.historyFilterButtons = [];
    this.historyListItems = [];
    this.historyScrollOffset = 0;
    this.historyMaxScroll = 0;
    this.historyListViewport = null;
    this.historyButtonRect = null;
    this.attackPreviewLayer = null;
    this.attackPreviewSword = null;
    this.previewHoverUnit = null;
    this.rightPanelArea = null;
    this.rightPanelMask = null;
    this.rightPanelMaskShape = null;
    this.rightPanelScrollItems = [];
    this.rightPanelScrollOffset = 0;
    this.rightPanelMaxScroll = 0;
    this.remoteMatchHudElements = [];
    this.remoteMatchCard = null;
    this.remoteMatchTitleText = null;
    this.remoteMatchPairText = null;
    this.remoteMatchSideAText = null;
    this.remoteMatchSideBText = null;
    this.remoteMatchProgressText = null;
    this.remoteMatchFreshnessText = null;
    this.teamStatusHud = null;
    this.combatHudConfig = null;
    this.logPreviewMaxLines = 4;
    this.queuePreviewLimit = 8;
    this.boardEdgeLabels = [];
    this.gapMarkers = [];
    this.loseCondition = "NO_UNITS";
    this.combatLootDrops = [];
    this.combatLootDropDetails = [];
    this.boardZoom = 1;
    this.boardPanX = 0;
    this.boardPanY = 0;
    this.isBoardDragging = false;
    this.lastDragPoint = null;
    this.boardPointerDown = null;
    this.boardDragConsumed = false;
    this.combatBubblePopupBounds = null;
    this.combatBubblePopupVisible = false;
    this.combatBubblePopupOpen = false;
    this.activeDamageNumbers = [];
    this.battlefieldBackdrop = null;
    this.battlefieldFx = null;
    this.roundEnvironment = null;
    this._lastCombatEventVoiceAt = null;
    this._lastCombatEventVoiceKey = "";
    this._lastCombatEventVoicePriority = 0;
    this._lastCombatSkillVoiceAt = null;
    this._lastCombatSkillVoiceKey = "";
    if (this.combatTickEvent) {
      this.combatTickEvent.remove(false);
      this.combatTickEvent = null;
    }
    destroyLoadingBubbleMinigame(this as unknown as Parameters<typeof destroyLoadingBubbleMinigame>[0]);
  }

  init(data: unknown) {
    this.resetTransientSceneState();
    this.runStatePayload = (data as Record<string, unknown>)?.runState ?? null;
    (this.roomCombatMeta as unknown as Record<string, unknown>) = (data as Record<string, unknown>)?.roomCombatMeta ?? null;
  }

  create() {
    this.cameras.main.setBackgroundColor("#10141b");
    this.input.keyboard?.removeAllListeners();
    this.input.removeAllListeners();
    installSharedFacingTweenPatch(this as unknown as Parameters<typeof installSharedFacingTweenPatch>[0]);

    // Get game mode configuration
    const gameMode = this.runStatePayload?.player?.gameMode
      ?? getCoopPlayerSlots(
        normalizeAiMode(String((this.runStatePayload as unknown as CoopRunState | null)?.coopDifficulty ?? ""), "COOP_MEDIUM")
      )
        .map((slot) => this.runStatePayload?.players?.[slot]?.gameMode)
        .find((mode) => typeof mode === "string")
      ?? "EndlessPvEClassic";
    this.gameModeConfig = GameModeRegistry.get(gameMode);
    if (!this.gameModeConfig) {
      console.warn(`Game mode "${gameMode}" not found, falling back to EndlessPvEClassic`);
      this.gameModeConfig = GameModeRegistry.get("EndlessPvEClassic");
    }

    const uiSettings = loadUiSettings();
    this.applyDisplaySettings(uiSettings);
    this.layout = this.computeLayout();
    this.tooltip = new TooltipController(this);
    this.audioFx = new AudioFx(this as unknown as Parameters<typeof AudioFx>[0]);
    this.audioFx.setVolumeLevel(uiSettings.volumeLevel ?? 10);
    this.fxPool = new FxPool(this);
    this.fxPool.prewarm({ circles: 48, texts: 24 });
    this.events.once("shutdown", () => this.fxPool?.drain?.());
    this.events.once("destroy", () => this.fxPool?.drain?.());
    this.vfx = new VfxController(this);
    this.drawBoard();
    this.createHud();
    this.combatBubblePopupBounds = getCombatBubblePopupBounds(this.layout as unknown as Parameters<typeof getCombatBubblePopupBounds>[0]);
    this.createTopRightButtons();
    if (this.historyButtonRect) {
      this.buttons.history = this.createButton(
        this.historyButtonRect.x,
        this.historyButtonRect.y,
        this.historyButtonRect.w,
        this.historyButtonRect.h,
        "Lịch sử",
        () => this.toggleHistoryModal(true),
        { variant: "ghost", fontSize: 12, bold: true }
      );
    }
    this.refreshCombatUtilityButtons();
    this.setupInput();

    this.combatTickEvent = this.time.addEvent({
      delay: this.scaleCombatDuration(420),
      loop: true,
      callback: () => {
        if (!this.settingsVisible && this.phase === PHASE.COMBAT) this.stepCombat();
      }
    });

    this.startFromPayload();
    this.bindCoopSessionTransport();
    this.events.once("shutdown", () => {
      this.closeCombatBubblePopup();
      this.cleanupCoopBindings();
    });
    this.events.once("destroy", () => {
      this.closeCombatBubblePopup();
      this.cleanupCoopBindings();
    });
  }

  ensureLibraryModalLoaded() {
    if (this.libraryModal) return Promise.resolve(this.libraryModal);
    if (!this._libraryModalPromise) {
      this._libraryModalPromise = loadLibraryModalModule()
        .then(({ LibraryModal }) => {
          if (!this.libraryModal) {
            this.libraryModal = new LibraryModal(this, {
              title: t("library.title"),
              onClose: () => {
                this.clearAttackPreview();
                this.refreshCombatUtilityButtons();
              }
            });
          }
          return this.libraryModal;
        })
        .finally(() => {
          this._libraryModalPromise = null;
        });
    }
    return this._libraryModalPromise;
  }

  ensureSettingsOverlayLoaded() {
    return ensureSharedSettingsOverlayLoaded(this as unknown as Parameters<typeof ensureSharedSettingsOverlayLoaded>[0], () => {
      if (this._settingsPanelObj?.overlay?.length || (this.settingsOverlay as unknown as { length: number }).length) {
        return this.settingsOverlay;
      }
      return loadCombatSettingsPanelModule()
        .then(({ buildSettingsPanel }) => {
          if (!this._settingsPanelObj) {
            this._settingsPanelObj = buildSettingsPanel(this, {
              context: "ingame",
              shortcutContext: "combat",
              hideProgress: true,
              createButton: this.createButton.bind(this),
              callbacks: {
                toggleAudio: () => this.toggleAudio(),
                changeVolume: (delta) => this.changeVolumeLevel(delta),
                changeResolution: (delta) => this.changeResolution(delta),
                changeLanguage: () => this.changeLanguage(),
                changeTooltip: (delta) => this.changeTooltipMode(delta),
                changeSubtitle: () => {
                  const currentSettings = loadUiSettings();
                  saveUiSettings({
                    ...currentSettings,
                    aiMode: this.runStatePayload?.aiMode ?? "MEDIUM",
                    audioEnabled: this.audioFx.enabled,
                    loseCondition: this.loseCondition,
                    volumeLevel: this.audioFx.getVolumeLevel(),
                    subtitleEnabled: !currentSettings.subtitleEnabled
                  });
                  this.refreshSettingsPanel();
                },
                goMainMenu: () => this.goMainMenu(),
                exitPlanning: () => this.exitToPlanning(),
                close: () => this.toggleSettingsOverlay(false)
              }
            });
            this.settingsOverlay = this._settingsPanelObj.overlay;
            this._settingsCloseShortcutsView = this._settingsPanelObj.closeShortcutsView;
            this._settingsIsShortcutsOpen = this._settingsPanelObj.isShortcutsViewOpen;
          }
          return this.settingsOverlay;
        });
    });
  }

  toggleLibraryModal() {
    this.tooltip?.hide?.();
    this.closeCombatBubblePopup();
    if (this.libraryModal) {
      this.libraryModal.toggle();
      this.refreshCombatUtilityButtons();
      return;
    }
    void this.ensureLibraryModalLoaded().then((modal: { toggle: () => void }) => {
      modal.toggle();
      this.refreshCombatUtilityButtons();
    });
  }

  refreshCombatUtilityButtons() {
    const bubbleEnabled = this.phase === PHASE.COMBAT
      && !this.settingsVisible
      && !this.historyModalVisible
      && !this.libraryModal?.isOpen?.();
    this.buttons.bubbles?.setLabel(getCombatBubbleButtonLabel());
    this.buttons.bubbles?.setEnabled(bubbleEnabled);
    this.buttons.wiki?.setLabel(getUtilityLibraryButtonLabel());
    this.buttons.wiki?.setEnabled(true);
    this.buttons.settings?.setLabel(getUtilitySettingsButtonLabel());
    this.buttons.settings?.setEnabled(true);
  }

  openCombatBubblePopup() {
    if (this.phase !== PHASE.COMBAT || this.combatBubblePopupOpen) return;
    if (this.settingsVisible || this.historyModalVisible || this.libraryModal?.isOpen?.()) return;
    if (!this.layout) return;

    const bounds = this.combatBubblePopupBounds ?? getCombatBubblePopupBounds(this.layout as unknown as Parameters<typeof getCombatBubblePopupBounds>[0]);
    this.combatBubblePopupBounds = bounds;
    installLoadingBubbleMinigame(this as unknown as Parameters<typeof installLoadingBubbleMinigame>[0], {
      bounds,
      title: "BONG BÓNG",
      detailText: "Đập bong bóng trong lúc quái đang giao tranh.",
      instructionText: "Bấm trong khung để bắn emoji vào bong bóng.",
      showProgressBar: false,
      interactiveScope: "bounds",
      depthBase: 2200
    });
    this.combatBubblePopupOpen = true;
    this.combatBubblePopupVisible = true;
    this.refreshCombatUtilityButtons();
  }

  closeCombatBubblePopup() {
    destroyLoadingBubbleMinigame(this as unknown as Parameters<typeof destroyLoadingBubbleMinigame>[0]);
    this.combatBubblePopupOpen = false;
    this.combatBubblePopupVisible = false;
    this.refreshCombatUtilityButtons();
  }

  toggleCombatBubblePopup(force: unknown = null) {
    const next = typeof force === "boolean" ? force : !this.combatBubblePopupOpen;
    if (!next) {
      this.closeCombatBubblePopup();
      return;
    }
    this.openCombatBubblePopup();
  }

  changeLanguage() {
    const currentSettings = loadUiSettings();
    const locales = getAvailableLocales();
    const idx = locales.indexOf(currentSettings.language ?? "vi");
    const nextLanguage = locales[(idx + 1) % locales.length];
    saveUiSettings({
      ...currentSettings,
      aiMode: this.runStatePayload?.aiMode ?? "MEDIUM",
      audioEnabled: this.audioFx.enabled,
      loseCondition: this.loseCondition,
      volumeLevel: this.audioFx.getVolumeLevel(),
      language: nextLanguage
    });
    this.refreshSettingsPanel();
    this.libraryModal?.refreshLocale?.();
    this.refreshHistoryModal();
    this.refreshHeader?.();
    this.addLog?.(t("settings.languageLabel", { label: nextLanguage }));
  }

  refreshSettingsPanel() {
    this._settingsPanelObj?.refresh(loadUiSettings(), this.audioFx);
  }

  changeTooltipMode(delta: number = 1) {
    const currentSettings = loadUiSettings();
    const nextMode = stepTooltipMode(currentSettings.tooltipMode, Number(delta));
    saveUiSettings({
      ...currentSettings,
      aiMode: this.runStatePayload?.aiMode ?? "MEDIUM",
      audioEnabled: this.audioFx.enabled,
      loseCondition: this.loseCondition,
      volumeLevel: this.audioFx.getVolumeLevel(),
      tooltipMode: nextMode,
      expandedTooltip: nextMode === "expanded"
    });
    this.refreshSettingsPanel();
    this.addLog?.(t("settings.tooltipMode", { mode: t(`settings.tooltipModeValue.${normalizeTooltipMode(nextMode)}`) }));
  }

  toggleTooltip() {
    const currentSettings = loadUiSettings();
    const modes = ["compact", "summary", "expanded"];
    const currentMode = normalizeTooltipMode(currentSettings.tooltipMode, currentSettings.expandedTooltip === true, "compact");
    const currentIndex = modes.indexOf(currentMode);
    const nextMode = modes[(currentIndex + 1 + modes.length) % modes.length];
    saveUiSettings({
      ...currentSettings,
      aiMode: this.runStatePayload?.aiMode ?? "MEDIUM",
      audioEnabled: this.audioFx.enabled,
      loseCondition: this.loseCondition,
      volumeLevel: this.audioFx.getVolumeLevel(),
      tooltipMode: nextMode,
      expandedTooltip: nextMode === "expanded"
    });
    this.refreshSettingsPanel?.();
    this.addLog?.(t("settings.tooltipMode", { mode: t(`settings.tooltipModeValue.${normalizeTooltipMode(nextMode)}`) }));
  }

  applyDisplaySettings(settings: ReturnType<typeof loadUiSettings> | null | undefined) {
    applySceneDisplaySettings(this as unknown as Parameters<typeof applySceneDisplaySettings>[0], settings as ReturnType<typeof loadUiSettings> | null | undefined, {
      afterApply: (scene) => {
        if ((scene as unknown as { historyModalVisible?: boolean }).historyModalVisible) this.refreshHistoryModal?.();
        if ((scene as unknown as { settingsVisible?: boolean }).settingsVisible) this.refreshSettingsPanel?.();
      }
    });
  }

  setupInput() {
    return installCombatInputRuntime(this as unknown as Parameters<typeof installCombatInputRuntime>[0]);
  }

  update(_time: number, delta: number) {
    if (this.combatBubblePopupOpen) {
      updateLoadingBubbleMinigame(this as unknown as Parameters<typeof updateLoadingBubbleMinigame>[0], Number(delta));
    }
    if (this.phase !== PHASE.COMBAT) return;
    if (!Array.isArray(this.combatUnits) || this.combatUnits.length === 0) return;
    for (const unit of this.combatUnits) {
      if (!unit?.alive || !unit?.sprite?.active) continue;
      this.syncCombatLabels(unit as CombatUnitRecord);
    }
  }

  getTileSize() {
    const base = getSharedTileSize(this as unknown as Parameters<typeof getSharedTileSize>[0], TILE_W, TILE_H);
    const rowScale = Math.min(1, (ROWS + COLS) / (this.getBoardRowCount() + COLS));
    return {
      tileW: base.tileW * rowScale,
      tileH: base.tileH * rowScale
    };
  }

  isPanPointer(pointer: Parameters<typeof isSharedPanPointer>[0]) {
    return isSharedPanPointer(pointer as Parameters<typeof isSharedPanPointer>[0]);
  }

  pointInBoardPanel(x: number, y: number) {
    return pointInSharedBoardPanel(this as unknown as Parameters<typeof pointInSharedBoardPanel>[0], x, y);
  }

  refreshBoardGeometry() {
    refreshSharedBoardGeometry(this as unknown as Parameters<typeof refreshSharedBoardGeometry>[0], {
      rows: this.getBoardRowCount(),
      cols: COLS,
      riverLayerDepth: RIVER_LAYER_DEPTH,
      paintTile: (scene: BoardViewportScene, tile: number, x: number, y: number, row: number, col: number) => (scene as unknown as Record<string, unknown> & { paintGrassTile3D: (tile: number, x: number, y: number, row: number, col: number) => void }).paintGrassTile3D(tile, x, y, row, col),
      paintRiver: (scene: BoardViewportScene, tile: number, x: number, y: number, row: number) => (scene as unknown as Record<string, unknown> & { paintRiverTile3D: (tile: number, x: number, y: number, row: number) => void }).paintRiverTile3D(tile, x, y, row),
      onRefreshBoardUi: (scene) => {
        if (scene.phase === PHASE.PLANNING || scene.phase === PHASE.AUGMENT) {
          this.refreshBoardUi?.();
        }
      },
      onRefreshCombatUnits: (scene) => {
        if (scene.phase !== PHASE.COMBAT || !Array.isArray(scene.combatUnits)) return;
        scene.combatUnits.forEach((unit) => {
          if (!unit?.sprite?.active) return;
          const point = scene.gridToScreen(unit.col, unit.row);
          unit.sprite.setPosition(point.x, point.y - 10);
          (scene as unknown as Record<string, unknown>)?.syncCombatLabels(unit);
          (scene as unknown as Record<string, unknown>)?.updateCombatUnitUi(unit);
        });
      },
      onAfterRefresh: (scene) => {
        (scene as unknown as Record<string, unknown>)?.refreshBattlefieldDecorations();
        if (scene.phase === PHASE.COMBAT) scene.clearHighlights();
      }
    });
  }

  startFromPayload() {
    const hydrated = this.isPvpRoomMode()
      ? hydrateRunState(this.runStatePayload)
      : this.normalizeIncomingCoopRunState(this.runStatePayload);
    if (!hydrated?.player?.board && !hydrated?.players) {
      startManagedScene(this as unknown as Parameters<typeof startManagedScene>[0], "PlanningScene");
      return;
    }
    this.runStatePayload = hydrated;

    // User's aiMode takes priority over game mode default
    const session = getCoopSession() as CoopSessionLike | null;
    this.coopRunState = hydrated?.players ? hydrated : null;
    this.coopLocalSlot = (session as unknown as CoopSessionLike | null)?.localSlot ?? hydratedCoop.localSlot ?? "P1";
    const hydratedCoop = hydrated as unknown as CoopRunState;
    this.aiMode = normalizeAiMode(
      hydratedCoop.coopDifficulty ?? hydrated.aiMode ?? this.gameModeConfig?.aiDifficulty,
      hydrated?.players ? "COOP_MEDIUM" : "EASY"
    );

    this.audioFx.setEnabled(hydrated.audioEnabled !== false);
    if (this.audioFx) lazyLoadAndPlayBgm(this, "combat", this.audioFx, "bgm_combat", 0.2);
    this.player = hydrated?.players
      ? hydrated.players?.[this.coopLocalSlot] ?? hydrated.players?.[getCoopPlayerSlots(this.aiMode)[0]]
      : hydrated.player;
    if (hydrated?.players) {
      (hydrated as CoopRunState).localSlot = this.coopLocalSlot;
      (hydrated as CoopRunState).hostSlot = String((session as unknown as CoopSessionLike | null)?.hostSlot ?? hydrated.hostSlot) ?? "P1";
      if (Array.isArray(hydrated.shared?.enemyPreview)) {
        this.player.enemyPreview = stampEnemyPreviewEntries(hydrated.shared.enemyPreview, {
          rowCount: this.getBoardRowCount()
        });
        this.player.enemyPreviewRound = this.player.round;
      }
      updateCoopSession({
        roomCode: hydrated.roomCode,
        localSlot: this.coopLocalSlot,
        hostSlot: hydrated.hostSlot,
        aiMode: hydrated.coopDifficulty ?? hydrated.aiMode,
        players: hydrated.players,
        shared: hydrated.shared
      } as CoopSessionInput);
    }
    if (this.isPvpRoomMode()) {
      updateCoopSession({
        sessionType: PVP_FORTRESS_SESSION_TYPE,
        selectedMode: this.player?.gameMode,
        aiMode: this.aiMode,
        players: {
          [this.getSessionLocalSlot()]: this.player
        }
      });
    }
    this.logicRandom = this.isPvpRoomMode()
      ? createSeededRandom(`${(this.roomCombatMeta as unknown as Record<string, unknown>)?.pairId ?? "pvp"}:${(this.roomCombatMeta as unknown as Record<string, unknown>)?.round ?? this.player?.round ?? 1}`)
      : this.isCoopMode()
        ? createSeededRandom(`${(hydratedCoop as unknown as CoopRunState).roomCode ?? "coop"}:${this.player?.round ?? 1}:${this.aiMode}`)
        : Math.random;

    // Use game mode config for lose condition, fallback to player's loseCondition
    if (this.gameModeConfig?.loseCondition) {
      this.loseCondition = normalizeLoseCondition(this.gameModeConfig.loseCondition);
    } else {
      this.loseCondition = normalizeLoseCondition(this.player?.loseCondition);
    }

    this.phase = PHASE.PLANNING;
    this.logs = [];
    this.logHistory = [];
    this.historyFilter = "ALL";
    this.historyScrollOffset = 0;
    this.toggleHistoryModal(false);
    this.beginCombat();
  }

  toggleSettingsOverlay(force: boolean | null = null) {
    toggleSharedSettingsOverlay(this as unknown as Parameters<typeof toggleSharedSettingsOverlay>[0], force as boolean | null, {
      ensureLoaded: () => this.ensureSettingsOverlayLoaded(),
      onShow: () => {
        this.closeCombatBubblePopup();
        this.toggleHistoryModal(false);
        this.refreshSettingsPanel();
        this.refreshCombatUtilityButtons();
      },
      onHide: () => {
        this.refreshCombatUtilityButtons();
      }
    });
  }

  clearSettingsOverlayLayoutReferences() {
    clearSharedSettingsOverlayLayoutReferences(this as unknown as Parameters<typeof clearSharedSettingsOverlayLayoutReferences>[0], { resetPanelObject: true });
  }

  destroySettingsOverlayEntries(entries: Array<{ destroy?: () => void }>) {
    entries.forEach((entry) => entry?.destroy?.());
  }

  rebuildSettingsOverlayAfterResolutionChange(preserveVisible: boolean = false) {
    return rebuildSharedSettingsOverlayAfterResolutionChange(this as unknown as Parameters<typeof rebuildSharedSettingsOverlayAfterResolutionChange>[0], Boolean(preserveVisible), {
      ensureLoaded: () => this.ensureSettingsOverlayLoaded(),
      clearReferences: () => this.clearSettingsOverlayLayoutReferences(),
      onShow: () => {
        this.toggleHistoryModal(false);
        this.refreshSettingsPanel();
        this.refreshCombatUtilityButtons();
      }
    });
  }

  scheduleSettingsOverlayRebuildAfterResolutionChange(preserveVisible: boolean = false) {
    const rebuild = () => {
      void this.rebuildSettingsOverlayAfterResolutionChange(preserveVisible);
    };
    if (this.time?.delayedCall) {
      this.time.delayedCall(0, rebuild);
      return;
    }
    rebuild();
  }

  ensureHistoryModalLoaded() {
    return ensureSharedHistoryModalLoaded(this as unknown as Parameters<typeof ensureSharedHistoryModalLoaded>[0], HISTORY_FILTERS, loadHistoryModalModule as unknown as Parameters<typeof ensureSharedHistoryModalLoaded>[2]);
  }

  toggleHistoryModal(force: unknown = null) {
    const next = typeof force === "boolean" ? force : !this.historyModalVisible;
    this.historyModalVisible = next;
    this.tooltip?.hide?.();
    if (!next) {
      this.historyModalParts?.forEach((part) => safeSetVisible(part, false));
      this.refreshCombatUtilityButtons();
      return;
    }

    void this.ensureHistoryModalLoaded().then(() => {
      if (!this.historyModalVisible) return;
      this.closeCombatBubblePopup();
      this.toggleSettingsOverlay(false);
      this.libraryModal?.hide?.();
      this.historyModalParts?.forEach((part) => safeSetVisible(part, true));
      this.refreshHistoryModal();
      this.refreshCombatUtilityButtons();
    });
  }

  setHistoryFilter(filterKey: unknown) {
    this.historyFilter = filterKey;
    this.historyScrollOffset = 0;
    this.refreshHistoryModal();
  }

  onHistoryWheel(deltaY: number) {
    if (!this.historyModalVisible) return;
    const next = clamp(this.historyScrollOffset + (deltaY > 0 ? 36 : -36), 0, this.historyMaxScroll);
    this.historyScrollOffset = next;
    if (this.historyListContainer && this.historyListViewport) {
      (this.historyListContainer as unknown as { y: number }).y = (this.historyListViewport as unknown as { y: number }).y - this.historyScrollOffset;
    }
  }

  refreshHistoryModal() {
    this._refreshHistoryContent?.(this, HISTORY_FILTERS);
  }

  toggleAudio() {
    this.audioFx.setEnabled(!this.audioFx.enabled);
    this.runStatePayload.audioEnabled = this.audioFx.enabled;
    const currentSettings = loadUiSettings();
    saveUiSettings({
      ...currentSettings,
      aiMode: this.runStatePayload.aiMode ?? "MEDIUM",
      audioEnabled: this.audioFx.enabled,
      loseCondition: this.loseCondition,
      volumeLevel: this.audioFx.getVolumeLevel()
    });
    this.refreshSettingsPanel();
  }

  changeVolumeLevel(step: number = 1) {
    const current = this.audioFx.getVolumeLevel();
    const next = Math.min(10, Math.max(1, current + step));
    if (next === current) return;
    this.audioFx.setVolumeLevel(next);
    const currentSettings = loadUiSettings();
    saveUiSettings({
      ...currentSettings,
      aiMode: this.runStatePayload?.aiMode ?? "MEDIUM",
      audioEnabled: this.audioFx.enabled,
      loseCondition: this.loseCondition,
      volumeLevel: next
    });
    this.refreshSettingsPanel();
  }

  changeResolution(delta: number = 1) {
    const currentSettings = loadUiSettings();
    const next = ResolutionManager.changeResolution(currentSettings.resolutionKey, Number(delta));
    if (!next?.key || next.key === currentSettings.resolutionKey) return;
    if (!this.confirmResolutionReturnToMenu(next)) return;
    currentSettings.resolutionKey = next.key;
    saveUiSettings(currentSettings);
    this.goMainMenu({ openSettingsPanel: true });
  }

  confirmResolutionReturnToMenu(next: { label?: string; key?: string } | null) {
    const message = t("settings.resolutionReturnToMenuConfirm", {
      resolution: next?.label ?? next?.key
    });
    if (typeof globalThis.confirm === "function") {
      return globalThis.confirm(message);
    }
    return true;
  }

  goMainMenu(options: { openSettingsPanel?: boolean } = {}) {
    const sceneData = options?.openSettingsPanel ? { openSettingsPanel: true } : undefined;
    this.toggleSettingsOverlay(false);
    if ((typeof this.isCoopMode === "function" && this.isCoopMode())
      && !(typeof this.isPvpRoomMode === "function" && this.isPvpRoomMode())) {
      this.persistActiveCoopSave?.(this.runStatePayload);
      this.cleanupCoopBindings?.();
      try {
        (getCoopSession() as unknown as CoopSessionLike | null)?.client?.close(1000, "Leaving coop combat");
      } catch (_error) {
        // Ignore close failures when leaving to menu.
      }
      clearCoopSession();
      this.scene.start("MainMenuScene", {
        ...this.getCoopMainMenuData?.(),
        ...(sceneData ?? {})
      });
      return;
    }
    if (sceneData) {
      this.scene.start("MainMenuScene", sceneData);
      return;
    }
    this.scene.start("MainMenuScene");
  }

  exitToPlanning() {
    this.toggleSettingsOverlay(false);
    if (this.isCoopMode() && !this.isPvpRoomMode()) {
      const retreatPayload = this.buildCoopRetreatPayload();
      if (!retreatPayload) return;
      try {
        (getCoopSession() as unknown as CoopSessionLike | null)?.client?.send({
          type: COOP_MESSAGE_TYPES.COMBAT_RETREAT,
          payload: retreatPayload
        });
      } catch (error) {
        console.warn("[CombatScene] Failed to broadcast coop retreat.", error);
        this.handleCoopSessionDisconnected("combat_retreat_failed");
        return;
      }
      this.resolveCoopCombatRetreat(retreatPayload);
      return;
    }
    startManagedScene(this as unknown as Parameters<typeof startManagedScene>[0], "PlanningScene", { restoredState: this.runStatePayload });
  }

  setAIMode(mode: unknown) {
    if (!AI_SETTINGS[mode]) return;
    this.addLog(t("difficulty.lockedInRun"));
    this.refreshHeader();
  }

  isCreativeMode() {
    return isCreativeAiMode(this.aiMode);
  }

  getDisplayedGold() {
    return getDisplayedGold(this.aiMode, this.player?.gold ?? 0);
  }

  getCreativeSandboxUnits(side: string | null = null) {
    return getCreativeSandboxUnitsForPlayer(this.player, side);
  }

  hasManualEnemySandboxUnits() {
    return hasCreativeEnemySandboxUnits(this.player);
  }

  startNewRun() {
    clearRunProgress();
    this.clearCombatSprites();
    this.clearPlanningSprites();
    this.clearOverlay();
    this.selectedBenchIndex = null;
    this.turnQueue = [];
    this.turnIndex = 0;
    this.actionCount = 0;
    this.globalDamageMult = 1;
    this.isActing = false;
    this.phase = PHASE.PLANNING;
    this.logs = [];
    this.logHistory = [];
    this.historyFilter = "ALL";
    this.historyScrollOffset = 0;
    this.toggleHistoryModal(false);

    this.player = {
      hp: 1,
      gold: 10,
      xp: 0,
      level: 1,
      round: 1,
      gameMode: "EndlessPvEClassic",
      audioEnabled: this.audioFx?.enabled !== false,
      winStreak: 0,
      loseStreak: 0,
      board: this.createEmptyBoard(),
      bench: [],
      shop: [],
      shopLocked: false,
      augments: [],
      augmentRoundsTaken: [],
      deployCapBonus: 0,
      benchBonus: 0,
      interestCapBonus: 0,
      rollCostDelta: 0,
      startingRage: 0,
      startingShield: 0,
      teamAtkPct: 0,
      teamMatkPct: 0,
      teamHpPct: 0,
      lifestealPct: 0,
      hpLossReduce: 0,
      extraClassCount: 0,
      extraTribeCount: 0,
      itemBag: [],
      craftedItems: [],
      enemyPreview: [],
      enemyPreviewRound: 0,
      enemyBudget: 0,
      creativeSandboxUnits: []
    };

    this.refreshShop(true);
    this.enterPlanning(false);
    this.addLog("Khởi tạo ván mới: Bá Chủ Khu Rừng.");
  }

  createEmptyBoard() {
    return Array.from({ length: ROWS }, () => Array.from({ length: PLAYER_COLS }, () => null));
  }

  createOwnedUnit(baseId: string, star: number = 1, equips: string[] = [], options: { uid?: string | null } = {}) {
    return createPersistedOwnedUnit(
      baseId,
      star,
      options?.uid ?? null,
      normalizeEquipIds(equips, { baseId, star }),
      options
    );
  }

  computeLayout() {
    const w = this.scale.width;
    const h = this.scale.height;
    const margin = Math.max(UI_SPACING.SM, Math.floor(w * 0.015));
    const gridCols = 12;
    const colGap = UI_SPACING.SM;
    const gridW = w - margin * 2;
    const colW = Math.floor((gridW - colGap * (gridCols - 1)) / gridCols);
    const boardCols = 9;
    const sideCols = 3;
    const contentW = boardCols * colW + (boardCols - 1) * colGap;
    const sidePanelW = sideCols * colW + (sideCols - 1) * colGap;
    const topPanelY = margin;
    const topPanelH = 100;
    const boardPanelX = margin;
    const rightPanelX = boardPanelX + contentW + colGap;
    const boardPanelY = topPanelY + topPanelH + UI_SPACING.LG;
    const sidePanelY = boardPanelY;
    const sidePanelH = h - sidePanelY - margin;

    const actionsH = 48;
    const controlsH = 24;
    const shopCardH = 130;
    const benchSlotH = 86;
    const benchY = h - margin - benchSlotH;
    const shopY = benchY - UI_SPACING.SM - shopCardH;
    const controlsY = shopY - UI_SPACING.SM - controlsH;
    const actionsY = controlsY - UI_SPACING.SM - actionsH;
    // Combat scene: board panel stretches to the bottom for better battlefield focus.
    const boardPanelH = Math.max(250, h - margin - boardPanelY);

    const boardNudgeX = -44;
    const boardNudgeY = -64;

    return {
      width: w,
      height: h,
      margin,
      colW,
      colGap,
      gridCols,
      sidePanelW,
      contentW,
      rightPanelX,
      topPanelY,
      topPanelH,
      boardOriginX: boardPanelX + Math.floor(contentW * 0.28) + boardNudgeX,
      boardOriginY: boardPanelY + Math.floor(boardPanelH * 0.78) + boardNudgeY,
      boardPanelX,
      boardPanelY,
      boardPanelW: contentW,
      boardPanelH,
      sidePanelY,
      sidePanelH,
      actionsY,
      controlsY,
      shopY,
      benchY
    };
  }

  toVisualCol(col: number) {
    return col >= RIGHT_COL_START ? col + BOARD_GAP_COLS : col;
  }

  toChessCoord(row: number, col: number) {
    const file = BOARD_FILES[this.toVisualCol(col)] ?? "?";
    const rank = row;
    return `${file}${rank}`;
  }

  createBoardBackground() {
    const l = this.layout;
    const startRound = this.player?.round ?? this.runStatePayload?.player?.round ?? 1;
    const key = getForestBackgroundKeyByRound(startRound);
    if (!this.textures.exists(key)) return;
    this.roundBackgroundKey = key;
    this.roundBackgroundImage = this.add
      .image((l as BoardLayout).boardPanelX + (l as BoardLayout).boardPanelW / 2, (l as BoardLayout).boardPanelY + (l as BoardLayout).boardPanelH / 2, key)
      .setAlpha(0.5)
      .setDepth(-20);
    applyCoverTextureToImage(this as unknown as Parameters<typeof applyCoverTextureToImage>[0], this.roundBackgroundImage, key, {
      x: (l as BoardLayout).boardPanelX,
      y: (l as BoardLayout).boardPanelY,
      w: (l as BoardLayout).boardPanelW,
      h: (l as BoardLayout).boardPanelH
    });

    const maskGfx = this.add.graphics();
    maskGfx.fillStyle(0xffffff, 1);
    maskGfx.fillRect((l as BoardLayout).boardPanelX, (l as BoardLayout).boardPanelY, (l as BoardLayout).boardPanelW, (l as BoardLayout).boardPanelH);
    this.roundBackgroundImage.enableFilters();
    if (this.roundBackgroundImage.filters.external) this.roundBackgroundMask = this.roundBackgroundImage.filters.external.addMask(maskGfx);
    this.children.remove(maskGfx);
  }

  refreshRoundBackground() {
    if (!this.roundBackgroundImage) return;
    const nextKey = getForestBackgroundKeyByRound(this.player?.round ?? this.runStatePayload?.player?.round ?? 1);
    if (!this.textures.exists(nextKey)) return;
    if (nextKey === this.roundBackgroundKey) return;
    this.roundBackgroundKey = nextKey;
    applyCoverTextureToImage(this as unknown as Parameters<typeof applyCoverTextureToImage>[0], this.roundBackgroundImage, nextKey, {
      x: this.layout.boardPanelX,
      y: this.layout.boardPanelY,
      w: this.layout.boardPanelW,
      h: this.layout.boardPanelH
    });
  }

  drawBoard() {
    this.originX = this.layout.boardOriginX;
    this.originY = this.layout.boardOriginY;
    this.createBoardBackground();
    this.battlefieldBackdrop = this.add.graphics().setDepth(-11);
    this.battlefieldFx = this.add.graphics().setDepth(3);
    this.decorationSprites.push(this.battlefieldBackdrop, this.battlefieldFx);
    this.refreshBattlefieldDecorations();

    for (let row = 0; row < this.getBoardRowCount(); row += 1) {
      for (let col = 0; col < COLS; col += 1) {
        const center = this.gridToScreen(col, row);
        const tile = this.add.graphics();
        this.paintGrassTile3D(tile, center.x, center.y, row, col);
        this.tileLookup.set(gridKey(row, col), { tile, center });
      }
    }
    this.createBoardEdgeLabels();

    for (let row = 0; row < this.getBoardRowCount(); row += 1) {
      const a = this.gridToScreen(4, row);
      const b = this.gridToScreen(5, row);
      const mx = (a.x + b.x) * 0.5;
      const my = (a.y + b.y) * 0.5;
      const token = this.add.graphics();
      this.paintRiverTile3D(token, mx, my - 2, row);
      token.setDepth(RIVER_LAYER_DEPTH);
      this.gapMarkers.push(token);
    }

    this.add.text(this.layout.boardPanelX + 14, this.layout.boardPanelY + this.layout.boardPanelH - 24, "PHE TA", {
      fontFamily: UI_FONT,
      fontSize: "14px",
      color: UI_COLORS.textSecondary
    }).setDepth(2100);

    this.add.text(this.layout.boardPanelX + this.layout.boardPanelW - 14, this.layout.boardPanelY + this.layout.boardPanelH - 24, "PHE ĐỊCH", {
      fontFamily: UI_FONT,
      fontSize: "14px",
      color: UI_COLORS.textSecondary
    }).setOrigin(1, 0).setDepth(2100);

    this.highlightLayer = this.add.graphics();
    this.highlightLayer.setDepth(999);
    this.turnIndicatorLayer = this.add.graphics();
    this.turnIndicatorLayer.setDepth(998);
    this.attackPreviewLayer = this.add.graphics();
    this.attackPreviewLayer.setDepth(1000);
    this.attackPreviewSword = this.add.graphics();
    this.attackPreviewSword.setDepth(1001);
    this.attackPreviewSword.setVisible(false);
  }

  refreshBattlefieldDecorations() {
    _drawBattlefieldEnvironment(this as unknown as Parameters<typeof _drawBattlefieldEnvironment>[0], {
      backdrop: this.battlefieldBackdrop,
      fx: this.battlefieldFx
    });
    this.refreshCoopOwnershipDecorations();
  }

  refreshCoopOwnershipDecorations() {
    this.coopOwnershipLabels?.forEach((label) => label.destroy());
    this.coopOwnershipLabels = [];
    if (!this.isCoopMode()) return;
    const boardProfileId = typeof this.getBoardProfileId === "function"
      ? this.getBoardProfileId()
      : undefined;

    const markers = _drawCoopOwnershipOverlay(
      this as unknown as Parameters<typeof _drawCoopOwnershipOverlay>[0],
      this.battlefieldFx,
      this.getCoopLocalSlot() as string | null | undefined,
      boardProfileId
    );
    markers.forEach((marker) => {
      const label = this.add.text(marker.boardBounds.left - 2, marker.boardBounds.top - 4, marker.label, {
        fontFamily: UI_FONT,
        fontSize: "11px",
        color: marker.isLocal ? "#d9f4ff" : "#c7ffdd",
        fontStyle: "bold"
      }).setOrigin(0, 0.5).setDepth(2100);
      this.coopOwnershipLabels.push(label);
    });
  }

  createBoardEdgeLabels() {
    this.boardEdgeLabels.forEach((x) => x.label.destroy());
    this.boardEdgeLabels = [];
    const style = {
      fontFamily: UI_FONT,
      fontSize: "13px",
      color: UI_COLORS.textSecondary,
      fontStyle: "bold"
    };
    const add = (text: string | string[], col: number, row: number, anchor: string) => {
      const label = this.add.text(0, 0, String(text), style).setOrigin(0.5).setDepth(2100);
      this.boardEdgeLabels.push({ label, col, row, anchor });
    };
    for (let col = 0; col < PLAYER_COLS; col += 1) {
      add(BOARD_FILES[this.toVisualCol(col)] ?? "?", col, this.getBoardRowCount() - 1, "bottom");
    }
    for (let row = 0; row < this.getBoardRowCount(); row += 1) {
      add(String(row), 0, row, "left");
    }
    for (let col = RIGHT_COL_START; col <= RIGHT_COL_END; col += 1) {
      add(BOARD_FILES[this.toVisualCol(col)] ?? "?", col, 0, "top");
    }
    for (let row = 0; row < this.getBoardRowCount(); row += 1) {
      add(String(row), RIGHT_COL_END, row, "right");
    }
    this.refreshBoardEdgeLabels();
  }

  refreshBoardEdgeLabels() {
    const { tileW, tileH } = this.getTileSize();
    this.boardEdgeLabels.forEach((entry) => {
      const p = this.gridToScreen(entry.col, entry.row);
      let dx = 0;
      let dy = 0;
      if (entry.anchor === "bottom") {
        dx = tileW * 0.3;
        dy = tileH * 0.6;
      } else if (entry.anchor === "top") {
        dx = -tileW * 0.3;
        dy = -tileH * 0.6;
      } else if (entry.anchor === "left") {
        dx = -tileW * 0.3;
        dy = tileH * 0.6;
      } else if (entry.anchor === "right") {
        dx = tileW * 0.3;
        dy = -tileH * 0.6;
      }
      entry.label.setPosition(p.x + dx, p.y + dy);
      entry.label.setDepth(2101);
    });
  }

  getGrassTileStyle(row: unknown, col: unknown) { return _getGrassTileStyle(row as unknown as Parameters<typeof _getGrassTileStyle>[0], col as unknown as Parameters<typeof _getGrassTileStyle>[0]); }

  paintGrassTile(graphics: Phaser.GameObjects.Graphics, x: number, y: number, row: number, col: number) {
    const { tileW, tileH } = this.getTileSize();
    _paintGrassTile(graphics, x, y, row, col, tileW, tileH);
  }

  paintRiverTile(graphics: Phaser.GameObjects.Graphics, x: number, y: number, row: number) {
    const { tileW, tileH } = this.getTileSize();
    _paintRiverTile(graphics, x, y, row, tileW, tileH);
  }

  paintGrassTile3D(graphics: Phaser.GameObjects.Graphics, x: number, y: number, row: number, col: number) {
    const { tileW, tileH } = this.getTileSize();
    _paintGrassTile3D(graphics, x, y, row, col, tileW, tileH);
  }

  paintRiverTile3D(graphics: Phaser.GameObjects.Graphics, x: number, y: number, row: number) {
    const { tileW, tileH } = this.getTileSize();
    _paintRiverTile3D(graphics, x, y, row, tileW, tileH);
  }

  drawDiamond(graphics: Phaser.GameObjects.Graphics, x: number, y: number, fill: boolean = true) {
    const { tileW, tileH } = this.getTileSize();
    _drawDiamond(graphics, x, y, tileW, tileH, fill);
  }

  getRoleTheme(classType: unknown) { return _getRoleTheme(classType as unknown as Parameters<typeof _getRoleTheme>[0]); }

  createHud() {
    const hud = createCombatHud(this as unknown as Parameters<typeof createCombatHud>[0]);
    this.refreshRemoteMatchHud?.();
    return hud;
  }

  createTopRightButtons() {
    const groupLayout = getCombatTopRightButtonLayout(this.layout as unknown as Parameters<typeof getCombatTopRightButtonLayout>[0]);
    const bubbles = groupLayout.buttons.bubbles;
    const wiki = groupLayout.buttons.wiki;
    const settings = groupLayout.buttons.settings;

    this.buttons.bubbles = this.createButton(
      bubbles.x,
      bubbles.y,
      bubbles.w,
      bubbles.h,
      bubbles.label,
      () => this.toggleCombatBubblePopup(),
      { variant: "ghost", fontSize: bubbles.fontSize }
    );
    this.buttons.wiki = this.createButton(
      wiki.x,
      wiki.y,
      wiki.w,
      wiki.h,
      wiki.label,
      () => {
        this.toggleSettingsOverlay(false);
        this.toggleHistoryModal(false);
        this.closeCombatBubblePopup();
        this.toggleLibraryModal();
      },
      { variant: "ghost", fontSize: wiki.fontSize }
    );
    this.buttons.settings = this.createButton(
      settings.x,
      settings.y,
      settings.w,
      settings.h,
      settings.label,
      () => this.toggleSettingsOverlay(),
      { variant: "ghost", fontSize: settings.fontSize }
    );
  }

  createButtons() {
    return createCombatButtons(this);
  }

  createButton(x: number, y: number, w: number, h: number, label: string, onClick: () => void, options: Record<string, unknown> = {}) {
    return createSceneButton(this, x, y, w, h, label, onClick, options);
  }

  createPlayerCellZones() {
    const { tileW, tileH } = this.getTileSize();
    for (let row = 0; row < this.getBoardRowCount(); row += 1) {
      for (let col = 0; col < PLAYER_COLS; col += 1) {
        const tile = this.tileLookup.get(gridKey(row, col));
        const zone = this.add.zone(tile.center.x, tile.center.y, tileW - 10, tileH - 10);
        zone.setInteractive(new Phaser.Geom.Rectangle(0, 0, tileW - 10, tileH - 10), Phaser.Geom.Rectangle.Contains);
        zone.input.dropZone = true;
        zone.on("pointerdown", () => this.onPlayerCellClick(row, col));
        zone.setDepth(1500);
        this.playerCellZones.push({ row, col, zone });
      }
    }
  }
  createBenchSlots() {
    const maxSlots = 12;
    const startX = 40;
    const y = 705;
    const slotW = 96;
    const slotH = 90;
    for (let i = 0; i < maxSlots; i += 1) {
      const x = startX + i * (slotW + 6);
      const bg = this.add.rectangle(x + slotW / 2, y + slotH / 2, slotW, slotH, 0x1f2734, 0.92);
      bg.setStrokeStyle(2, 0x4f607c, 1);
      bg.setDepth(1500);
      const label = this.add.text(x + 8, y + 8, "", {
        fontFamily: "Consolas",
        fontSize: "12px",
        color: "#d9e6ff",
        wordWrap: { width: slotW - 14 }
      });
      label.setDepth(1501);
      bg.setInteractive({ useHandCursor: true });
      bg.on("pointerdown", () => this.onBenchClick(i));
      this.benchSlots.push({ x, y, slotW, slotH, bg, label });
    }

    this.shopTitle = this.add.text(40, 660, t("ui.shop"), {
      fontFamily: "Consolas",
      fontSize: "18px",
      color: "#ffe3a3"
    });
    this.shopTitle.setDepth(2000);

    this.benchTitle = this.add.text(40, 680, t("ui.bench"), {
      fontFamily: "Consolas",
      fontSize: "18px",
      color: "#ffe3a3"
    });
    this.benchTitle.setDepth(2000);
  }

  onPlayerCellClick(row: unknown, col: unknown) {
    if (this.phase !== PHASE.PLANNING) return;
    if (this.overlaySprites.length) return;
    if ((this.libraryModal as LibraryModal | null)?.isOpen()) return;

    const occupant = this.player.board[row][col];
    const selected = this.selectedBenchIndex != null ? this.player.bench[this.selectedBenchIndex] : null;

    if (selected) {
      if (!occupant) {
        if (this.getDeployCount() >= this.getDeployCap()) {
          this.addLog("Deploy cap da day.");
          return;
        }
        this.player.board[row][col] = selected;
        this.player.bench.splice(this.selectedBenchIndex, 1);
        this.selectedBenchIndex = null;
        this.tryAutoMerge();
        this.refreshPlanningUi();
        return;
      }

      this.player.board[row][col] = selected;
      this.player.bench[this.selectedBenchIndex] = occupant;
      this.selectedBenchIndex = null;
      this.tryAutoMerge();
      this.refreshPlanningUi();
      return;
    }

    if (occupant) {
      if (this.player.bench.length >= this.getBenchCap()) {
        this.addLog("Bench da day.");
        return;
      }
      this.player.board[row][col] = null;
      this.player.bench.push(occupant);
      this.refreshPlanningUi();
    }
  }

  onBenchClick(index: number) {
    if (this.phase !== PHASE.PLANNING) return;
    if (index >= this.getBenchCap()) return;
    if ((this.libraryModal as LibraryModal | null)?.isOpen()) return;
    if (index >= this.player.bench.length) {
      this.selectedBenchIndex = null;
      this.refreshBenchUi();
      return;
    }

    this.selectedBenchIndex = this.selectedBenchIndex === index ? null : index;
    this.refreshBenchUi();
  }

  getBenchCap() {
    return 9 + this.player.benchBonus;
  }

  getDeployCap() {
    return getDeployCapByLevel(this.player.level) + this.player.deployCapBonus;
  }

  getDeployCount() {
    let count = 0;
    const board = this.isCoopMode() ? this.coopRunState?.players?.[this.getCoopLocalSlot()]?.board : this.player.board;
    for (let row = 0; row < ROWS; row += 1) {
      for (let col = 0; col < PLAYER_COLS; col += 1) {
        if (board?.[row]?.[col]) count += 1;
      }
    }
    return count;
  }

  getActiveLeftUnitCount() {
    return this.getDeployCount() + this.getCreativeSandboxUnits("LEFT").length;
  }

  rollShop() {
    if (this.phase !== PHASE.PLANNING) return;
    const cost = calculateRefreshCost(this.player.level, this.player.rollCostDelta);
    if (!canAffordWithCreative(this.aiMode, this.player.gold, cost)) {
      this.addLog("Không đủ vàng để đổi tướng.");
      return;
    }
    if (!this.isCreativeMode()) {
      spendGoldWithCreative(this.player, this.aiMode, cost);
    }
    this.refreshShop(true);
    this.refreshPlanningUi();
  }

  buyXp() {
    if (this.phase !== PHASE.PLANNING) return;
    const cost = Math.max(1, 4 + (this.player.xpCostDelta ?? 0));
    if (!canAffordWithCreative(this.aiMode, this.player.gold, cost)) {
      this.addLog("Không đủ vàng để mua XP.");
      return;
    }
    spendGoldWithCreative(this.player, this.aiMode, cost);
    this.gainXp(4);
    this.refreshPlanningUi();
  }

  gainXp(value: number) {
    let amount = value;
    while (amount > 0 && this.player.level < 25) {
      const need = getXpToLevelUp(this.player.level) - this.player.xp;
      if (amount >= need) {
        amount -= need;
        this.player.level += 1;
        this.player.xp = 0;
        this.addLog(`Lên cấp ${this.player.level}.`);
      } else {
        this.player.xp += amount;
        amount = 0;
      }
    }
  }

  toggleLock() {
    if (this.phase !== PHASE.PLANNING) return;
    this.player.shopLocked = !this.player.shopLocked;
    this.refreshPlanningUi();
  }

  refreshShop(forceRoll: unknown = false) {
    if (this.player.shopLocked && !forceRoll) return;
    this.player.shop = generateShopOffers(this.player.level, 5);
  }

  buyFromShop(index: unknown) {
    if (this.phase !== PHASE.PLANNING) return;
    if ((this.libraryModal as LibraryModal | null)?.isOpen()) return;
    const offer = this.player.shop[index];
    if (!offer) return;
    const base = UNIT_BY_ID[offer.baseId];
    const cost = base.tier;
    if (!canAffordWithCreative(this.aiMode, this.player.gold, cost)) {
      this.addLog("Không đủ vàng để mua linh thú.");
      return;
    }
    if (this.player.bench.length >= this.getBenchCap()) {
      this.addLog("Hàng chờ dự bị đã đầy.");
      return;
    }
    spendGoldWithCreative(this.player, this.aiMode, cost);
    this.player.bench.push(this.createOwnedUnit(base.id, 1) as unknown as Parameters<typeof this.player.bench.push>[0]);
    this.player.shop[index] = null;
    this.tryAutoMerge();
    this.refreshPlanningUi();
  }

  getMergeSpeciesKey(unit: OwnedUnit) { return UpgradeSystem.getMergeSpeciesKey(unit as unknown as Parameters<typeof UpgradeSystem.getMergeSpeciesKey>[0]); }
  getMergeSpeciesLabel(unit: OwnedUnit) { return UpgradeSystem.getMergeSpeciesLabel(unit as unknown as Parameters<typeof UpgradeSystem.getMergeSpeciesLabel>[0]); }

  tryAutoMerge() {
    const result = UpgradeSystem.tryAutoMerge(
      this.player.board as unknown as Parameters<typeof UpgradeSystem.tryAutoMerge>[0],
      this.player.bench as unknown as Parameters<typeof UpgradeSystem.tryAutoMerge>[1],
      ITEM_BY_ID,
      UNIT_BY_ID,
      this.createOwnedUnit.bind(this) as unknown as Parameters<typeof UpgradeSystem.tryAutoMerge>[4]
    );
    if (result.mergeCount > 0) {
      result.log.forEach((entry) => {
        const unit = UNIT_BY_ID[entry.baseId];
        const label = unit?.name || entry.baseId;
        this.addLog(`Merge: ${label} -> ${entry.toStar}★`);
        if (entry.overflowItems?.length > 0) {
          this.player.itemBag.push(...entry.overflowItems);
        }
      });
    }
  }

  collectOwnedUnitRefs() {
    return UpgradeSystem.collectOwnedUnitRefs(this.player.board as unknown as Parameters<typeof UpgradeSystem.collectOwnedUnitRefs>[0], this.player.bench as unknown as Parameters<typeof UpgradeSystem.collectOwnedUnitRefs>[1]);
  }

  removeOwnedUnitRefs(refs: unknown) {
    UpgradeSystem.removeUnitRefs(this.player.board as unknown as Parameters<typeof UpgradeSystem.removeUnitRefs>[0], this.player.bench as unknown as Parameters<typeof UpgradeSystem.removeUnitRefs>[1], refs as unknown as Parameters<typeof UpgradeSystem.removeUnitRefs>[2]);
  }

  placeMergedUnit(unit: unknown, preferredRef: unknown) {
    UpgradeSystem.placeMergedUnit(this.player.board as unknown as Parameters<typeof UpgradeSystem.placeMergedUnit>[0], this.player.bench as unknown as Parameters<typeof UpgradeSystem.placeMergedUnit>[1], unit as unknown as Parameters<typeof UpgradeSystem.placeMergedUnit>[2], [preferredRef]);
  }

  enterPlanning(grantIncome: unknown) {
    this.phase = PHASE.PLANNING;
    this.closeCombatBubblePopup();
    this.clearCombatSprites();
    this.turnQueue = [];
    this.turnIndex = 0;
    this.actionCount = 0;
    this.globalDamageMult = 1;
    this.isActing = false;
    this.selectedBenchIndex = null;
    this.highlightLayer.clear();

    if (grantIncome) this.grantRoundIncome();
    this.refreshShop(false);
    this.refreshPlanningUi();

    if (AUGMENT_ROUNDS.includes(this.player.round) && !this.player.augmentRoundsTaken.includes(this.player.round)) {
      this.showAugmentChoices();
    }
  }

  grantRoundIncome() {
    if (this.isCreativeMode()) {
      this.addLog(t("log.creativeIncomeIgnored"), "EVENT");
      return;
    }
    const base = 5;
    const interestCap = 5 + this.player.interestCapBonus;
    const interest = Math.min(interestCap, Math.floor(this.player.gold / 10));
    const winStreakBonus = this.player.winStreak >= 2 ? Math.min(3, Math.floor(this.player.winStreak / 2)) : 0;
    const loseStreakBonus = this.player.loseStreak >= 2 ? Math.min(3, Math.floor(this.player.loseStreak / 2)) : 0;
    const streak = Math.max(winStreakBonus, loseStreakBonus);
    const goldBonus = Math.floor(this.player.gold / 5);
    const gain = base + interest + streak + goldBonus;
    gainGoldWithCreative(this.player, this.aiMode, gain);
    this.addLog(buildSharedRoundIncomeLog({
      round: this.player.round,
      gain,
      base,
      interest,
      streak,
      fixedIncome: goldBonus,
      fixedIncomeLabel: "Tích vàng",
      goldAfter: this.getDisplayedGold()
    }), "EVENT");
  }

  showAugmentChoices() {
    this.phase = PHASE.AUGMENT;
    this.closeCombatBubblePopup();
    this.tooltip?.hide?.();
    const remaining = AUGMENT_LIBRARY.filter((a) => !this.player.augments.includes(a.id));
    const choices = sampleWithoutReplacement(remaining, 3);
    showSharedAugmentChoiceModal(this as unknown as Parameters<typeof showSharedAugmentChoiceModal>[0], {
      choices,
      onChoose: (choice) => this.chooseAugment(choice),
      getAugmentIcon: (augment) => this.getAugmentIcon(augment),
      translateAugmentGroup: (group) => this.translateAugmentGroup(group)
    });
  }

  clearOverlay() {
    this.overlaySprites.forEach((o) => o.destroy());
    this.overlaySprites = [];
    this.currentAugmentChoices = null;
  }

  chooseAugment(augment: unknown) {
    if ((this.libraryModal as LibraryModal | null)?.isOpen()) return;
    if (!this.augmentSystem) {
      this.augmentSystem = new AugmentSystem(this.player as unknown as Parameters<typeof AugmentSystem>[0], {
        onGainXp: (val) => this.gainXp(val)
      });
    }
    this.augmentSystem.applyAugment(augment as unknown as Parameters<typeof AugmentSystem.prototype.applyAugment>[0]);
    this.player.augmentRoundsTaken.push(this.player.round);
    this.addLog(`Đã chọn pháp ấn: ${String((augment as { name?: string })?.name ?? "")}`);
    this.clearOverlay();
    this.phase = PHASE.PLANNING;
    this.refreshPlanningUi();
  }
  /**
   * Begins combat phase
   * 
   * ARCHITECTURE NOTE (Task 5.2.1):
   * Combat logic has been delegated to CombatSystem. This method now only handles:
   * - Scene state management (phase transitions, clearing UI)
   * - Unit spawning and visual setup
   * - Combat initialization via CombatSystem.initializeCombat()
   * - UI updates (header, synergy preview, queue preview)
   * 
   * Combat logic (turn order, action execution, damage calculation) is in CombatSystem.
   * 
   * @see CombatSystem.initializeCombat() - Initializes combat state and turn order
   * @see stepCombat() - Executes combat turns using CombatSystem
   */
  beginCombat() {
    if (this.phase !== PHASE.PLANNING) return;
    if (this.getActiveLeftUnitCount() <= 0) {
      this.addLog("Can deploy it nhat 1 tuong.");
      return;
    }

    // Scene state management - CombatScene responsibility
    this.phase = PHASE.COMBAT;
    this.closeCombatBubblePopup();
    this.selectedBenchIndex = null;
    this.clearPlanningSprites();
    this.clearOverlay();
    this.combatUnits = [];
    this.turnQueue = [];
    this.turnIndex = 0;
    this.actionCount = 0;
    this.globalDamageMult = 1;
    this.isActing = false;
    this.combatLootDrops = [];
    this.combatLootDropDetails = [];
    this.highlightLayer.clear();

    // Unit spawning and visual setup - CombatScene responsibility
    this.spawnPlayerCombatUnits();
    this.spawnEnemyCombatUnits();

    // Calculate combat speed multiplier based on unit count (Requirement 11.1, 11.2, 11.3)
    this.combatSpeedMultiplier = this.calculateCombatSpeedMultiplier();

    // Apply synergy bonuses using SynergySystem
    const leftTeam = this.getCombatUnits("LEFT");
    const rightTeam = this.getCombatUnits("RIGHT");
    this.roundEnvironment = applyRoundEnvironmentToUnits(
      [...leftTeam, ...rightTeam] as unknown as Parameters<typeof applyRoundEnvironmentToUnits>[0],
      this.player?.round ?? 1
    );

    const leftOptions = this.isCoopMode()
      ? {
          extraClassCount: getCoopPlayerSlots(this.aiMode)
            .reduce((total, slot) => total + (this.coopRunState?.players?.[slot]?.extraClassCount || 0), 0),
          extraTribeCount: getCoopPlayerSlots(this.aiMode)
            .reduce((total, slot) => total + (this.coopRunState?.players?.[slot]?.extraTribeCount || 0), 0)
        }
      : {
          extraClassCount: this.player.extraClassCount || 0,
          extraTribeCount: this.player.extraTribeCount || 0
        };
    SynergySystem.applySynergyBonusesToTeam(leftTeam as unknown as Parameters<typeof SynergySystem.applySynergyBonusesToTeam>[0], "LEFT", leftOptions);
    leftTeam.forEach((unit) => this.updateCombatUnitUi(unit));

    SynergySystem.applySynergyBonusesToTeam(rightTeam as unknown as Parameters<typeof SynergySystem.applySynergyBonusesToTeam>[0], "RIGHT", {});
    rightTeam.forEach((unit) => this.updateCombatUnitUi(unit));

    // COMBAT LOGIC DELEGATION: Use CombatSystem to initialize combat state
    // CombatSystem handles: turn order calculation, combat state management
    // Requirements: 8.1, 8.3, 8.4, 8.6
    const playerUnits = this.combatUnits.filter(u => u.side === "LEFT");
    const enemyUnits = this.combatUnits.filter(u => u.side === "RIGHT");
    this.combatState = CombatSystem.initializeCombat(playerUnits, enemyUnits);

    // Use position-based turn order (E5→E1, D→A | G5→G1, H→K)
    this.buildTurnQueue();

    // UI updates - CombatScene responsibility
    setSceneTurnCycleIndex(this, this.turnQueue.length ? 1 : 0);
    this.updateRoundLabel();
    this.refreshHeader();
    this.refreshSynergyPreview();
    this.refreshQueuePreview();
    if (this.isCoopAuthoritativeCombatSyncEnabled()) {
      if (this.isCoopHost()) {
        this.startCoopCombatSyncTimer();
        this.startCoopCombatHeartbeatTimer();
        this.syncCoopCombatSnapshot("start");
      } else {
        this.stopCoopCombatSyncTimer();
        this.applyPendingCoopCombatDelta();
        this.applyPendingCoopCombatSnapshot();
      }
    }
    this.addLog(`Bắt đầu giao tranh vòng ${this.player.round}.`);
  }

  spawnPlayerCombatUnits() {
    if (this.isCoopMode()) {
      const boardProfileId = typeof this.getBoardProfileId === "function"
        ? this.getBoardProfileId()
        : undefined;
      listCoopAllyBoardUnits(this.coopRunState?.players, {
        aiMode: this.aiMode,
        boardProfile: boardProfileId
      }).forEach((entry) => {
        const ownerPlayer = this.coopRunState?.players?.[entry.slot] ?? this.player;
        const unit = this.createCombatUnit(entry.unit as unknown as Parameters<typeof this.createCombatUnit>[0], "LEFT", entry.visualRow, entry.col, { ownerPlayer });
        if (unit) this.combatUnits.push(unit as unknown as Parameters<typeof this.combatUnits.push>[0]);
      });
      return;
    }
    for (let row = 0; row < ROWS; row += 1) {
      for (let col = 0; col < PLAYER_COLS; col += 1) {
        const owned = this.player.board[row][col];
        if (!owned) continue;
        const unit = this.createCombatUnit(owned as Parameters<typeof this.createCombatUnit>[0], "LEFT", row, col);
        if (unit) this.combatUnits.push(unit as unknown as Parameters<typeof this.combatUnits.push>[0]);
      }
    }
    this.getCreativeSandboxUnits("LEFT").forEach((owned: OwnedUnit & { row: number; col: number }) => {
      const unit = this.createCombatUnit(owned, "LEFT", owned.row, owned.col);
      if (unit) this.combatUnits.push(unit as unknown as Parameters<typeof this.combatUnits.push>[0]);
    });
  }

  spawnEnemyCombatUnits() {
    if (this.hasManualEnemySandboxUnits()) {
      this.getCreativeSandboxUnits("RIGHT").forEach((owned: OwnedUnit & { row: number; col: number }) => {
        const unit = this.createCombatUnit(owned, "RIGHT", owned.row, owned.col);
        if (unit) this.combatUnits.push(unit as unknown as Parameters<typeof this.combatUnits.push>[0]);
      });
      return;
    }
    const preview = this.isCoopMode()
      ? stampEnemyPreviewEntries(this.coopRunState?.shared?.enemyPreview as unknown[] | undefined, {
          rowCount: this.getBoardRowCount()
        })
      : stampEnemyPreviewEntries(this.player.enemyPreview as unknown[] | undefined, {
          rowCount: this.getBoardRowCount()
        });
    if (preview.length) {
      preview.forEach((ref) => {
        const base = UNIT_BY_ID[ref.baseId];
        if (!base) return;
        const owned = this.createOwnedUnit(base.id, (ref.star ?? 1) as unknown as Parameters<typeof this.createOwnedUnit>[1], (ref.equips ?? []) as unknown as Parameters<typeof this.createOwnedUnit>[2], { uid: ref.uid }) as Parameters<typeof this.createCombatUnit>[0];
        const unit = this.createCombatUnit(owned as Parameters<typeof this.createCombatUnit>[0], "RIGHT", ref.row as unknown as Parameters<typeof this.createCombatUnit>[2], ref.col as unknown as Parameters<typeof this.createCombatUnit>[3]);
        if (unit) this.combatUnits.push(unit as unknown as Parameters<typeof this.combatUnits.push>[0]);
      });
      return;
    }

    // Use AISystem to generate enemy team (Requirements 8.1, 8.6)
    const sandbox = this.player?.gameMode === "PVE_SANDBOX";
    const budget = Math.round((8 + this.player.round * (sandbox ? 2.1 : 2.6)));
    const boardProfileId = typeof this.getBoardProfileId === "function"
      ? this.getBoardProfileId()
      : undefined;
    const enemyUnits = generateEnemyTeam(this.player.round, budget, this.aiMode, sandbox, {
      boardProfile: boardProfileId
    });

    // Create combat units from generated enemy team
    enemyUnits.forEach((ref) => {
      const base = UNIT_BY_ID[ref.baseId];
      if (!base) return;
      const owned = this.createOwnedUnit(base.id, ref.star ?? 1);

      const equips = rollAiEquipmentIds(this.player.round, this.aiMode, ref);
      if (equips.length > 0) owned.equips = equips;

      const unit = this.createCombatUnit(owned as unknown as Parameters<typeof this.createCombatUnit>[0], "RIGHT", ref.row, ref.col);
      if (unit) this.combatUnits.push(unit as unknown as Parameters<typeof this.combatUnits.push>[0]);
    });
  }

  createCombatUnit(owned: OwnedUnit, side: string, row: number, col: number, options: Record<string, unknown> = {}) {
    const descriptor = createCombatUnitDescriptor(owned as unknown as Parameters<typeof createCombatUnitDescriptor>[0]);
    if (!descriptor) return null;

    const { base, star } = descriptor;
    const statLine = computeCombatUnitStatLine({
      descriptor,
      side,
      player: options.ownerPlayer ?? this.player,
      aiSettings: getAISettings(this.aiMode),
      round: this.player.round,
      gameMode: this.player.gameMode,
      enemyScaling: this.gameModeConfig?.enemyScaling,
      includeDefenseAugments: true
    });

    const point = this.gridToScreen(col, row);
    const roleTheme = this.getRoleTheme(base.classType);
    const tokenStroke = side === "LEFT" ? 0x60788f : 0x6c7480;
    const visual = getUnitVisual(owned.baseId, base.classType, owned.star, {
      side,
      ownerKind: side === "LEFT" ? "PLAYER" : "ENEMY",
      collectionProfile: this.collectionProfile
    });
    const shadow = this.add.ellipse(point.x, point.y + 8, 44, 14, 0x000000, 0);
    shadow.setDepth(point.y + 9);
    const sprite = this.add.circle(point.x, point.y - 10, 24, 0x14202c, 0);
    sprite.setStrokeStyle(0, tokenStroke, 0);
    sprite.setDepth(point.y + 10);
    sprite.setInteractive({ useHandCursor: true });

    const visualModule = getUnitVisualModule(owned.baseId, {
      side,
      ownerKind: side === "LEFT" ? "PLAYER" : "ENEMY",
      star: owned.star,
      collectionProfile: this.collectionProfile
    });
    const iconStack = createSharedUnitVisualStack(this, {
      star: owned.star,
      side,
      baseX: point.x,
      baseY: point.y - 10,
      baseDepth: point.y + 12,
      createVisual: ({ x, y, scale, alpha, depth }) => {
        let created;
        if (visualModule && visualModule.createModel) {
          created = createUnitVisualModel(this as unknown as Parameters<typeof createUnitVisualModel>[0], owned.baseId, {
            x,
            y,
            scale: 0.9 * Number(scale),
            star: owned.star,
            side,
            ownerKind: side === "LEFT" ? "PLAYER" : "ENEMY",
            collectionProfile: this.collectionProfile
          });
        } else {
          created = this.add.text(x as unknown as Parameters<typeof this.add.text>[0], y as unknown as Parameters<typeof this.add.text>[0], visual.icon, {
            fontFamily: EMOJI_FONT,
            fontSize: "32px",
            color: "#ffffff"
          }).setOrigin(0.5);
          created.setScale?.(scale);
        }
        (created as Record<string, unknown>).setDepth?.(depth);
        (created as Record<string, unknown>).setAlpha?.(alpha);
        return created;
      }
    });
    const icon = iconStack.primary;
    const iconCopies = iconStack.copies;
    if (visualModule && iconStack.primary) {
      (visualModule as unknown as Record<string, unknown> & { playBattleReadyAnimation(): void }).playBattleReadyAnimation(this, iconStack.primary);
    }

    const tagText = buildSharedTokenLabelText({
      star: owned.star,
      roleIcon: getClassIcon(base.classType),
      name: visual.nameVi
    });
    const tagBg = createSharedTokenLabelBackground(this, point.x, point.y - 47, {
      width: 64,
      height: 13,
      fillColor: 0x05070c,
      fillAlpha: 0.76
    });
    tagBg.setStrokeStyle(1, tokenStroke, 0.72);
    (tagBg as unknown as { setDepth: (d: number) => void }).setDepth(point.y + 11);
    const tag = this.add.text(point.x, point.y - 47, tagText, {
      fontFamily: UI_FONT,
      fontSize: "15px",
      color: Phaser.Display.Color.IntegerToColor((roleTheme as Record<string, unknown>).stroke).rgba,
      fontStyle: "bold"
    }).setOrigin(0.5);
    applySharedTokenLabelTextStyle(tag as unknown as Parameters<typeof applySharedTokenLabelTextStyle>[0], {
      color: Phaser.Display.Color.IntegerToColor((roleTheme as Record<string, unknown>).stroke).rgba
    });
    tag.setDepth(point.y + 11);
    layoutSharedTokenLabel(this as unknown as Parameters<typeof layoutSharedTokenLabel>[0], tagBg, tag as unknown as Parameters<typeof layoutSharedTokenLabel>[0], {
      x: point.x,
      y: point.y - 47
    });

    const barW = 56;
    const barH = 6;
    const fillH = 4;
    const barLeft = point.x - barW / 2 + 1;
    const hpBarBg = this.add.rectangle(point.x, point.y + 11, barW, barH, SHARED_UNIT_BAR_COLORS.hpBg, 0.96);
    hpBarBg.setStrokeStyle(2, SHARED_UNIT_BAR_COLORS.hpStroke, 0.98);
    hpBarBg.setDepth(point.y + 11);
    const hpBarFill = this.add.rectangle(barLeft, point.y + 11, barW - 2, fillH, SHARED_UNIT_BAR_COLORS.hpFill, 0.98).setOrigin(0, 0.5);
    hpBarFill.setDepth(point.y + 12);
    const shieldBar = this.add.rectangle(barLeft, point.y + 11, 0, fillH, SHARED_UNIT_BAR_COLORS.shieldFill, 0.94).setOrigin(0, 0.5);
    shieldBar.setDepth(point.y + 13);

    const rageBarBg = this.add.rectangle(point.x, point.y + 18, barW, barH, SHARED_UNIT_BAR_COLORS.rageBg, 0.96);
    rageBarBg.setStrokeStyle(2, SHARED_UNIT_BAR_COLORS.rageStroke, 1);
    rageBarBg.setDepth(point.y + 11);
    const rageBarFill = this.add.rectangle(barLeft, point.y + 18, 0, fillH, SHARED_UNIT_BAR_COLORS.rageFill, 0.98).setOrigin(0, 0.5);
    rageBarFill.setDepth(point.y + 12);
    const rageGrid = createSharedRageBarGrid(this, {
      x: barLeft,
      y: point.y + 18,
      width: barW - 2,
      height: fillH,
      rageMax: (statLine as unknown as Record<string, unknown>).rageMax ?? (owned as unknown as Record<string, unknown>).rageMax ?? base.stats?.rageMax ?? 0,
      depth: point.y + 13,
      alpha: 0.98
    });

    const buffBar = this.add.graphics(); // Green bar for positive effects
    buffBar.setDepth(point.y + 12);
    const debuffBar = this.add.graphics(); // Purple bar for negative effects
    debuffBar.setDepth(point.y + 12);

    const statusLabel = this.add.text(point.x, point.y + 36, "", {
      fontFamily: UI_FONT,
      fontSize: "8px",
      color: "#ffe9aa"
    }).setOrigin(0.5, 0);
    statusLabel.setDepth(point.y + 11);

    this.combatSprites.push(
      shadow,
      sprite,
      ...iconStack.entries.map(({ target }) => target),
      tagBg,
      tag,
      hpBarBg,
      hpBarFill,
      shieldBar,
      rageBarBg,
      rageBarFill,
      rageGrid,
      buffBar,
      debuffBar,
      statusLabel
    );

    const unit = createCombatUnitRecord({
      descriptor,
      side,
      row,
      col,
      player: this.player,
      statLine,
      name: visual.nameVi,
      uiRefs: {
        shadow,
        sprite,
        icon,
        iconCopies,
        __sharedIconStack: iconStack.entries,
        tagBg,
        tag,
        hpBarBg,
        hpBarFill,
        shieldBar,
        rageBarBg,
        rageBarFill,
        rageGrid,
        buffBar,
        debuffBar,
        statusLabel,
        defaultStrokeColor: tokenStroke,
        defaultStrokeAlpha: 0
      }
    });

    this.applyOwnedEquipmentBonuses(unit as unknown as Parameters<typeof this.applyOwnedEquipmentBonuses>[0], owned);
    applyOwnedVariantTraitsToCombatUnit(unit, owned as unknown as Parameters<typeof applyOwnedVariantTraitsToCombatUnit>[0], {
      getUnitVariantTraits: this.getUnitVariantTraits.bind(this),
      applyBonusToUnit: this.applyBonusToUnit.bind(this)
    });
    this.tooltip.attach(sprite, () => this.getCombatUnitTooltip(unit), {
      triggerMode: "auto",
      pinKey: unit.uid ?? unit.baseId,
      onShow: () => this.showAttackPreviewForUnit(unit as unknown as Parameters<typeof this.showAttackPreviewForUnit>[0]),
      onHide: () => this.clearAttackPreview(unit as unknown as Parameters<typeof this.clearAttackPreview>[0])
    });
    this.syncCombatLabels(unit as CombatUnitRecord);
    this.updateCombatUnitUi(unit);
    return unit;
  }

  clearPlanningSprites() {
    this.planningSprites.forEach((s) => s.destroy());
    this.planningSprites = [];
  }

  clearCombatSprites() {
    this.combatSprites.forEach((s) => s.destroy());
    this.combatSprites = [];
    this.combatUnits = [];
    this.combatLootDrops = [];
    this.combatLootDropDetails = [];
    this.highlightLayer.clear();
    this.clearAttackPreview();
    this.refreshTeamStatusBars();
  }

  canPreviewAttack(unit: CombatUnitRecord | null | undefined): boolean {
    if (!unit || !unit.alive) return false;
    const statuses = unit.statuses ?? {};
    return Boolean(
      this.phase === PHASE.COMBAT &&
      !this.settingsVisible &&
      !this.isActing &&
      (statuses.freeze ?? 0) <= 0 &&
      (statuses.stun ?? 0) <= 0 &&
      (statuses.sleep ?? 0) <= 0
    );
  }

  showAttackPreviewForUnit(unit: CombatUnitRecord | null | undefined) {
    if (!this.canPreviewAttack(unit)) {
      this.clearAttackPreview();
      return;
    }
    const target = this.selectTarget(unit, { deterministic: true });
    if (!target) {
      this.clearAttackPreview();
      return;
    }
    const impact = this.getPreviewImpact(unit, target as unknown as Parameters<typeof this.getPreviewImpact>[0]);
    if (!impact.cells.length) {
      this.clearAttackPreview();
      return;
    }

    this.previewHoverUnit = unit;
    this.attackPreviewLayer?.clear();
    const impactKeySet = new Set(impact.cells.map((cell) => gridKey(cell.row, cell.col)));
    const rangeCells = this.calculateAttackRange(unit);
    const mergedCells = this.dedupePreviewCells([...rangeCells, ...impact.cells]);
    drawSharedAttackPreviewCells(this as unknown as Parameters<typeof drawSharedAttackPreviewCells>[0], mergedCells, (cell) => {
      const isPrimary = cell.row === impact.primary.row && cell.col === impact.primary.col;
      const isImpactCell = impactKeySet.has(gridKey(cell.row, cell.col));
      return {
        fillColor: 0xffaa00,
        fillAlpha: isPrimary ? 0.42 : isImpactCell ? 0.3 : 0.18,
        lineColor: 0xffaa00,
        lineAlpha: isPrimary ? 1 : 0.82,
        lineWidth: isPrimary ? 3 : 2
      };
    });
    this.drawAttackPreviewSword(impact.primary.row, impact.primary.col, unit);
  }

  calculateAttackRange(unit: CombatUnitRecord | null | undefined) {
    if (!unit?.alive) return [];
    const cells = [];
    const forward = unit.side === "LEFT" ? 1 : -1;
    const maxRange = Math.max(1, Math.floor(Number(unit.range) || 1));
    for (let dist = 1; dist <= maxRange; dist += 1) {
      const col = unit.col + forward * dist;
      if (col < 0 || col >= COLS) break;
      cells.push({ row: unit.row, col });
    }
    return this.dedupePreviewCells(cells);
  }

  clearAttackPreview(unit: CombatUnitRecord | null | undefined = null) {
    clearSharedAttackPreview(this as unknown as Parameters<typeof clearSharedAttackPreview>[0], unit as unknown as Parameters<typeof clearSharedAttackPreview>[1]);
  }

  drawAttackPreviewSword(row: number, col: number, attacker: CombatUnitRecord | null | undefined) {
    drawSharedAttackPreviewSword(this as unknown as Parameters<typeof drawSharedAttackPreviewSword>[0], row, col, attacker as unknown as Parameters<typeof drawSharedAttackPreviewSword>[3]);
  }

  getPreviewImpact(attacker: CombatUnitRecord | null | undefined, target: CombatUnitRecord | null | undefined) {
    const enemySide = attacker.side === "LEFT" ? "RIGHT" : "LEFT";
    const allies = this.getCombatUnits(attacker.side);
    const enemies = this.getCombatUnits(enemySide);
    const skill = getResolvedSkillDefinition(attacker.skillId as unknown as Parameters<typeof getResolvedSkillDefinition>[0], { baseId: attacker.baseId, star: attacker.star });
    const primary = { row: target.row, col: target.col };
    const skillCells = this.collectSkillPreviewCells(attacker, target, skill, allies, enemies);
    const impactCells = this.dedupePreviewCells([primary, ...skillCells]);
    return { primary, cells: impactCells };
  }

  collectSkillPreviewCells(attacker: CombatUnitRecord | null | undefined, target: CombatUnitRecord | null | undefined, skill: Record<string, unknown> | null | undefined, allies: CombatUnitRecord[], enemies: CombatUnitRecord[]) {
    return collectSharedSkillPreviewCells({ attacker, target, skill, allies, enemies });
  }

  dedupePreviewCells(cells: Array<{ row: number; col: number }>) {
    return dedupeSharedPreviewCells(cells);
  }

  refreshPlanningUi() {
    this.refreshRoundBackground();
    this.refreshHeader();
    this.refreshButtons();
    this.refreshShopUi();
    this.refreshBenchUi();
    this.refreshBoardUi();
    this.refreshSynergyPreview();
    this.refreshQueuePreview();
  }

  formatCombatTeamStatusValue(value: unknown) {
    const numeric = Math.max(0, Math.round(Number(value) || 0));
    return new Intl.NumberFormat("vi-VN").format(numeric);
  }

  calculateCombatUnitBattlePower(unit: CombatUnitRecord | null | undefined) {
    if (!unit?.alive) return 0;
    return calculateCombatPowerFromStats({
      hp: unit.hp,
      shield: unit.shield,
      atk: this.getEffectiveAtk?.(unit) ?? unit.atk,
      matk: this.getEffectiveMatk?.(unit) ?? unit.matk,
      def: this.getEffectiveDef?.(unit) ?? unit.def,
      mdef: this.getEffectiveMdef?.(unit) ?? unit.mdef,
      star: unit.star,
      tier: unit.tier
    });
  }

  calculateCombatUnitMaxPower(unit: CombatUnitRecord | null | undefined) {
    if (!unit) return 0;
    return calculateCombatPowerFromStats({
      hp: unit.maxHp ?? unit.hp,
      shield: 0,
      atk: this.getEffectiveAtk?.(unit) ?? unit.atk,
      matk: this.getEffectiveMatk?.(unit) ?? unit.matk,
      def: this.getEffectiveDef?.(unit) ?? unit.def,
      mdef: this.getEffectiveMdef?.(unit) ?? unit.mdef,
      star: unit.star,
      tier: unit.tier
    });
  }

  refreshTeamStatusBars() {
    const hud = this.teamStatusHud as unknown as TeamStatusHudLike | null;
    if (!hud?.left || !hud?.right) return;
    const model = buildCombatTeamStatusModel(this.combatUnits as unknown as Parameters<typeof buildCombatTeamStatusModel>[0], {
      resolveUnitPower: (unit) => this.calculateCombatUnitBattlePower(unit as unknown as CombatUnitRecord | null | undefined),
      resolveUnitPowerMax: (unit) => this.calculateCombatUnitMaxPower(unit as unknown as CombatUnitRecord | null | undefined)
    });
    const hasUnits = (model.left.unitCount + model.right.unitCount) > 0;
    hud.elements?.forEach((element) => element?.setVisible?.(hasUnits));
    if (!hasUnits) return;

    const applySide = (sideHud: TeamSideHudLike | null | undefined, sideModel: TeamStatusSideModelLike | null | undefined, colors: { power: number; high: number; mid: number; low: number } | null | undefined) => {
      if (!sideHud || !colors) return;
      const hpRatio = Math.max(0, Math.min(1, Number(sideModel?.hpRatio) || 0));
      const currentHp = Number(sideModel?.hpCurrent) || 0;
      const maxHp = Math.max(0, Number(sideModel?.hpMax) || 0);
      const powerValue = Math.max(0, Number(sideModel?.power) || 0);
      const powerMax = Math.max(0, Number(sideModel?.powerMax) || 0);
      const hpFillWidth = Math.max(1, (Math.max(1, sideHud.barW - 2)) * hpRatio);
      const powerRatio = powerMax > 0 ? Math.max(0, Math.min(1, powerValue / powerMax)) : 0;
      const powerFillWidth = Math.max(1, (Math.max(1, sideHud.barW - 2)) * powerRatio);
      const hpBarColor = hpRatio >= 0.6
        ? colors.high
        : hpRatio >= 0.3
          ? colors.mid
          : colors.low;
      sideHud.powerBarFill.width = powerFillWidth;
      sideHud.powerBarFill.setFillStyle(colors.power, powerMax > 0 ? 0.98 : 0.65);
      sideHud.hpBarFill.width = hpFillWidth;
      sideHud.hpBarFill.setFillStyle(hpBarColor, maxHp > 0 ? 0.98 : 0.65);
      sideHud.powerText?.setText(`${this.formatCombatTeamStatusValue(sideModel?.power)} / ${this.formatCombatTeamStatusValue(powerMax)}`);
      sideHud.hpText?.setText(`${this.formatCombatTeamStatusValue(currentHp)} / ${this.formatCombatTeamStatusValue(maxHp)}`);
    };

    applySide(hud.left, model.left, {
      power: 0xe25151,
      high: 0x4fd16b,
      mid: 0x3bb85a,
      low: 0x2f8c45
    });
    applySide(hud.right, model.right, {
      power: 0xe25151,
      high: 0x4fd16b,
      mid: 0x3bb85a,
      low: 0x2f8c45
    });
  }

  refreshHeader() {
    const xpNeed = getXpToLevelUp(this.player.level);
    const xpText = xpNeed === Number.POSITIVE_INFINITY ? "TỐI ĐA" : `${this.player.xp}/${xpNeed}`;
    const deployText = `${this.getActiveLeftUnitCount()}/${this.getDeployCap()}`;
    const modeLabel = this.player.gameMode === "PVE_SANDBOX" ? "Sandbox" : "Vô tận";
    const loseLabel = getLoseConditionLabel(this.loseCondition);
    const showHpLabel = this.loseCondition === "NO_HEARTS";
    const maxHp = Number.isFinite(this.gameModeConfig?.startingHP)
      ? Math.max(1, Math.floor(this.gameModeConfig.startingHP))
      : Math.max(1, Math.floor(this.player.hp || 1));
    const hpLabel = showHpLabel ? `  •  Máu ${this.player.hp}/${maxHp}` : "";
    const enemySourceLabel = this.hasManualEnemySandboxUnits() ? ` • ${t("creative.enemySandboxLabel")}` : "";
    const environment = this.roundEnvironment ?? resolveSceneRoundEnvironment(this);
    const environmentLabel = environment ? ` • Môi trường ${environment.shortLabelVi}` : "";
    this.headerText.setText(
      `Vòng ${this.player.round}  •  Vàng ${this.getDisplayedGold()}  •  Cấp ${this.player.level}  •  XP ${xpText}  •  Triển khai ${deployText}${hpLabel}  •  AI ${AI_SETTINGS[this.aiMode].label}  •  ${modeLabel}  •  ${loseLabel}${enemySourceLabel}${environmentLabel}`
    );
    this.phaseText.setText(`${this.getPhaseLabel(this.phase)}`);
    this.refreshTeamStatusBars();
    this.updateLogText();
    this.refreshRemoteMatchHud?.();
  }

  getPhaseLabel(phase: unknown) {
    if (phase === PHASE.PLANNING) return "Chuẩn bị";
    if (phase === PHASE.AUGMENT) return "Chọn pháp ấn";
    if (phase === PHASE.COMBAT) return "Giao tranh";
    if (phase === PHASE.GAME_OVER) return "Kết thúc";
    return phase;
  }

  refreshButtons() {
    if (!this.buttons.roll || !this.buttons.xp || !this.buttons.lock || !this.buttons.start) {
      this.buttons.history?.setLabel(`Lịch sử (${this.logHistory.length})`);
      this.buttons.history?.setEnabled(true);
      this.refreshCombatUtilityButtons();
      return;
    }
    const planning = this.phase === PHASE.PLANNING;
    const lock = this.player.shopLocked ? "Bật" : "Tắt";
    const rollCost = calculateRefreshCost(this.player.level, this.player.rollCostDelta);

    this.buttons.roll.setLabel(`Đổi tướng (${rollCost})`);
    this.buttons.xp.setLabel("Mua XP (4)");
    this.buttons.lock.setLabel(`Khóa: ${lock}`);
    this.buttons.start.setLabel("BẮT ĐẦU GIAO TRANH");
    this.buttons.history?.setLabel(`Lịch sử (${this.logHistory.length})`);

    this.buttons.roll.setEnabled(planning);
    this.buttons.xp.setEnabled(planning);
    this.buttons.lock.setEnabled(planning);
    this.buttons.start.setEnabled(planning && this.getActiveLeftUnitCount() > 0);
    this.buttons.reset?.setEnabled(true);
    this.buttons.easy?.setEnabled(false);
    this.buttons.medium?.setEnabled(false);
    this.buttons.hard?.setEnabled(false);
    this.buttons.history?.setEnabled(true);
    this.refreshCombatUtilityButtons();

    this.buttons.easy?.setLabel(LEVEL_LABEL.EASY);
    this.buttons.medium?.setLabel(LEVEL_LABEL.MEDIUM);
    this.buttons.hard?.setLabel(LEVEL_LABEL.HARD);
  }

  refreshShopUi() {
    this.shopCards.forEach((card) => {
      card.bg.destroy();
      card.text.destroy();
      if (card.icon) { try { card.icon.destroy(); } catch (e) { } }
    });
    this.shopCards = [];

    const startX = 40;
    const y = 450;
    const cardW = 132;
    const cardH = 140;
    for (let i = 0; i < 5; i += 1) {
      const x = startX + i * (cardW + 8);
      const offer = this.player.shop[i];
      const base = offer ? UNIT_BY_ID[offer.baseId] : null;
      const roleTheme = base ? this.getRoleTheme(base.classType) : null;
      const cardFill = base ? (roleTheme as Record<string, unknown>).card : 0x1f2a3a;
      const cardStroke = base ? (roleTheme as Record<string, unknown>).stroke : 0x6fb0ff;
      const cardHover = base ? (roleTheme as Record<string, unknown>).cardHover : 0x2b3f5d;
      const bg = this.add.rectangle(x + cardW / 2, y + cardH / 2, cardW, cardH, cardFill as unknown as Parameters<typeof this.add.rectangle>[0], 0.95);
      bg.setStrokeStyle(2, cardStroke as unknown as Parameters<typeof bg.setStrokeStyle>[0], 1);
      bg.setDepth(1500);

      let txt = "SOLD";
      if (offer) {
        const previewSkill = getResolvedSkillDefinition(base.skillId, { baseId: offer.baseId, star: 1 });
        txt = `${base.name}\nTier ${base.tier} (${base.tier}g)\n${base.tribe}/${base.classType}\nR:${previewSkill?.cost ?? base.stats.rageMax}`;
      }

      const text = this.add.text(x + 8, y + 8, txt, {
        fontFamily: "Consolas",
        fontSize: "12px",
        color: "#e8f3ff",
        wordWrap: { width: cardW - 14 },
        lineSpacing: 3
      });
      text.setDepth(1501);

      // Add visual icon for units with visual module
      let shopIcon = null;
      if (offer) {
        shopIcon = createUnitVisualModel(this as unknown as Parameters<typeof createUnitVisualModel>[0], offer.baseId, {
          x: x + cardW / 2,
          y: y + 100,
          scale: 0.6,
          star: 1,
          surface: "planning",
          ownerKind: "PLAYER",
          collectionProfile: this.collectionProfile ?? null
        });
        if (shopIcon) {
          (shopIcon as { setDepth: (depth: number) => unknown }).setDepth(1502);
        }
      }
      this.shopCards.push({ bg, text, icon: shopIcon });

      bg.setInteractive({ useHandCursor: true });
      bg.on("pointerdown", () => this.buyFromShop(i));
      bg.on("pointerover", () => {
        if (this.phase === PHASE.PLANNING) bg.setFillStyle(cardHover as unknown as Parameters<typeof bg.setFillStyle>[0], 0.95);
      });
      bg.on("pointerout", () => bg.setFillStyle(cardFill as unknown as Parameters<typeof bg.setFillStyle>[0], 0.95));
    }
  }

  refreshBenchUi() {
    const cap = this.getBenchCap();
    this.benchSlots.forEach((slot, index) => {
      if (index >= cap) {
        slot.bg.setVisible(false);
        slot.label.setVisible(false);
        return;
      }
      slot.bg.setVisible(true);
      slot.label.setVisible(true);
      const unit = this.player.bench[index];
      const selected = this.selectedBenchIndex === index;

      if (!unit) {
        slot.bg.setStrokeStyle(2, selected ? 0xffef9a : 0x4f607c, 1);
        slot.bg.setFillStyle(selected ? 0x36466a : 0x1f2734, 0.92);
        slot.label.setText(`[${index + 1}] ${t("ui.empty")}`);
      } else {
        const roleTheme = this.getRoleTheme(unit.base.classType);
        slot.bg.setStrokeStyle(2, selected ? 0xffef9a : (roleTheme as Record<string, unknown>).stroke, 1);
        slot.bg.setFillStyle(selected ? (roleTheme as Record<string, unknown>).cardHover : (roleTheme as Record<string, unknown>).bench, 0.92);
        slot.label.setText(`${unit.base.name}\n${unit.star}* T${unit.base.tier}\n${unit.base.tribe}/${unit.base.classType}`);
      }
    });
  }

  refreshBoardUi() {
    this.clearPlanningSprites();
    if (this.phase !== PHASE.PLANNING && this.phase !== PHASE.AUGMENT) return;

    for (let row = 0; row < ROWS; row += 1) {
      for (let col = 0; col < PLAYER_COLS; col += 1) {
        const unit = this.player.board[row][col] as unknown as OwnedUnit & { row: number; col: number; side: string };
        if (!unit) continue;
        const point = this.gridToScreen(col, row);
        const roleTheme = this.getRoleTheme(unit.base.classType);
        const tokenStroke = 0x60788f;
        const visual = getUnitVisual(unit.baseId, unit.base.classType, unit.star, {
          side: unit.side,
          ownerKind: unit.side === "LEFT" ? "PLAYER" : "ENEMY",
          collectionProfile: this.collectionProfile
        });
        const shadow = this.add.ellipse(point.x, point.y + 8, 44, 14, 0x000000, 0);
        shadow.setDepth(point.y + 13);
        const sprite = this.add.circle(point.x, point.y - 10, 22, 0x14202c, 0);
        sprite.setStrokeStyle(0, tokenStroke, 0);
        sprite.setDepth(point.y + 15);
        const visualModule = getUnitVisualModule(unit.baseId);
        const iconStack = createSharedUnitVisualStack(this, {
          star: unit.star,
          side: unit.side,
          baseX: point.x,
          baseY: point.y - 10,
          baseDepth: point.y + 17,
          createVisual: ({ x, y, scale, alpha, depth }) => {
            let created;
            if (visualModule && visualModule.createModel) {
              created = createUnitVisualModel(this as unknown as Parameters<typeof createUnitVisualModel>[0], unit.baseId, {
                x,
                y,
                scale: 0.9 * Number(scale),
                star: unit.star,
                side: unit.side,
                ownerKind: unit.side === "LEFT" ? "PLAYER" : "ENEMY",
                collectionProfile: this.collectionProfile
              });
            } else {
              created = this.add.text(x as unknown as Parameters<typeof this.add.text>[0], y as unknown as Parameters<typeof this.add.text>[0], visual.icon, {
                fontFamily: EMOJI_FONT,
                fontSize: "32px",
                color: "#ffffff"
              }).setOrigin(0.5);
              created.setScale?.(scale);
            }
            (created as Record<string, unknown>).setDepth?.(depth);
            (created as Record<string, unknown>).setAlpha?.(alpha);
            return created;
          }
        });
        const tagBg = createSharedTokenLabelBackground(this, point.x, point.y - 47, {
          width: 64,
          height: 13,
          fillColor: 0x05070c,
          fillAlpha: 0.76
        });
        tagBg.setStrokeStyle(1, tokenStroke, 0.72);
        (tagBg as unknown as { setDepth: (d: number) => void }).setDepth(point.y + 15);
        const tag = this.add.text(point.x, point.y - 47, buildSharedTokenLabelText({
          star: unit.star,
          roleIcon: getClassIcon(unit.base.classType),
          name: visual.nameVi
        }), {
          fontFamily: UI_FONT,
          fontSize: "15px",
          color: Phaser.Display.Color.IntegerToColor((roleTheme as Record<string, unknown>).stroke).rgba,
          fontStyle: "bold"
        }).setOrigin(0.5);
        applySharedTokenLabelTextStyle(tag as unknown as Parameters<typeof applySharedTokenLabelTextStyle>[0], {
          color: Phaser.Display.Color.IntegerToColor((roleTheme as Record<string, unknown>).stroke).rgba
        });
        tag.setDepth(point.y + 16);
        layoutSharedTokenLabel(this as unknown as Parameters<typeof layoutSharedTokenLabel>[0], tagBg, tag as unknown as Parameters<typeof layoutSharedTokenLabel>[0], {
          x: point.x,
          y: point.y - 47
        });
        this.planningSprites.push(shadow, sprite, ...iconStack.entries.map(({ target }) => target), tagBg, tag);
      }
    }
  }

  refreshSynergyPreview() {
    const deployed =
      this.phase === PHASE.COMBAT && Array.isArray(this.combatUnits) && this.combatUnits.length
        ? this.getCombatUnits("LEFT")
        : (() => {
          const items = [];
          for (let row = 0; row < ROWS; row += 1) {
            for (let col = 0; col < PLAYER_COLS; col += 1) {
              const unit = this.player.board[row][col];
              if (unit) items.push(unit);
            }
          }
          return items;
        })();
    const summary = SynergySystem.calculateSynergies(deployed as unknown as Parameters<typeof SynergySystem.calculateSynergies>[0], "LEFT", {
      extraClassCount: this.player.extraClassCount || 0,
      extraTribeCount: this.player.extraTribeCount || 0
    });
    const classLines = Object.keys(summary.classCounts)
      .sort((a, b) => summary.classCounts[b] - summary.classCounts[a])
      .map((key) => `${getClassLabelVi(key)}: ${summary.classCounts[key]}`);
    const tribeLines = Object.keys(summary.tribeCounts)
      .sort((a, b) => summary.tribeCounts[b] - summary.tribeCounts[a])
      .map((key) => `${getTribeLabelVi(key)}: ${summary.tribeCounts[key]}`);
    const aug = this.player.augments.length ? this.player.augments.join(", ") : null;
    const classText = classLines.length ? classLines.map((line) => `• ${line}`).join("\n") : "• Chưa kích nghề";
    const tribeText = tribeLines.length ? tribeLines.map((line) => `• ${line}`).join("\n") : "• Chưa kích tộc";
    const augText = aug ? aug.split(", ").map((line) => `• ${line}`).join("\n") : "• Chưa có pháp ấn";
    if (this.combatHudConfig?.compact && this.combatHudConfig?.showRemoteMatchCard) {
      const compactClass = classLines.slice(0, 2).join(" • ") || "Chưa kích nghề";
      const compactTribe = tribeLines.slice(0, 2).join(" • ") || "Chưa kích tộc";
      const compactAug = aug ? aug.split(", ").slice(0, 1).join(", ") : "Chưa có pháp ấn";
      this.synergyText.setText(
        `Nghề: ${compactClass}\nTộc: ${compactTribe}\nPháp ấn: ${compactAug}`
      );
      return;
    }
    this.synergyText.setText(
      `Nghề\n${classText}\n\nTộc\n${tribeText}\n\nPháp ấn\n${augText}`
    );
  }

  refreshQueuePreview() {
    if (!this.queueText?.scene || this.queueText?.active === false) {
      return;
    }
    try {
      if (this.phase !== PHASE.COMBAT) {
        if (this.combatHudConfig?.compact && this.combatHudConfig?.showRemoteMatchCard) {
          this.queueText.setText(`• Chuẩn bị giao tranh\n• Vòng ${this.player?.round ?? 1} • Địch ${this.getCombatUnits("RIGHT").length}`);
        } else {
          this.queueText.setText(`• Đang chuẩn bị giao tranh\n• Vòng ${this.player?.round ?? 1}\n• Linh thú địch: ${this.getCombatUnits("RIGHT").length}`);
        }
        this.refreshRemoteMatchHud?.();
        return;
      }
      const next = [];
      const previewLimit = this.queuePreviewLimit ?? 8;
      for (let i = 0; i < previewLimit; i += 1) {
        const idx = this.turnIndex + i;
        if (idx >= this.turnQueue.length) break;
        const entry = this.turnQueue[idx];
        const unit = entry?.unit;
        if (!unit || !unit.alive) continue;
        next.push(`${next.length + 1}. ${unit.name} (${unit.side === "LEFT" ? "Ta" : "Địch"})`);
      }
      if (this.combatHudConfig?.compact && this.combatHudConfig?.showRemoteMatchCard) {
        const compactLines = next.map((line) => line.replace(/^\d+\.\s*/, ""));
        this.queueText.setText(`• Lượt tiếp theo\n${compactLines.join(" • ") || "Đã hết lượt."}`);
      } else {
        this.queueText.setText(`• Thứ tự lượt tiếp theo\n${next.join("\n") || "Đã hết lượt."}`);
      }
    } catch (error) {
      console.warn("[CombatScene] Queue preview refresh skipped:", error);
    }
    this.refreshRemoteMatchHud?.();
  }

  updateRoundLabel() {
    if (this.combatRoundLabel) {
      const environment = this.roundEnvironment ?? resolveSceneRoundEnvironment(this);
      this.combatRoundLabel.setText(environment ? `MÔI TRƯỜNG ${environment.shortLabelVi}` : "MÔI TRƯỜNG");
    }
  }

