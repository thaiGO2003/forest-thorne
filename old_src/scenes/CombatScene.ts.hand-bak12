  addLog(message: string, category: string | null = null) {
    pushSharedSceneLog(this, message, category as unknown as Parameters<typeof pushSharedSceneLog>[0], {
      inferCategory: inferSharedLogCategory,
      previewLimit: 6
    });
    this.updateLogText();
    if (this.historyModalVisible) this.refreshHistoryModal();
  }

  updateLogText() {
    this.logText.setText(formatSharedLogPreview(this.logs, { maxLines: this.logPreviewMaxLines ?? 4 }));
    this.buttons.history?.setLabel(`Lịch sử (${this.logHistory.length})`);
  }

